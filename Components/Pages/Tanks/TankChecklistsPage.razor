@page "/company/tank-checklists"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject TankService Svc

<PageTitle>Tank checklists · Chandlery</PageTitle>

<PageHeader Eyebrow="Admin" Title="Tank checklists" Subtitle="What an inspector looks at, for each kind of tank. Changing a checklist raises its version; inspections already made keep the questions they were asked.">
    <Actions>
        <button class="btn btn-primary" @onclick="StartNewTemplate">+ New checklist</button>
        <button class="btn btn-secondary" @onclick="CreateStandardAsync">Add the standard checklists</button>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else
{
    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }
    @if (_notice is not null) { <div class="mb-4 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@_notice</div> }

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="space-y-6">
            <div class="card p-3 text-sm">
                @if (_templates.Count == 0) { <p class="p-2 text-muted">No checklists yet. Add the standard ones to begin.</p> }
                @foreach (var t in _templates)
                {
                    <button class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left hover:bg-surface-2 @(_selected?.Template.Id == t.Template.Id ? "bg-accent-50" : "")" @onclick="() => Select(t)">
                        <span class="font-medium">@t.Template.Name</span>
                        <span class="chip chip-plain ml-auto" data-tone="neutral">@TankLook.Label(t.Template.TankType)</span>
                        <span class="text-xs text-muted">v@(t.Template.Version)</span>
                        @if (!t.Template.IsActive) { <span class="chip" data-tone="neutral">off</span> }
                    </button>
                }
            </div>

            <div class="card p-5 text-sm">
                <h2 class="mb-1 font-display text-base font-extrabold text-ink">Words to watch for</h2>
                <p class="mb-2 text-xs text-muted">The reviewer sees these highlighted in inspection comments. Separate them with commas; leave it empty for the standard list.</p>
                <textarea class="textarea" rows="3" @bind="_keywords" placeholder="@string.Join(", ", TankScales.ReviewKeywords)"></textarea>
                <button class="btn btn-secondary btn-sm mt-2" @onclick="SaveKeywordsAsync">Save the words</button>
            </div>
        </div>

        <div class="space-y-6 lg:col-span-2">
            @if (_templateForm)
            {
                <div class="card p-5 text-sm">
                    <h2 class="mb-3 font-display text-lg font-extrabold text-ink">@(_editingTemplate is null ? "New checklist" : "Checklist details")</h2>
                    <div class="grid gap-3 md:grid-cols-3">
                        <label class="md:col-span-2">Name <input class="input mt-1" @bind="_tName" /></label>
                        <label>For tanks of type
                            <select class="select mt-1" @bind="_tType">
                                @foreach (var t in Enum.GetValues<TankType>()) { <option value="@t">@TankLook.Label(t)</option> }
                            </select>
                        </label>
                        <label>Ship type (optional) <input class="input mt-1" @bind="_tShip" placeholder="blank means every ship" /></label>
                        <label class="flex items-end gap-2 pb-2"><input type="checkbox" @bind="_tActive" /> In use</label>
                    </div>
                    <div class="mt-4 flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveTemplateAsync">Save</button>
                        <button class="btn btn-ghost" @onclick="() => _templateForm = false">Cancel</button>
                    </div>
                </div>
            }

            @if (_selected is { } sel)
            {
                <div class="card p-5 text-sm">
                    <div class="flex flex-wrap items-center gap-3">
                        <h2 class="font-display text-lg font-extrabold text-ink">@sel.Template.Name</h2>
                        <span class="text-xs text-muted">version @sel.Template.Version · @sel.Criteria.Count(c => c.IsActive) questions in use</span>
                        <span class="ml-auto flex gap-2">
                            <button class="btn btn-secondary btn-sm" @onclick="() => StartEditTemplate(sel.Template)">Details</button>
                            <button class="btn btn-primary btn-sm" @onclick="StartNewCriterion">+ Add a question</button>
                        </span>
                    </div>

                    @if (_criterionForm)
                    {
                        <div class="mt-4 rounded-xl bg-surface-2/60 p-4">
                            <div class="grid gap-3 md:grid-cols-4">
                                <label class="md:col-span-2">Question <input class="input mt-1" @bind="_cName" /></label>
                                <label>Group
                                    <select class="select mt-1" @bind="_cGroup">
                                        @foreach (var g in Enum.GetValues<CriterionGroup>()) { <option value="@g">@TankLook.Label(g)</option> }
                                    </select>
                                </label>
                                <label>Answered on
                                    <select class="select mt-1" @bind="_cScale">
                                        <option value="@ScaleKind.Rating">Rating (Good, Fair, Bad, NI, NA)</option>
                                        <option value="@ScaleKind.YesNoNa">Yes / No / NA</option>
                                        <option value="@ScaleKind.PercentBucket">Percent bands</option>
                                    </select>
                                </label>
                                <label class="md:col-span-2">Answers that count as an exception
                                    <input class="input mt-1" @bind="_cExceptions" placeholder="@($"standard: {(TankScales.DefaultExceptionValues(_cScale) == "" ? "none" : TankScales.DefaultExceptionValues(_cScale))}")" />
                                    <span class="text-xs text-muted">Choose from: @string.Join(", ", TankScales.Values(_cScale)). Leave empty for the standard.</span>
                                </label>
                                <label>Order <input type="number" class="input mt-1" @bind="_cOrder" /></label>
                                <label class="flex items-end gap-2 pb-2"><input type="checkbox" @bind="_cActive" /> In use</label>
                            </div>
                            <div class="mt-3 flex gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="SaveCriterionAsync">@(_editingCriterion is null ? "Add the question" : "Save the question")</button>
                                <button class="btn btn-ghost btn-sm" @onclick="() => _criterionForm = false">Cancel</button>
                            </div>
                        </div>
                    }

                    @foreach (var group in sel.Criteria.GroupBy(c => c.Group).OrderBy(g => g.Key))
                    {
                        <h3 class="mt-5 mb-1 text-xs font-bold uppercase tracking-wider text-muted">@TankLook.Label(group.Key)</h3>
                        <ul class="divide-y divide-line/60">
                            @foreach (var c in group)
                            {
                                <li class="flex flex-wrap items-center gap-2 py-2 @(c.IsActive ? "" : "opacity-50")">
                                    <span class="font-medium">@c.Name</span>
                                    <span class="chip chip-plain" data-tone="neutral">@ScaleName(c.Scale)</span>
                                    @if (c.ExceptionValues != "") { <span class="text-xs text-muted">exception: @c.ExceptionValues</span> }
                                    @if (!c.IsActive) { <span class="chip" data-tone="neutral">off</span> }
                                    <button class="btn btn-ghost btn-sm ml-auto" @onclick="() => StartEditCriterion(c)">Edit</button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (!_templateForm)
            {
                <EmptyState Title="Pick a checklist" Message="Choose one on the left to see and change its questions." />
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private bool _loaded;
    private string? _error, _notice;
    private List<TankTemplateView> _templates = [];
    private TankTemplateView? _selected;
    private string _keywords = "";

    private bool _templateForm;
    private TankChecklistTemplate? _editingTemplate;
    private string _tName = "", _tShip = "";
    private TankType _tType;
    private bool _tActive = true;

    private bool _criterionForm;
    private TankCriterion? _editingCriterion;
    private string _cName = "", _cExceptions = "";
    private CriterionGroup _cGroup = CriterionGroup.Structure;
    private ScaleKind _cScale;
    private int _cOrder;
    private bool _cActive = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _keywords = (await Svc.GetKeywordsAsync(_companyId)).Typed;
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _templates = await Svc.ListTemplatesAsync(_companyId, includeInactive: true);
        _selected = _selected is null ? null : _templates.FirstOrDefault(t => t.Template.Id == _selected.Template.Id);
    }

    private static string ScaleName(ScaleKind scale) => scale switch { ScaleKind.Rating => "rating", ScaleKind.YesNoNa => "yes / no", _ => "percent bands" };

    private void Select(TankTemplateView t) { _selected = t; _criterionForm = false; _templateForm = false; _error = _notice = null; }

    private async Task CreateStandardAsync()
    {
        _error = _notice = null;
        try
        {
            var made = await Svc.CreateStandardTemplatesAsync(_companyId);
            _notice = made == 0 ? "Every tank type already has a checklist." : $"Added {made} standard checklist(s).";
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task SaveKeywordsAsync()
    {
        _error = _notice = null;
        try
        {
            await Svc.SaveKeywordsAsync(_companyId, _keywords);
            _keywords = (await Svc.GetKeywordsAsync(_companyId)).Typed;
            _notice = "Saved the words to watch for.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private void StartNewTemplate()
    {
        _error = _notice = null; _editingTemplate = null; _templateForm = true; _criterionForm = false;
        (_tName, _tShip, _tType, _tActive) = ("", "", TankType.Ballast, true);
    }

    private void StartEditTemplate(TankChecklistTemplate t)
    {
        _error = _notice = null; _editingTemplate = t; _templateForm = true; _criterionForm = false;
        (_tName, _tShip, _tType, _tActive) = (t.Name, t.ShipType, t.TankType, t.IsActive);
    }

    private async Task SaveTemplateAsync()
    {
        _error = _notice = null;
        try
        {
            var saved = await Svc.SaveTemplateAsync(_companyId, _editingTemplate?.Id, _tName, _tType, _tShip, _tActive);
            _templateForm = false;
            await LoadAsync();
            _selected = _templates.FirstOrDefault(t => t.Template.Id == saved.Id);
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private void StartNewCriterion()
    {
        _error = _notice = null; _editingCriterion = null; _criterionForm = true;
        (_cName, _cGroup, _cScale, _cExceptions, _cActive) = ("", CriterionGroup.Structure, ScaleKind.Rating, "", true);
        _cOrder = (_selected?.Criteria.Select(c => c.SortOrder).DefaultIfEmpty(-1).Max() ?? -1) + 1;
    }

    private void StartEditCriterion(TankCriterion c)
    {
        _error = _notice = null; _editingCriterion = c; _criterionForm = true;
        (_cName, _cGroup, _cScale, _cExceptions, _cOrder, _cActive) = (c.Name, c.Group, c.Scale, c.ExceptionValues, c.SortOrder, c.IsActive);
    }

    private async Task SaveCriterionAsync()
    {
        _error = _notice = null;
        try
        {
            if (_selected is null) return;
            await Svc.SaveCriterionAsync(_companyId, _selected.Template.Id, _editingCriterion?.Id, _cGroup, _cName, _cScale, string.IsNullOrWhiteSpace(_cExceptions) ? null : _cExceptions, _cOrder, _cActive);
            _criterionForm = false;
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }
}
