@page "/change-password"
@layout LoginLayout
@attribute [Authorize]

<PageTitle>Choose a password · Chandlery</PageTitle>

<div class="w-full max-w-md rise">
    <h1 class="font-display text-3xl font-extrabold text-ink">Choose your password</h1>
    <p class="mt-2 text-muted">Pick a password only you know (at least 8 characters).</p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600">
            @(Error switch { "current" => "The current password is not right.", "match" => "The two new passwords do not match.", _ => "The new password must be at least 8 characters." })
        </div>
    }

    <form method="post" action="account/change-password" class="mt-8 flex flex-col gap-5">
        <AntiforgeryToken />
        <div><label class="label">Current (temporary) password</label><input name="current" type="password" required autocomplete="current-password" class="input" /></div>
        <div><label class="label">New password</label><input name="new" type="password" required minlength="8" autocomplete="new-password" class="input" /></div>
        <div><label class="label">Repeat new password</label><input name="confirm" type="password" required minlength="8" autocomplete="new-password" class="input" /></div>
        <button type="submit" class="btn btn-primary mt-1 py-3">Save and continue</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
