@page "/vessel/rfqs"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@inject OnboardRfqService RfqSvc

<PageTitle>RFQs · Chandlery</PageTitle>

<PageHeader Eyebrow="Vessel" Title="RFQs" Subtitle="@($"{_rows.Count:N0} requests for quotation. Raise one from a requisition; quotes come back here to compare.")" />

<div class="mb-4">
    <input @bind="_search" @bind:event="oninput" @bind:after="Load" placeholder="Search RFQ number…" class="input max-w-xs" />
</div>

<div class="card overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="border-b border-line text-xs uppercase tracking-wide text-muted">
                <th class="px-4 py-3 font-medium">RFQ</th>
                <th class="px-4 py-3 font-medium">Requisition</th>
                <th class="px-4 py-3 font-medium">Date</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 font-medium">Handled by</th>
                <th class="px-4 py-3 text-right font-medium">Lines</th>
                <th class="px-4 py-3 text-right font-medium">Quotes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr class="border-b border-line/60 hover:bg-surface-2/50">
                    <td class="px-4 py-3 font-mono font-semibold"><a href="/vessel/rfqs/@r.Id" class="link">@r.RfqNumber</a></td>
                    <td class="px-4 py-3">@(r.RequisitionNumber ?? "–")</td>
                    <td class="px-4 py-3">@r.Created.ToString("dd MMM yyyy")</td>
                    <td class="px-4 py-3"><StatusChip Value="@r.Status" /></td>
                    <td class="px-4 py-3">@(r.OwnerStage == SyncStages.Vessel ? "This vessel" : "Office")</td>
                    <td class="px-4 py-3 text-right">@r.Lines</td>
                    <td class="px-4 py-3 text-right">@(r.OwnerStage == SyncStages.Vessel ? $"{r.Quotes} of {r.Invited}" : "–")</td>
                </tr>
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="7" class="px-4 py-8 text-center text-muted">No RFQs yet. Open a requisition and use "Create RFQ".</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private string _search = "";
    private List<OnboardRfqRow> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        await Load();
    }

    private async Task Load() => _rows = await RfqSvc.ListAsync(_companyId, _search);
}
