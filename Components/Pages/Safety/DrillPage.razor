@page "/drills/{Id:guid}"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@using Chandlery.Models
@inject DrillService Svc

<PageTitle>@(_d?.Drill.Code ?? "Drill") · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="5" />
}
else if (_d is null)
{
    <EmptyState Title="Drill not found" Message="It does not exist, or it belongs to another vessel." />
}
else
{
    var dr = _d.Drill;
    <PageHeader Eyebrow="@_d.VesselName" Title="@dr.Code" Subtitle="@($"{dr.TypeName}, {DrillLook.When(dr.StartedAt)}")">
        <Actions>
            @if (_d.Can.Edit) { <a href="/drills/@dr.Id/edit" class="btn btn-primary">Change the drill</a> }
            <a href="/drills/@dr.Id/pdf" target="_blank" class="btn btn-secondary">PDF</a>
            <a href="/drills/history" class="btn btn-secondary">History</a>
        </Actions>
    </PageHeader>

    <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="chip">@DrillLook.Category(dr.Category)</span>
        @if (dr.IsSigned) { <StatusChip Label="@($"Signed by {dr.SignedByName}, {DrillLook.When(dr.SignedAt!.Value)}")" Tone="success" /> } else { <StatusChip Label="Not signed by the Master" Tone="warning" /> }
        @if (_d.PossibleDuplicate) { <span class="chip" data-tone="warning">possible duplicate: another drill of this kind within the hour</span> }
        @if (dr.Deficiencies != "") { <span class="chip" data-tone="danger">deficiencies found</span> }
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        <div class="space-y-5 lg:col-span-2">
            <div class="card p-4 text-sm">
                <h2 class="mb-3 text-base font-semibold text-ink">The drill</h2>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-2 md:grid-cols-2">
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Began</dt><dd>@DrillLook.When(dr.StartedAt) (ship's time)</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Ended</dt><dd>@(dr.EndedAt is { } end ? $"{DrillLook.When(end)} ({DrillLook.Duration(_d.Duration)})" : "–")</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Where</dt><dd>@(dr.Place == "" ? "–" : dr.Place), @IncidentLook.ShipStatus(dr.ShipStatus).ToLowerInvariant()</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Conducted by</dt><dd>@dr.ConductedByName</dd></div>
                </dl>
                @Block("Scenario", dr.Scenario)
                @Block("Equipment used or tested", dr.EquipmentTested)
                @Block("Findings", dr.Findings)
                @Block("Deficiencies", dr.Deficiencies)
                @Block("Remarks", dr.Remarks)
            </div>

            <div class="card p-4 text-sm">
                <h2 class="mb-3 text-base font-semibold text-ink">Who was there</h2>
                <table class="w-full text-left">
                    <thead class="text-xs uppercase tracking-wide text-muted"><tr><th class="py-1">Name</th><th>Rank</th><th>Attendance</th></tr></thead>
                    <tbody>
                        @foreach (var p in dr.Participants.OrderBy(x => x.Attendance).ThenBy(x => x.Name))
                        {
                            <tr class="border-t border-line/60"><td class="py-1 font-medium">@p.Name</td><td>@p.Rank</td><td>@DrillLook.Attendance(p.Attendance)@(p.Absence != DrillAbsence.None ? $": {DrillLook.Absence(p.Absence)}" : "")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (dr.Notes.Count > 0 || _d.Comments.Count > 0)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-3 text-base font-semibold text-ink">Notes and comments</h2>
                    <ul class="space-y-3">
                        @foreach (var n in dr.Notes.OrderBy(x => x.At))
                        {
                            <li><p class="whitespace-pre-line">@n.Text</p><p class="text-xs text-muted">Note, @n.ByName, @DrillLook.When(n.At)</p></li>
                        }
                        @foreach (var c in _d.Comments)
                        {
                            <li><p class="whitespace-pre-line">@c.Text</p><p class="text-xs text-muted">The office, @c.ByName, @DrillLook.When(c.At)</p></li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="space-y-5">
            @if (_d.Can.Sign)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-1 text-base font-semibold text-ink">Sign as Master</h2>
                    <p class="mb-3 text-xs text-muted">Once signed the drill is as it stands: only dated notes can be added.</p>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SignAsync">Sign the drill</button>
                </div>
            }

            @if (_d.Actions.Count > 0 || _d.Can.AddAction)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-3 text-base font-semibold text-ink">Actions</h2>
                    @if (_d.Actions.Count == 0) { <p class="text-muted">No actions yet.</p> }
                    <ul class="space-y-1">
                        @foreach (var t in _d.Actions)
                        {
                            <li class="flex flex-wrap items-center gap-2"><a href="/worklist/@t.Id" class="link font-mono font-semibold">@t.Code</a><span>@t.Title</span><StatusChip Value="@t.Status" /></li>
                        }
                    </ul>
                    @if (_d.Can.AddAction)
                    {
                        <div class="mt-4 space-y-2 border-t border-line pt-3">
                            <input class="input w-full" maxlength="200" placeholder="New action: what must be done" @bind="_actionTitle" />
                            <textarea class="textarea w-full" rows="2" maxlength="2000" placeholder="Details (optional)" @bind="_actionText"></textarea>
                            <div class="flex flex-wrap items-end gap-2">
                                <label>Due<input type="date" class="input mt-1" @bind="_actionDue" /></label>
                                <label>For<input class="input mt-1" maxlength="120" placeholder="Name or rank" @bind="_actionFor" /></label>
                                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="AddActionAsync">Add action</button>
                            </div>
                            @if (dr.Deficiencies != "") { <button class="btn btn-ghost btn-sm" @onclick="UseDeficiencies">Start from the deficiencies found</button> }
                        </div>
                    }
                </div>
            }

            @if (_d.Can.Note)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-2 text-base font-semibold text-ink">Add a note</h2>
                    <textarea class="textarea w-full" rows="3" maxlength="2000" placeholder="Something found out or done since, dated and signed with your name" @bind="_note"></textarea>
                    <button class="btn btn-secondary btn-sm mt-2" disabled="@_busy" @onclick="NoteAsync">Add</button>
                </div>
            }

            @if (_d.Can.Comment)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-2 text-base font-semibold text-ink">Comment for the vessel</h2>
                    <textarea class="textarea w-full" rows="3" maxlength="2000" @bind="_comment"></textarea>
                    <button class="btn btn-secondary btn-sm mt-2" disabled="@_busy" @onclick="CommentAsync">Send the comment</button>
                </div>
            }

            @if (_error is not null) { <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div> }
            @if (_notice is not null) { <div class="rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">@_notice</div> }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Actor _actor = default!;
    private DrillDetail? _d;
    private bool _loaded, _busy;
    private string? _error, _notice;
    private string _note = "", _comment = "", _actionTitle = "", _actionText = "", _actionFor = "";
    private DateTime? _actionDue;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        try { _d = await Svc.GetAsync(_companyId, Id, _actor); }
        catch (InvalidOperationException) { _d = null; }
    }

    private static RenderFragment Block(string title, string text) => string.IsNullOrWhiteSpace(text) ? (builder => { }) : (builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "mt-3");
        builder.OpenElement(2, "h3"); builder.AddAttribute(3, "class", "text-xs font-bold uppercase tracking-wider text-muted"); builder.AddContent(4, title); builder.CloseElement();
        builder.OpenElement(5, "p"); builder.AddAttribute(6, "class", "whitespace-pre-line"); builder.AddContent(7, text); builder.CloseElement();
        builder.CloseElement();
    });

    private async Task RunAsync(Func<Task> work, string done)
    {
        _error = _notice = null;
        _busy = true;
        try { await work(); await LoadAsync(); _notice = done; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task SignAsync() => RunAsync(async () => { await Svc.SignAsync(_companyId, Id, _actor); }, "Signed.");

    private Task NoteAsync() => RunAsync(async () => { await Svc.AddNoteAsync(_companyId, Id, _actor, _note); _note = ""; }, "The note is added.");

    private Task CommentAsync() => RunAsync(async () => { await Svc.CommentAsync(_companyId, Id, _actor, _comment); _comment = ""; }, "The comment is sent.");

    private Task AddActionAsync() => RunAsync(async () =>
    {
        await Svc.AddActionAsync(_companyId, Id, _actor, new NewDrillAction(_actionTitle, _actionText, _actionDue is { } due ? DateTime.SpecifyKind(due, DateTimeKind.Utc) : null, _actionFor));
        (_actionTitle, _actionText, _actionFor, _actionDue) = ("", "", "", null);
    }, "The action is a task in the Worklist.");

    private void UseDeficiencies()
    {
        _actionTitle = $"Put right: {_d!.Drill.Deficiencies.Split('\n')[0].Trim()}";
        _actionText = _d.Drill.Deficiencies;
    }
}
