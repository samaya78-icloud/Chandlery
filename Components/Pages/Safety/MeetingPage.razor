@page "/meetings/{Id:guid}"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@using Chandlery.Models
@inject MeetingService Svc

<PageTitle>@(_d?.Meeting.Code ?? "Meeting") · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="5" />
}
else if (_d is null)
{
    <EmptyState Title="Meeting not found" Message="It does not exist, or it belongs to another vessel." />
}
else
{
    var m = _d.Meeting;
    <PageHeader Eyebrow="@_d.VesselName" Title="@m.Code" Subtitle="@($"{m.TypeName}, {DrillLook.When(m.HeldAt)}")">
        <Actions>
            @if (_d.Can.Edit) { <a href="/meetings/@m.Id/edit" class="btn btn-primary">Change the minutes</a> }
            <a href="/meetings" class="btn btn-secondary">Meetings</a>
        </Actions>
    </PageHeader>

    <div class="mb-5 flex flex-wrap items-center gap-2">
        @if (m.IsSigned) { <StatusChip Label="@($"Signed by {m.SignedByName}, {DrillLook.When(m.SignedAt!.Value)}")" Tone="success" /> } else { <StatusChip Label="Minutes not signed by the Master" Tone="warning" /> }
        @if (_d.Carried.Count > 0) { <span class="chip" data-tone="warning">@_d.Carried.Count action@(_d.Carried.Count == 1 ? "" : "s") still open from earlier meetings</span> }
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        <div class="space-y-5 lg:col-span-2">
            <div class="card p-4 text-sm">
                <h2 class="mb-3 text-base font-semibold text-ink">The meeting</h2>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-2 md:grid-cols-2">
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Held</dt><dd>@DrillLook.When(m.HeldAt) (ship's time)</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Where</dt><dd>@(m.Place == "" ? "–" : m.Place)</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Chair</dt><dd>@m.ChairName</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-muted">Secretary</dt><dd>@(m.SecretaryName == "" ? "–" : m.SecretaryName)</dd></div>
                </dl>
                @if (m.Summary != "") { <p class="mt-3 whitespace-pre-line">@m.Summary</p> }
            </div>

            @if (_d.Carried.Count > 0)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-1 text-base font-semibold text-ink">Open from earlier meetings</h2>
                    <p class="mb-3 text-xs text-muted">Still open when this meeting was held.</p>
                    <ul class="space-y-1">
                        @foreach (var c in _d.Carried)
                        {
                            <li class="flex flex-wrap items-center gap-2"><a href="/worklist/@c.Task.Id" class="link font-mono font-semibold">@c.Task.Code</a><span>@c.Task.Title</span><StatusChip Value="@c.Task.Status" /><span class="text-xs text-muted">from <a class="link" href="/meetings/@c.FromMeetingId">@c.FromCode</a>, @c.FromHeldAt.ToString("d MMM yyyy")</span></li>
                        }
                    </ul>
                </div>
            }

            <div class="card p-4 text-sm">
                <h2 class="mb-3 text-base font-semibold text-ink">Agenda and what was said</h2>
                <ol class="space-y-4">
                    @foreach (var item in m.Items.OrderBy(x => x.Position))
                    {
                        <li>
                            <p class="font-medium">@item.Position. @item.Title @if (item.Kind == MeetingItemKind.Suggestion) { <span class="chip" data-tone="info">suggestion@(item.RaisedBy == "" ? "" : $" from {item.RaisedBy}")</span> }</p>
                            @if (item.Notes != "") { <p class="mt-1 whitespace-pre-line text-muted">@item.Notes</p> }
                        </li>
                    }
                </ol>
            </div>

            <div class="card p-4 text-sm">
                <h2 class="mb-3 text-base font-semibold text-ink">Who was there</h2>
                <table class="w-full text-left">
                    <thead class="text-xs uppercase tracking-wide text-muted"><tr><th class="py-1">Name</th><th>Rank</th><th>Attendance</th></tr></thead>
                    <tbody>
                        @foreach (var a in m.Attendees.OrderBy(x => x.Attendance).ThenBy(x => x.Name))
                        {
                            <tr class="border-t border-line/60"><td class="py-1 font-medium">@a.Name</td><td>@a.Rank</td><td>@DrillLook.Attendance(a.Attendance)@(a.Absence != DrillAbsence.None ? $": {DrillLook.Absence(a.Absence)}" : "")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (m.Notes.Count > 0 || _d.Comments.Count > 0)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-3 text-base font-semibold text-ink">Notes and comments</h2>
                    <ul class="space-y-3">
                        @foreach (var n in m.Notes.OrderBy(x => x.At)) { <li><p class="whitespace-pre-line">@n.Text</p><p class="text-xs text-muted">Note, @n.ByName, @DrillLook.When(n.At)</p></li> }
                        @foreach (var c in _d.Comments) { <li><p class="whitespace-pre-line">@c.Text</p><p class="text-xs text-muted">The office, @c.ByName, @DrillLook.When(c.At)</p></li> }
                    </ul>
                </div>
            }
        </div>

        <div class="space-y-5">
            @if (_d.Can.Sign)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-1 text-base font-semibold text-ink">Sign the minutes</h2>
                    <p class="mb-3 text-xs text-muted">Once signed the minutes stand as written: only dated notes can be added.</p>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SignAsync">Sign as Master</button>
                </div>
            }

            @if (_d.Actions.Count > 0 || _d.Can.AddAction)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-3 text-base font-semibold text-ink">Actions from this meeting</h2>
                    @if (_d.Actions.Count == 0) { <p class="text-muted">No actions yet.</p> }
                    <ul class="space-y-1">
                        @foreach (var t in _d.Actions) { <li class="flex flex-wrap items-center gap-2"><a href="/worklist/@t.Id" class="link font-mono font-semibold">@t.Code</a><span>@t.Title</span><StatusChip Value="@t.Status" /></li> }
                    </ul>
                    @if (_d.Can.AddAction)
                    {
                        <div class="mt-4 space-y-2 border-t border-line pt-3">
                            <input class="input w-full" maxlength="200" placeholder="New action: what must be done" @bind="_actionTitle" />
                            <textarea class="textarea w-full" rows="2" maxlength="2000" placeholder="Details (optional)" @bind="_actionText"></textarea>
                            <div class="flex flex-wrap items-end gap-2">
                                <label>Due<input type="date" class="input mt-1" @bind="_actionDue" /></label>
                                <label>For<input class="input mt-1" maxlength="120" placeholder="Name or rank" @bind="_actionFor" /></label>
                                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="AddActionAsync">Add action</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_d.Can.Note)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-2 text-base font-semibold text-ink">Add a note</h2>
                    <textarea class="textarea w-full" rows="3" maxlength="2000" @bind="_note"></textarea>
                    <button class="btn btn-secondary btn-sm mt-2" disabled="@_busy" @onclick="NoteAsync">Add</button>
                </div>
            }

            @if (_d.Can.Comment)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-2 text-base font-semibold text-ink">Comment for the vessel</h2>
                    <textarea class="textarea w-full" rows="3" maxlength="2000" @bind="_comment"></textarea>
                    <button class="btn btn-secondary btn-sm mt-2" disabled="@_busy" @onclick="CommentAsync">Send the comment</button>
                </div>
            }

            @if (_error is not null) { <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div> }
            @if (_notice is not null) { <div class="rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">@_notice</div> }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Actor _actor = default!;
    private MeetingDetail? _d;
    private bool _loaded, _busy;
    private string? _error, _notice;
    private string _note = "", _comment = "", _actionTitle = "", _actionText = "", _actionFor = "";
    private DateTime? _actionDue;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        try { _d = await Svc.GetAsync(_companyId, Id, _actor); }
        catch (InvalidOperationException) { _d = null; }
    }

    private async Task RunAsync(Func<Task> work, string done)
    {
        _error = _notice = null;
        _busy = true;
        try { await work(); await LoadAsync(); _notice = done; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task SignAsync() => RunAsync(async () => { await Svc.SignAsync(_companyId, Id, _actor); }, "Signed.");

    private Task NoteAsync() => RunAsync(async () => { await Svc.AddNoteAsync(_companyId, Id, _actor, _note); _note = ""; }, "The note is added.");

    private Task CommentAsync() => RunAsync(async () => { await Svc.CommentAsync(_companyId, Id, _actor, _comment); _comment = ""; }, "The comment is sent.");

    private Task AddActionAsync() => RunAsync(async () =>
    {
        await Svc.AddActionAsync(_companyId, Id, _actor, new NewMeetingAction(_actionTitle, _actionText, _actionDue is { } due ? DateTime.SpecifyKind(due, DateTimeKind.Utc) : null, _actionFor));
        (_actionTitle, _actionText, _actionFor, _actionDue) = ("", "", "", null);
    }, "The action is a task in the Worklist.");
}
