@page "/yard/tenders/{TenderId:guid}"
@attribute [Authorize(Roles = "YardUser")]
@rendermode InteractiveServer
@inject YardPortalService Portal
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Quote · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else if (_view is null)
{
    <EmptyState Title="Tender not found" Message="It may not be one your yard was invited to.">
        <Action><a href="/yard" class="btn btn-secondary">Back to tenders</a></Action>
    </EmptyState>
}
else
{
    var inv = _view.Invitation;
    <PageHeader Eyebrow="Tender" Title="@inv.ProjectTitle">
        <Facts>
            <span>@inv.VesselName</span>
            <span>&middot; @(inv.Type == ProjectType.Drydock ? "Drydock" : "Technical project")</span>
            @if (inv.PlannedStart is { } s) { <span>&middot; planned @s.ToString("d MMM yyyy")@(inv.PlannedEnd is { } e ? " to " + e.ToString("d MMM yyyy") : "")</span> }
        </Facts>
        <Actions><a href="/yard" class="btn btn-secondary btn-sm">All tenders</a></Actions>
    </PageHeader>

    @if (_view.Scope != "") { <p class="mb-4 max-w-3xl text-sm text-muted">@_view.Scope</p> }

    @if (inv.Status == TenderStatus.Awarded) { <div class="mb-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">This job has been awarded to your yard.</div> }
    else if (inv.Status == TenderStatus.NotAwarded) { <div class="mb-4 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-600">This job was not awarded to your yard.</div> }
    else if (!inv.CanQuote) { <div class="mb-4 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-600">This tender is closed to new quotes.</div> }

    @if (_error is not null) { <div class="mb-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div> }

    <section class="card mb-6 p-5">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Your prices (USD)</h2>
        <div class="overflow-x-auto">
            <table class="w-full max-w-3xl text-sm">
                <thead class="text-left text-xs uppercase tracking-wide text-muted"><tr><th class="p-2">Job</th><th class="p-2 text-right">Your price</th></tr></thead>
                <tbody class="divide-y divide-line/60">
                    @foreach (var item in _view.Items)
                    {
                        <tr>
                            <td class="p-2"><span class="text-xs text-muted">@item.Group</span> @item.Description</td>
                            <td class="p-2 text-right">
                                @if (inv.CanQuote) { <input type="number" step="0.01" min="0" class="input w-36 text-right" placeholder="not priced" value="@_prices.GetValueOrDefault(item.Id)" @onchange="e => SetPrice(item.Id, e.Value?.ToString())" /> }
                                else { @(_prices.GetValueOrDefault(item.Id) is { } p ? Money.Format(p, "USD") : "—") }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex flex-wrap items-end gap-4 text-sm">
            <label>Other charges (docking, shore power, wharfage), USD
                @if (inv.CanQuote) { <input type="number" step="0.01" min="0" class="input mt-1 w-40 text-right" @bind="_other" /> } else { <span class="mt-1 block tabular-nums">@Money.Format(_other, "USD")</span> }
            </label>
            <label>Your reference @if (inv.CanQuote) { <input class="input mt-1" @bind="_reference" /> } else { <span class="mt-1 block">@(_reference == "" ? "—" : _reference)</span> }</label>
            <label>Valid until @if (inv.CanQuote) { <input type="date" class="input mt-1" @bind="_valid" /> } else { <span class="mt-1 block">@(_valid is { } v ? v.ToString("d MMM yyyy") : "—")</span> }</label>
        </div>
        @if (inv.CanQuote)
        {
            <label class="mt-4 block text-sm">Remarks <input class="input mt-1 w-full max-w-3xl" @bind="_remarks" /></label>
            @if (inv.Status == TenderStatus.Quoted)
            {
                <label class="mt-4 block text-sm">Why are you changing your quote? <input class="input mt-1 w-full max-w-3xl" @bind="_reason" placeholder="required when you update a quote you have already sent" /></label>
            }
            <div class="mt-4 flex items-center gap-3">
                <button @onclick="Submit" disabled="@_busy" class="btn btn-primary">@(inv.Status == TenderStatus.Invited ? "Submit quote" : "Update quote")</button>
                @if (inv.QuoteTotal is { } total) { <span class="text-sm text-muted">Current quote: @Money.Format(total, "USD")</span> }
                @if (inv.Status == TenderStatus.Invited)
                {
                    <button @onclick="() => _declining = !_declining" disabled="@_busy" class="btn btn-secondary ml-auto">Decline to quote</button>
                }
            </div>
            @if (_declining)
            {
                <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                    <input class="input min-w-64 flex-1" placeholder="Why you will not quote" @bind="_declineReason" />
                    <button @onclick="Decline" disabled="@_busy" class="btn btn-secondary btn-sm">Confirm decline</button>
                </div>
            }
        }
    </section>

    @if (_revisions.Count > 1)
    {
        <section class="card mb-6 p-5">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Your quote history</h2>
            <ol class="ml-4 list-decimal text-sm">
                @foreach (var r in _revisions) { <li>@Money.Format(r.TotalUsd, "USD") <span class="text-xs text-muted">@r.At.ToString("d MMM yyyy")@(r.Reason == "" ? "" : " · " + r.Reason)</span></li> }
            </ol>
        </section>
    }

    <section class="card mb-6 p-5">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Questions for the owner</h2>
        @foreach (var q in _questions)
        {
            <div class="mb-3 text-sm">
                <div><span class="text-xs text-muted">You asked @q.AskedAt.ToString("d MMM")</span> @q.Question</div>
                @if (q.AnsweredAt is not null) { <div class="mt-1 rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800">@q.Answer</div> }
                else { <div class="mt-1 text-xs text-muted">Waiting for an answer.</div> }
            </div>
        }
        @if (_questions.Count == 0) { <p class="mb-3 text-sm text-muted">No questions yet.</p> }
        @if (inv.Status is TenderStatus.Invited or TenderStatus.Quoted)
        {
            <div class="flex flex-wrap items-center gap-2 text-sm">
                <input class="input min-w-64 flex-1" placeholder="Ask about the specification" @bind="_question" />
                <button @onclick="Ask" disabled="@_busy" class="btn btn-secondary">Ask</button>
            </div>
        }
    </section>

    <section class="card mb-6 p-5">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Your quotation</h2>
        @if (_view.Files.Count == 0) { <p class="mb-3 text-sm text-muted">No file attached.</p> }
        @foreach (var f in _view.Files)
        {
            <span class="mr-2 inline-flex items-center rounded-lg border border-line bg-surface px-2 py-1 text-xs"><a href="/yard/files/@f.Id" target="_blank" class="link">@f.FileName</a></span>
        }
        @if (inv.CanQuote)
        {
            <div class="mt-2"><FilePicker Files="_pending" OnChanged="Upload" AllowShare="false" Label="Attach your quotation (PDF or image)" /></div>
        }
    </section>
}

@code {
    [Parameter] public Guid TenderId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _yardId, _companyId;
    private Actor _actor = Actor.System;
    private bool _loaded, _busy;
    private string? _error;
    private YardTenderView? _view;
    private readonly Dictionary<Guid, decimal?> _prices = [];
    private decimal _other;
    private string _reference = "", _remarks = "", _reason = "", _question = "", _declineReason = "";
    private bool _declining;
    private List<YardPortalService.YardQuestion> _questions = [];
    private List<ProjectTenderRevision> _revisions = [];
    private DateTime? _valid;
    private readonly List<PendingAttachment> _pending = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask!).User;
        if (user.HasClaim("MustChange", "true")) { Navigation.NavigateTo("/change-password", replace: true); return; }   // the temporary password has to be replaced first
        _actor = Actor.From(user);
        if (Guid.TryParse(user.FindFirst("YardId")?.Value, out _yardId) && Guid.TryParse(user.FindFirst("YardCompanyId")?.Value, out _companyId)) await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        try { _view = await Portal.TenderAsync(_companyId, _yardId, TenderId); }
        catch (InvalidOperationException) { _view = null; return; }
        _questions = await Portal.QuestionsAsync(_companyId, _yardId, TenderId);
        _revisions = await Portal.RevisionsAsync(_companyId, _yardId, TenderId);
        _reason = "";
        _prices.Clear();
        foreach (var (id, amount) in _view.Prices) _prices[id] = amount;
        (_other, _reference, _valid, _remarks) = (_view.Tender.OtherChargesUsd, _view.Tender.YardReference, _view.Tender.ValidUntil, _view.Tender.Remarks);
    }

    private void SetPrice(Guid itemId, string? text)
        => _prices[itemId] = decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : null;

    private async Task Run(Func<Task> action, string? success)
    {
        _busy = true;
        _error = null;
        try { await action(); await LoadAsync(); if (success is not null) await Toasts.Success(success); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task Submit() => Run(() => Portal.SubmitQuoteAsync(_companyId, _yardId, TenderId, new TenderQuoteInput(_reference, _valid, _other, _remarks, new Dictionary<Guid, decimal?>(_prices), _reason)), "Quote saved");

    private async Task Ask()
    {
        _busy = true;
        _error = null;
        try { await Portal.AskAsync(_companyId, _yardId, TenderId, _question, _actor.Name); _question = ""; _questions = await Portal.QuestionsAsync(_companyId, _yardId, TenderId); await Toasts.Success("Question sent"); }   // only the questions are refreshed, so prices typed but not yet submitted stay
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task Decline() => Run(async () => { await Portal.DeclineAsync(_companyId, _yardId, TenderId, _declineReason); _declining = false; }, "Declined");

    private async Task Upload()
    {
        var list = _pending.ToList();
        _pending.Clear();
        await Run(async () => { foreach (var file in list) await Portal.AddFileAsync(_companyId, _yardId, TenderId, file, _actor.Name); }, list.Count == 0 ? null : "File attached");
    }
}
