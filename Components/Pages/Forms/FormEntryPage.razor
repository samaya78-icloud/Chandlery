@page "/forms/entry/{Id:guid}"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@using System.Text.Json.Nodes
@inject FormService Svc
@inject FormReports Reports
@inject NavigationManager Nav

<PageTitle>@(_detail?.Entry.Code ?? "Form") · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else if (_detail is null)
{
    <EmptyState Title="Form not found" Message="It may belong to another vessel, or forms are switched off." />
}
else
{
    var entry = _detail.Entry;
    var lastReturn = _detail.Reviews.LastOrDefault(r => r.Decision == ReviewDecision.Returned && r.ForSubmission == entry.SubmissionCount);

    <PageHeader Eyebrow="@entry.Code" Title="@($"{entry.FormCode} · {entry.FormTitle}")" Subtitle="@($"Version {entry.VersionNumber} · {entry.FormDate:dd MMM yyyy}{(entry.FilledAshore ? " · filled ashore" : "")}")">
        <Actions>
            <a href="@(_office ? "/forms/review" : "/forms")" class="btn btn-secondary">@(_office ? "Forms to review" : "All forms")</a>
            @if (entry.SubmissionCount > 0) { <a href="/forms/entry/@entry.Id/pdf" target="_blank" class="btn btn-secondary">Print / PDF</a> }
            @if (_detail.Status == FormStatus.Reviewed) { <button class="btn btn-secondary" @onclick="CorrectAsync" disabled="@_busy">Correct it</button> }
            @if (_editable)
            {
                <button class="btn btn-secondary" @onclick="SaveNowAsync" disabled="@_busy">Save</button>
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_busy">Submit</button>
            }
        </Actions>
    </PageHeader>

    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }
    @if (_notice is not null) { <div class="mb-4 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@_notice</div> }
    @if (lastReturn is not null && _editable)
    {
        <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800"><span class="font-semibold">Returned by @lastReturn.ReviewerName:</span> @lastReturn.Comment</div>
    }
    @if (!_editable)
    {
        <div class="mb-4 rounded-xl border border-line bg-surface-2/60 px-4 py-3 text-sm text-ink-2">
            @if (_detail.Status == FormStatus.Reviewed) { <span>This form has been reviewed and is locked. To correct it, start a new one for the same date.</span> }
            else if (_detail.Status is FormStatus.Submitted or FormStatus.InReview) { <span>This form has been sent to the office. It can be changed again only if the office returns it.</span> }
            else { <span>This form is being filled in @(entry.OwnerStage == SyncStages.Vessel ? "onboard" : "by the office").</span> }
        </div>
    }

    <div class="mb-5 flex flex-wrap items-center gap-2">
        <StatusChip Value="@_detail.Status" />
        @if (entry.ExceptionCount > 0 || (_check?.Exceptions.Count ?? 0) > 0) { <span class="chip" data-tone="warning">@(_editable ? _check!.Exceptions.Count : entry.ExceptionCount) exception(s)</span> }
        @if (entry.SubmissionCount > 1) { <span class="chip chip-plain" data-tone="neutral">submitted @entry.SubmissionCount times</span> }
        @if (_editable && _savedAt is { } saved) { <span class="text-xs text-muted">Saved @saved.ToLocalTime().ToString("HH:mm")</span> }
        @if (entry.CorrectsEntryId is not null) { <a class="link text-sm" href="/forms/entry/@entry.CorrectsEntryId">corrects an earlier form</a> }
    </div>

    @if (_editable)
    {
        <div class="card mb-5 p-4 text-sm"><label class="block max-w-xs text-xs text-muted">The form is about the date
            <input type="date" class="input mt-1" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" @bind="_date" @bind:after="SaveNowAsync" /></label></div>
    }

    @if (_detail.Definition is null)
    {
        <EmptyState Title="This version cannot be shown" Message="Its definition cannot be read. Ask the office to check it." />
    }
    else
    {
        <FormRenderer Definition="_detail.Definition" Values="_values" ReadOnly="!_editable" ForSubmit="_showRequired" OnChanged="ChangedAsync" AddPhoto="AddPhotoAsync" />
    }

    @if (_check is { Exceptions.Count: > 0 } check)
    {
        <div class="card mt-5 p-4 text-sm">
            <h2 class="mb-2 font-display text-base font-extrabold text-ink">Exceptions</h2>
            <ul class="space-y-1 text-xs">
                @foreach (var e in check.Exceptions)
                {
                    <li class="flex flex-wrap items-center gap-2">@e.Message
                        @if (_office && entry.SubmissionCount > 0) { <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RaiseFrom(e.Message)">Raise an action</button> }
                    </li>
                }
            </ul>
        </div>
    }

    @if (_office && (_detail.Status is FormStatus.Submitted or FormStatus.InReview))
    {
        <div class="card mt-5 p-4 text-sm">
            <h2 class="mb-2 font-display text-base font-extrabold text-ink">Review</h2>
            <textarea class="textarea" rows="2" placeholder="Comment (needed to return it for correction)" @bind="_comment"></textarea>
            <div class="mt-3 flex flex-wrap gap-2">
                @if (_detail.Status == FormStatus.Submitted) { <button class="btn btn-secondary" @onclick="() => ReviewAsync(ReviewDecision.Started)" disabled="@_busy">Start review</button> }
                <button class="btn btn-primary" @onclick="() => ReviewAsync(ReviewDecision.Accepted)" disabled="@_busy">Accept</button>
                <button class="btn btn-secondary" @onclick="() => ReviewAsync(ReviewDecision.Returned)" disabled="@_busy">Return for correction</button>
            </div>
        </div>
    }

    @if (_office && entry.SubmissionCount > 0)
    {
        <div class="card mt-5 p-4 text-sm">
            <h2 class="mb-2 font-display text-base font-extrabold text-ink">Action items</h2>
            @if (_actions.Count == 0) { <p class="text-xs text-muted">No tasks have been raised from this form.</p> }
            else
            {
                <ul class="mb-3 space-y-1">
                    @foreach (var t in _actions)
                    {
                        <li class="flex flex-wrap items-center gap-2"><a href="/worklist/@t.Id" class="link font-mono font-semibold">@t.Code</a><span>@t.Title</span><StatusChip Value="@t.Status" /></li>
                    }
                </ul>
            }
            @if (_actionOpen)
            {
                <div class="grid gap-2 md:grid-cols-2">
                    <input class="input md:col-span-2" placeholder="Title" @bind="_actionTitle" />
                    <textarea class="textarea md:col-span-2" rows="2" placeholder="What has to be done" @bind="_actionText"></textarea>
                    <label class="text-xs text-muted">Target date <input type="date" class="input mt-1" @bind="_actionTarget" /></label>
                </div>
                <div class="mt-3 flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="AddActionAsync" disabled="@_busy">Raise as a task</button>
                    <button class="btn btn-ghost btn-sm" @onclick="() => _actionOpen = false">Cancel</button>
                </div>
            }
            else { <button class="btn btn-secondary btn-sm" @onclick="() => RaiseFrom(string.Empty)">Raise an action</button> }
        </div>
    }

    @if (_detail.Reviews.Count > 0)
    {
        <div class="card mt-5 p-4 text-sm">
            <h2 class="mb-2 font-display text-base font-extrabold text-ink">Review</h2>
            <ul class="space-y-1 text-xs">
                @foreach (var r in _detail.Reviews)
                {
                    <li><span class="font-semibold">@r.ReviewerName</span> · @r.At.ToLocalTime().ToString("dd MMM HH:mm") · @r.Decision.ToString().ToLowerInvariant() (submission @r.ForSubmission)@(r.Comment == "" ? "" : ": " + r.Comment)</li>
                }
            </ul>
        </div>
    }

    <div id="conversation" class="mt-6">
        <ConversationPanel CompanyId="_companyId" Actor="_actor" ModuleType="@ChatModules.FormEntry" RecordId="entry.Id" VesselId="entry.VesselId" Title="Conversation" />
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Actor _actor = Actor.System;
    private bool _loaded, _busy, _showRequired;
    private string? _error, _notice;
    private FormEntryDetail? _detail;
    private JsonObject _values = [];
    private FormCheck? _check;
    private DateTime _date;
    private DateTime? _savedAt;
    private bool _office;
    private string _comment = "";
    private List<WorklistTask> _actions = [];
    private bool _actionOpen;
    private string _actionTitle = "", _actionText = "";
    private DateTime? _actionTarget;

    /// <summary>A draft or returned entry, held by this side, can be changed.</summary>
    private bool _editable => _detail is { } d && FormStatusRules.IsEditable(d.Status) && d.Entry.OwnerStage == (NodeContext.Current.IsVessel ? SyncStages.Vessel : SyncStages.Office);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _office = !NodeContext.Current.IsVessel;
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _detail = await Svc.GetAsync(_companyId, Id);
        if (_detail is null) return;
        _values = JsonNode.Parse(_detail.Entry.Values) as JsonObject ?? [];
        _date = _detail.Entry.FormDate;
        _check = _detail.Definition is null ? null : FormValueRules.Check(_detail.Definition, _values, DateOnly.FromDateTime(DateTime.UtcNow), false);
        _actions = _office && _detail.Entry.SubmissionCount > 0 ? await Reports.ActionsAsync(_companyId, Id) : [];
    }

    private async Task ReviewAsync(ReviewDecision decision)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            await Svc.ReviewAsync(_companyId, Id, decision, _comment, _actor);
            _comment = "";
            await LoadAsync();
            _notice = decision switch { ReviewDecision.Started => "Review started.", ReviewDecision.Accepted => "Accepted. The form is locked.", _ => "Returned to the vessel for correction." };
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CorrectAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var entry = _detail!.Entry;
            var corrected = await Svc.StartAsync(_companyId, entry.VesselId, entry.FormTypeId, DateTime.UtcNow.Date > entry.FormDate ? entry.FormDate : DateTime.UtcNow.Date, _actor, entry.Id);
            Nav.NavigateTo($"/forms/entry/{corrected.Id}");
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void RaiseFrom(string text)
    {
        _actionOpen = true;
        _actionTitle = text.Length > 90 ? text[..90] : text;
        _actionText = text;
    }

    private async Task AddActionAsync()
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            var task = await Reports.AddActionAsync(_companyId, Id, new NewFormAction(_actionTitle, _actionText, Target: _actionTarget), _actor);
            _actionOpen = false;
            _actionTitle = _actionText = "";
            _actionTarget = null;
            await LoadAsync();
            _notice = $"Task {task.Code} raised on the vessel's worklist.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task<Guid?> AddPhotoAsync(PendingAttachment file) => await Svc.AddPhotoAsync(_companyId, Id, file, _actor);

    /// <summary>Every change is kept as it is made, so nothing typed is lost if the device is put down.</summary>
    private async Task ChangedAsync(FormCheck check)
    {
        _check = check;
        if (!_editable) return;
        try { await Svc.SaveAsync(_companyId, Id, _values, _date); _savedAt = DateTime.UtcNow; _error = null; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task SaveNowAsync()
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            var check = await Svc.SaveAsync(_companyId, Id, _values, _date);
            _savedAt = DateTime.UtcNow;
            _notice = check.Problems.Count == 0 ? "Saved." : $"Saved. {check.Problems.Count} answer(s) could not be kept: {string.Join(" ", check.Problems.Take(2).Select(p => p.ToString()))}";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SubmitAsync()
    {
        _error = _notice = null;
        _showRequired = true;
        _busy = true;
        try
        {
            await Svc.SaveAsync(_companyId, Id, _values, _date);
            var check = await Svc.SubmitAsync(_companyId, Id, _actor);
            _showRequired = false;
            await LoadAsync();
            _notice = check.Exceptions.Count == 0 ? "Submitted. The office will look at it." : $"Submitted with {check.Exceptions.Count} exception(s). The office will look at it.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
