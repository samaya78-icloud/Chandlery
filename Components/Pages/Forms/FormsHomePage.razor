@page "/forms"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@inject FormService Svc
@inject NavigationManager Nav

<PageTitle>Forms · Chandlery</PageTitle>

<PageHeader Eyebrow="Forms" Title="Forms" Subtitle="What is due, what is still to finish, and what has been sent.">
    <Actions>
        @if (!NodeContext.Current.IsVessel) { <a href="/forms/due" class="btn btn-secondary">Due across the fleet</a> }
        @if (_isAdmin) { <a href="/forms/types" class="btn btn-secondary">Design forms</a> }
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else if (_vessels.Count == 0)
{
    <EmptyState Title="Forms are switched off" Message="The module has not been switched on for this vessel." />
}
else
{
    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }

    @if (_vessels.Count > 1)
    {
        <label class="mb-4 block max-w-xs text-sm">Vessel
            <select class="select mt-1" @bind="_vesselId" @bind:after="LoadAsync">
                @foreach (var v in _vessels) { <option value="@v.Id">@v.Name</option> }
            </select>
        </label>
    }

    @if (ToFinish.Count > 0)
    {
        <h2 class="mb-2 font-display text-base font-extrabold text-ink">To finish</h2>
        <div class="card mb-6 divide-y divide-line/60 text-sm">
            @foreach (var row in ToFinish)
            {
                <a href="/forms/entry/@row.Entry.Id" class="flex flex-wrap items-center gap-3 px-4 py-3 hover:bg-surface-2">
                    <span class="font-mono text-xs font-semibold">@row.Entry.FormCode</span>
                    <span class="font-medium">@row.Entry.FormTitle</span>
                    <span class="text-xs text-muted">@row.Entry.FormDate.ToString("dd MMM yyyy") · @row.Entry.Code</span>
                    <span class="ml-auto"><StatusChip Value="@row.Status" /></span>
                </a>
            }
        </div>
    }

    <h2 class="mb-2 font-display text-base font-extrabold text-ink">Forms for this vessel</h2>
    <div class="card mb-6 overflow-x-auto text-sm">
        <table class="w-full">
            <thead><tr class="border-b border-line/60 text-left text-xs text-muted"><th class="px-4 py-2">Form</th><th>How often</th><th>Status</th><th>Next due</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in _due)
                {
                    <tr class="border-b border-line/40">
                        <td class="px-4 py-2"><span class="font-mono text-xs font-semibold">@row.Type.Code</span> <span class="ml-1">@row.Type.Title</span>@if (row.Type.OfficeOnly) { <span class="chip chip-plain ml-2" data-tone="neutral">office only</span> }</td>
                        <td class="text-xs text-muted">@FormTypesPage.PeriodicityName(row.Type.Periodicity)</td>
                        <td><StatusChip Value="@row.Due.Status" />@if (row.Due.MissedPeriods > 0) { <span class="ml-2 text-xs text-rose-700">@row.Due.MissedPeriods missed</span> }</td>
                        <td class="text-xs text-muted">@(row.Due.DueOn?.ToString("dd MMM yyyy") ?? (row.Due.Status == FormDueStatus.NotScheduled ? "by hand" : "—"))</td>
                        <td class="px-4 py-2 text-right">
                            @if (ToFinish.FirstOrDefault(r => r.Entry.FormTypeId == row.Type.Id) is { } open) { <a href="/forms/entry/@open.Entry.Id" class="btn btn-secondary btn-sm">Continue</a> }
                            else { <button class="btn btn-primary btn-sm" @onclick="() => StartAsync(row)" disabled="@_busy">Start</button> }
                        </td>
                    </tr>
                }
                @if (_due.Count == 0) { <tr><td colspan="5" class="px-4 py-4 text-muted">No form has been published for this vessel yet.</td></tr> }
            </tbody>
        </table>
    </div>

    <h2 class="mb-2 font-display text-base font-extrabold text-ink">Entries</h2>
    <div class="card overflow-x-auto text-sm">
        <table class="w-full">
            <thead><tr class="border-b border-line/60 text-left text-xs text-muted"><th class="px-4 py-2">Reference</th><th>Form</th><th>Date</th><th>Status</th><th>Exceptions</th></tr></thead>
            <tbody>
                @foreach (var row in _entries)
                {
                    <tr class="border-b border-line/40 hover:bg-surface-2">
                        <td class="px-4 py-2"><a href="/forms/entry/@row.Entry.Id" class="link font-mono text-xs">@row.Entry.Code</a></td>
                        <td>@row.Entry.FormCode <span class="text-muted">@row.Entry.FormTitle</span></td>
                        <td class="text-xs text-muted">@row.Entry.FormDate.ToString("dd MMM yyyy")</td>
                        <td><StatusChip Value="@row.Status" /></td>
                        <td>@if (row.Entry.ExceptionCount > 0) { <span class="chip" data-tone="warning">@row.Entry.ExceptionCount</span> }</td>
                    </tr>
                }
                @if (_entries.Count == 0) { <tr><td colspan="5" class="px-4 py-4 text-muted">Nothing filled in yet.</td></tr> }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId, _vesselId;
    private bool _loaded, _busy, _isAdmin;
    private string? _error;
    private Actor _actor = Actor.System;
    private List<(Guid Id, string Name)> _vessels = [];
    private List<FormDueRow> _due = [];
    private List<FormEntryRow> _entries = [];

    private List<FormEntryRow> ToFinish => _entries.Where(r => r.Status is FormStatus.Draft or FormStatus.Returned).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _isAdmin = state.User.IsInRole("CompanyAdmin");
        _vessels = await Svc.EnabledVesselsAsync(_companyId);
        if (_vessels.Count > 0) { _vesselId = _vessels[0].Id; await LoadAsync(); }
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _due = await Svc.DueAsync(_companyId, _vesselId, DateOnly.FromDateTime(DateTime.UtcNow), includeOfficeOnly: !NodeContext.Current.IsVessel);
        _entries = (await Svc.ListAsync(_companyId, _vesselId)).Take(60).ToList();
    }

    private async Task StartAsync(FormDueRow row)
    {
        _error = null;
        _busy = true;
        try
        {
            var entry = await Svc.StartAsync(_companyId, _vesselId, row.Type.Id, DateTime.UtcNow.Date, _actor);
            Nav.NavigateTo($"/forms/entry/{entry.Id}");
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
