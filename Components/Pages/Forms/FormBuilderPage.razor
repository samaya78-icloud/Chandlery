@page "/forms/builder/{VersionId:guid}"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.Json.Nodes
@inject FormService Svc
@inject NavigationManager Nav

<PageTitle>Form builder · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else if (_type is null || _version is null)
{
    <EmptyState Title="Form not found" Message="This version does not exist or is not yours." />
}
else
{
    <PageHeader Eyebrow="Forms" Title="@($"{_type.Code} · {_type.Title}")" Subtitle="@Subtitle">
        <Actions>
            <a href="/forms/types?type=@_type.Id" class="btn btn-ghost">Back to the forms</a>
            @if (_editable)
            {
                <button class="btn btn-secondary" @onclick="SaveAsync" disabled="@(_jsonError is not null)">Save the draft</button>
                <button class="btn btn-primary" @onclick="PublishAsync" disabled="@(_jsonError is not null || _problems.Count > 0)">Publish</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="CopyAsync">Copy to a new draft</button>
            }
        </Actions>
    </PageHeader>

    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }
    @if (_notice is not null) { <div class="mb-4 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@_notice</div> }
    @if (!_editable) { <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">This version is @_version.Status.ToString().ToLowerInvariant() and never changes. Copy it to make a new draft.</div> }

    <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
        @foreach (var (key, label) in Tabs)
        {
            <button class="btn @(_tab == key ? "btn-primary" : "btn-secondary") btn-sm" @onclick="() => _tab = key">@label</button>
        }
        <span class="ml-auto">
            @if (_jsonError is not null) { <span class="chip" data-tone="danger">The JSON cannot be read</span> }
            else if (_problems.Count == 0) { <span class="chip" data-tone="success">Ready to publish</span> }
            else { <span class="chip" data-tone="danger">@_problems.Count to fix</span> }
            @if (_dirty && _editable) { <span class="chip ml-1" data-tone="warning">unsaved changes</span> }
        </span>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="space-y-5 lg:col-span-2">
            @if (_tab == "design")
            {
                <div class="card p-4 text-sm">
                    <label class="text-xs text-muted">Form title <input class="input mt-1" @bind="_def.Title" @bind:after="Touch" disabled="@(!_editable)" /></label>
                    <label class="mt-3 block text-xs text-muted">What changed in this version <input class="input mt-1" @bind="_note" @bind:after="MarkDirty" disabled="@(!_editable)" /></label>
                </div>

                @for (var s = 0; s < _def.Sections.Count; s++)
                {
                    var si = s;
                    var section = _def.Sections[si];
                    <fieldset class="space-y-3 card p-4 text-sm" disabled="@(!_editable)">
                        <div class="flex flex-wrap items-end gap-2">
                            <label class="text-xs text-muted">Section id <input class="input mt-1 w-36" @bind="section.Id" @bind:after="Touch" /></label>
                            <label class="flex-1 text-xs text-muted">Title <input class="input mt-1" @bind="section.Title" @bind:after="Touch" /></label>
                            <label class="flex-1 text-xs text-muted">Shown only if <input class="input mt-1 font-mono" @bind="section.ShowIf" @bind:after="Touch" placeholder="for example any(measured.meas.*)" /></label>
                            <span class="chip chip-plain" data-tone="neutral">@(section.Layout == "grid" ? "grid" : "fields")</span>
                            <button class="btn btn-ghost btn-sm" disabled="@(si == 0)" @onclick="() => MoveSection(si, -1)" title="Move up">↑</button>
                            <button class="btn btn-ghost btn-sm" disabled="@(si == _def.Sections.Count - 1)" @onclick="() => MoveSection(si, 1)" title="Move down">↓</button>
                            <button class="btn btn-ghost btn-sm text-rose-700" @onclick="() => RemoveSection(si)" title="Remove the section">✕</button>
                        </div>

                        @if (section.Layout == "fields")
                        {
                            @for (var f = 0; f < (section.Fields ?? []).Count; f++)
                            {
                                var fi = f;
                                var field = section.Fields![fi];
                                <div class="flex items-start gap-2">
                                    <div class="flex-1"><FormInputEditor Input="field" OnChanged="Touch" /></div>
                                    <div class="flex flex-col gap-1 pt-2">
                                        <button class="btn btn-ghost btn-sm" disabled="@(fi == 0)" @onclick="() => MoveField(section, fi, -1)" title="Move up">↑</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@(fi == section.Fields!.Count - 1)" @onclick="() => MoveField(section, fi, 1)" title="Move down">↓</button>
                                        <button class="btn btn-ghost btn-sm text-rose-700" @onclick="() => RemoveField(section, fi)" title="Remove">✕</button>
                                    </div>
                                </div>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="() => AddField(section)">+ Field</button>
                        }
                        else
                        {
                            <h4 class="text-xs font-bold uppercase tracking-wider text-muted">Columns</h4>
                            var columns = section.Columns ??= [];
                            <FormColumnList Columns="columns" OnChanged="Touch" />

                            <h4 class="mt-2 text-xs font-bold uppercase tracking-wider text-muted">Rows</h4>
                            var rows = section.Rows ??= new FormRows();
                            <div class="grid gap-2 md:grid-cols-4">
                                <label class="text-xs text-muted">Rows are
                                    <select class="select mt-1" @bind="rows.Mode" @bind:after="Touch">
                                        <option value="fixed">fixed, set here</option>
                                        <option value="free">added by the person</option>
                                        <option value="list">taken from the vessel's list</option>
                                    </select>
                                </label>
                                @if (rows.Mode == "list")
                                {
                                    <label class="text-xs text-muted">List
                                        <select class="select mt-1" @bind="rows.Source" @bind:after="Touch">
                                            <option value=""></option>
                                            @foreach (var source in FormDefinitionRules.RowSources) { <option value="@source">@source</option> }
                                        </select>
                                    </label>
                                }
                                @if (rows.Mode != "fixed")
                                {
                                    <label class="text-xs text-muted">Most rows <input type="number" class="input mt-1" @bind="rows.Max" @bind:after="Touch" placeholder="@FormDefinitionRules.DefaultFreeRows.ToString()" /></label>
                                }
                            </div>
                            @if (rows.Mode == "fixed")
                            {
                                var items = rows.Items ??= [];
                                @for (var r = 0; r < items.Count; r++)
                                {
                                    var ri = r;
                                    var row = items[ri];
                                    <div class="flex items-end gap-2">
                                        <label class="w-40 text-xs text-muted">Row id <input class="input mt-1" @bind="row.Id" @bind:after="Touch" /></label>
                                        <label class="flex-1 text-xs text-muted">Row label <input class="input mt-1" @bind="row.Label" @bind:after="Touch" /></label>
                                        <button class="btn btn-ghost btn-sm" disabled="@(ri == 0)" @onclick="() => MoveRow(items, ri, -1)">↑</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@(ri == items.Count - 1)" @onclick="() => MoveRow(items, ri, 1)">↓</button>
                                        <button class="btn btn-ghost btn-sm text-rose-700" @onclick="() => RemoveRow(items, ri)">✕</button>
                                    </div>
                                }
                                <button class="btn btn-secondary btn-sm" @onclick="() => AddRow(items)">+ Row</button>
                            }
                        }
                    </fieldset>
                }

                @if (_editable)
                {
                    <div class="flex gap-2">
                        <button class="btn btn-secondary" @onclick="AddFieldsSection">+ Section of fields</button>
                        <button class="btn btn-secondary" @onclick="AddGridSection">+ Grid</button>
                    </div>
                }
            }
            else if (_tab == "json")
            {
                <div class="card p-4 text-sm">
                    <p class="mb-2 text-xs text-muted">The same definition as text. Changes here are checked as you type; the design tab shows them once the text can be read.</p>
                    <textarea class="textarea font-mono text-xs" rows="30" spellcheck="false" readonly="@(!_editable)" @bind="_json" @bind:event="oninput" @bind:after="JsonTyped"></textarea>
                    @if (_jsonError is not null) { <p class="mt-2 text-xs text-rose-700">@_jsonError</p> }
                    @if (_editable) { <button class="btn btn-secondary btn-sm mt-2" @onclick="Format" disabled="@(_jsonError is not null)">Tidy the layout</button> }
                </div>
            }
            else
            {
                <div class="mb-2 flex items-center gap-2 text-sm">
                    <span class="text-xs text-muted">This is exactly what a vessel will see. Nothing typed here is kept.</span>
                    <button class="btn btn-ghost btn-sm ml-auto" @onclick="ResetPreview">Clear the answers</button>
                </div>
                @if (_jsonError is not null) { <EmptyState Title="Nothing to show yet" Message="Fix the JSON first." /> }
                else if (_problems.Any(p => p.Where == "" || p.Where.StartsWith("section ")) && _def.Sections.Count == 0) { <EmptyState Title="No sections yet" Message="Add a section on the design tab." /> }
                else
                {
                    <FormRenderer @key="_previewKey" Definition="_def" Values="_previewValues" ForSubmit="true" OnChanged="SetPreviewCheck" />
                }
            }
        </div>

        <div class="space-y-5">
            <div class="card p-4 text-sm">
                <h2 class="mb-2 font-display text-base font-extrabold text-ink">Checks</h2>
                @if (_jsonError is not null) { <p class="text-xs text-rose-700">@_jsonError</p> }
                else if (_problems.Count == 0) { <p class="text-xs text-emerald-700">Every rule is met, so this version can be published.</p> }
                else
                {
                    <ul class="space-y-1">
                        @foreach (var problem in _problems.Take(40))
                        {
                            <li class="text-xs text-rose-700">@if (problem.Where != "") { <b>@problem.Where</b><span>: </span> }@problem.Message</li>
                        }
                    </ul>
                    @if (_problems.Count > 40) { <p class="mt-1 text-xs text-muted">… and @(_problems.Count - 40) more.</p> }
                }
            </div>
            @if (_tab == "preview" && _previewCheck is { Exceptions.Count: > 0 } check)
            {
                <div class="card p-4 text-sm">
                    <h2 class="mb-2 font-display text-base font-extrabold text-ink">Exceptions with these answers</h2>
                    <ul class="space-y-1 text-xs">@foreach (var e in check.Exceptions) { <li>@e.Message</li> }</ul>
                </div>
            }
            <div class="card p-4 text-xs text-muted">
                <h2 class="mb-1 font-display text-base font-extrabold text-ink">Writing rules</h2>
                <p>Use field ids in rules: <code>draftAft - draftFwd</code>, <code>pressure &gt; 12 and condition = "Bad"</code>.</p>
                <p class="mt-1">Reach into a grid with <code>grid.row.column</code>; use <code>*</code> for all rows or columns: <code>sum(measured.*.b1.f)</code>.</p>
                <p class="mt-1">Functions: sum, count, any, min, max, round.</p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid VersionId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Key, string Label)[] Tabs = [("design", "Design"), ("json", "JSON"), ("preview", "Preview")];

    private Guid _companyId;
    private bool _loaded;
    private FormType? _type;
    private FormVersion? _version;
    private FormDef _def = new();
    private string _json = "", _note = "", _tab = "design";
    private string? _error, _notice, _jsonError;
    private List<FormProblem> _problems = [];
    private bool _dirty;
    private JsonObject _previewValues = [];
    private FormCheck? _previewCheck;
    private int _previewKey;

    private bool _editable => _version?.Status == FormVersionStatus.Draft;
    private string Subtitle => _version is null ? "" : $"Version {_version.Number} · {_version.Status.ToString().ToLowerInvariant()}";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        if (await Svc.GetVersionAsync(_companyId, VersionId) is { } found)
        {
            (_type, _version) = found;
            _note = _version.Note;
            var def = FormDef.TryRead(_version.Definition, out var error);
            if (def is null) { _json = _version.Definition; _jsonError = error; _tab = "json"; }
            else { _def = def; _json = _def.ToPrettyJson(); }
            Revalidate();
        }
        _loaded = true;
    }

    private void Revalidate() => _problems = _jsonError is null ? FormDefinitionRules.Validate(_def.Tidy()) : [];

    private void MarkDirty() => _dirty = true;

    /// <summary>A change on the design tab: tidy, write the JSON again, check.</summary>
    private void Touch()
    {
        _def.Tidy();
        _json = _def.ToPrettyJson();
        _jsonError = null;
        _dirty = true;
        Revalidate();
        _previewKey++;
    }

    private void JsonTyped()
    {
        _dirty = true;
        var def = FormDef.TryRead(_json, out var error);
        if (def is null) { _jsonError = error; _problems = []; return; }
        (_def, _jsonError) = (def, null);
        Revalidate();
        _previewKey++;
    }

    private void Format()
    {
        _json = _def.ToPrettyJson();
    }

    private void SetPreviewCheck(FormCheck check) => _previewCheck = check;

    private void ResetPreview()
    {
        _previewValues = [];
        _previewKey++;
    }

    // ---- editing the design ----

    private string FreeId(IEnumerable<string> taken, string stem)
    {
        var set = taken.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var n = 1;
        while (set.Contains(stem + n)) n++;
        return stem + n;
    }

    private IEnumerable<string> AllIds => _def.Sections.Select(s => s.Id).Concat(_def.Sections.SelectMany(s => s.Fields ?? []).Select(f => f.Id));

    private void AddFieldsSection()
    {
        _def.Sections.Add(new FormSection { Id = FreeId(AllIds, "section"), Title = "New section", Layout = "fields", Fields = [new FormField { Id = FreeId(AllIds.Append("section" + (_def.Sections.Count + 1)), "field"), Label = "New field", Type = FormFieldTypes.Text }] });
        Touch();
    }

    private void AddGridSection()
    {
        _def.Sections.Add(new FormSection
        {
            Id = FreeId(AllIds, "grid"), Title = "New grid", Layout = "grid",
            Columns = [new FormColumn { Id = "value", Label = "Value", Type = FormFieldTypes.Number }],
            Rows = new FormRows { Mode = "fixed", Items = [new FormRow { Id = "row1", Label = "Row 1" }] },
        });
        Touch();
    }

    private void MoveSection(int index, int by)
    {
        (_def.Sections[index], _def.Sections[index + by]) = (_def.Sections[index + by], _def.Sections[index]);
        Touch();
    }

    private void RemoveSection(int index)
    {
        _def.Sections.RemoveAt(index);
        Touch();
    }

    private void AddField(FormSection section)
    {
        (section.Fields ??= []).Add(new FormField { Id = FreeId(AllIds, "field"), Label = "New field", Type = FormFieldTypes.Text });
        Touch();
    }

    private void MoveField(FormSection section, int index, int by)
    {
        var fields = section.Fields!;
        (fields[index], fields[index + by]) = (fields[index + by], fields[index]);
        Touch();
    }

    private void RemoveField(FormSection section, int index)
    {
        section.Fields!.RemoveAt(index);
        Touch();
    }

    private void AddRow(List<FormRow> items)
    {
        items.Add(new FormRow { Id = FreeId(items.Select(r => r.Id), "row"), Label = "New row" });
        Touch();
    }

    private void MoveRow(List<FormRow> items, int index, int by)
    {
        (items[index], items[index + by]) = (items[index + by], items[index]);
        Touch();
    }

    private void RemoveRow(List<FormRow> items, int index)
    {
        items.RemoveAt(index);
        Touch();
    }

    // ---- saving ----

    private async Task<bool> SaveCoreAsync()
    {
        _error = _notice = null;
        try
        {
            await Svc.SaveDraftAsync(_companyId, VersionId, _def.Tidy().ToJson(), _note);
            _dirty = false;
            return true;
        }
        catch (InvalidOperationException ex) { _error = ex.Message; return false; }
    }

    private async Task SaveAsync()
    {
        if (await SaveCoreAsync()) _notice = "Saved the draft.";
    }

    private async Task PublishAsync()
    {
        if (!await SaveCoreAsync()) return;
        try
        {
            await Svc.PublishAsync(_companyId, VersionId, Actor.From((await AuthStateTask!).User));
            Nav.NavigateTo($"/forms/types?type={_type!.Id}&published={_version!.Number}");
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task CopyAsync()
    {
        _error = null;
        try
        {
            var copy = await Svc.CopyAsync(_companyId, VersionId, Actor.From((await AuthStateTask!).User));
            Nav.NavigateTo($"/forms/builder/{copy.Id}");
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }
}
