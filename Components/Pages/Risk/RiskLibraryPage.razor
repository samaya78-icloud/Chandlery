@page "/company/risk-library"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject RiskLibraryService Svc

<PageTitle>Risk library · Chandlery</PageTitle>

<PageHeader Eyebrow="Admin" Title="Risk assessment library" Subtitle="The categories, risk matrix and templates every vessel works from. Vessels receive them read-only; assessments already made keep their own copy and scores." />

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else
{
    <div class="mb-5"><Tabs Items="_tabs" Active="@_tab" ActiveChanged="SetTab" /></div>
    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }
    @if (_notice is not null) { <div class="mb-4 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@_notice</div> }

    @if (_tab == "templates")
    {
        <div class="grid gap-6 lg:grid-cols-3">
            <div class="card p-3 text-sm">
                <button class="btn btn-primary btn-sm mb-2 w-full" @onclick="StartNewTemplate">+ New template</button>
                @if (_templates.Count == 0) { <p class="p-2 text-muted">No templates yet.</p> }
                @foreach (var t in _templates)
                {
                    <button class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left hover:bg-surface-2 @(_selected?.Template.Id == t.Template.Id ? "bg-accent-50" : "")" @onclick="() => SelectAsync(t.Template.Id)">
                        <span class="font-medium">@t.Template.Name</span>
                        @if (t.CategoryName != "") { <span class="chip chip-plain ml-auto" data-tone="neutral">@t.CategoryName</span> }
                        <span class="text-xs text-muted">v@(t.Template.Version)</span>
                        @if (!t.Template.IsActive) { <span class="chip" data-tone="neutral">off</span> }
                    </button>
                }
            </div>

            <div class="space-y-6 lg:col-span-2">
                @if (_detailsOpen)
                {
                    <div class="card p-5 text-sm">
                        <h2 class="mb-3 font-display text-lg font-extrabold text-ink">@(_selected is null ? "New template" : "Template details")</h2>
                        <div class="grid gap-3 md:grid-cols-3">
                            <label class="md:col-span-2">Name <input class="input mt-1" @bind="_tName" /></label>
                            <label>Category
                                <select class="select mt-1" @bind="_tCategory">
                                    <option value="">(none)</option>
                                    @foreach (var c in _categories.Where(c => c.IsActive || c.Id == _tCategory)) { <option value="@c.Id">@c.Name</option> }
                                </select>
                            </label>
                            <label class="md:col-span-3">Job or activity <textarea class="textarea mt-1" rows="2" @bind="_tJob"></textarea></label>
                            <label class="md:col-span-3">Contingency and recovery <textarea class="textarea mt-1" rows="2" @bind="_tContingency"></textarea></label>
                            <label class="flex items-center gap-2"><input type="checkbox" @bind="_tActive" /> In use (assessments can be started from it)</label>
                        </div>
                        <div class="mt-4 flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveTemplateAsync">Save</button>
                            <button class="btn btn-ghost" @onclick="() => _detailsOpen = false">Cancel</button>
                        </div>
                    </div>
                }

                @if (_selected is { } sel)
                {
                    <div class="card p-5 text-sm">
                        <div class="flex flex-wrap items-center gap-3">
                            <h2 class="font-display text-lg font-extrabold text-ink">@sel.Template.Name</h2>
                            <span class="text-xs text-muted">version @sel.Template.Version · @_draft.Count work activities · @_draft.Sum(a => a.Hazards.Count) hazards</span>
                            <span class="ml-auto flex gap-2">
                                <button class="btn btn-secondary btn-sm" @onclick="StartEditDetails">Details</button>
                                <button class="btn btn-secondary btn-sm" @onclick="AddActivity">+ Work activity</button>
                                <button class="btn btn-primary btn-sm" @onclick="SaveContentAsync">Save activities and hazards</button>
                            </span>
                        </div>
                        <p class="mt-1 text-xs text-muted">Saving raises the version. Scores can be left blank in a template; whoever uses it scores them. Bands shown here follow the company matrix.</p>

                        @foreach (var activity in _draft)
                        {
                            var act = activity;
                            <div class="mt-4 rounded-xl border border-line p-3">
                                <div class="flex items-center gap-2">
                                    <input class="input font-semibold" placeholder="Work activity" @bind="act.Title" />
                                    <button class="btn btn-ghost btn-sm" @onclick="() => AddHazard(act)">+ Hazard</button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => _draft.Remove(act)">Remove</button>
                                </div>
                                @foreach (var hz in act.Hazards)
                                {
                                    var h = hz;
                                    <div class="mt-3 rounded-lg bg-surface-2/60 p-3">
                                        <div class="grid gap-2 md:grid-cols-2">
                                            <label>Hazard <input class="input mt-1" @bind="h.Hazard" /></label>
                                            <label>Effect <input class="input mt-1" @bind="h.Effect" /></label>
                                            <label>Existing controls <textarea class="textarea mt-1" rows="2" @bind="h.Existing"></textarea></label>
                                            <label>Additional controls <textarea class="textarea mt-1" rows="2" @bind="h.Additional"></textarea></label>
                                        </div>
                                        <div class="mt-2 grid gap-2 md:grid-cols-2">
                                            <div>
                                                <div class="text-xs font-bold uppercase tracking-wider text-muted">Before controls</div>
                                                <div class="mt-1 flex items-center gap-2">
                                                    <select class="select" @bind="h.CB">@ScoreOptions(_matrix!.Consequence)</select>
                                                    <select class="select" @bind="h.PB">@ScoreOptions(_matrix!.Probability)</select>
                                                    @BandChip(h.CB, h.PB)
                                                </div>
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold uppercase tracking-wider text-muted">After controls</div>
                                                <div class="mt-1 flex items-center gap-2">
                                                    <select class="select" @bind="h.CA">@ScoreOptions(_matrix!.Consequence)</select>
                                                    <select class="select" @bind="h.PA">@ScoreOptions(_matrix!.Probability)</select>
                                                    @BandChip(h.CA, h.PA)
                                                </div>
                                            </div>
                                        </div>
                                        <label class="mt-2 block">Contingency and recovery <input class="input mt-1" @bind="h.Contingency" /></label>
                                        <button class="btn btn-ghost btn-sm mt-2" @onclick="() => act.Hazards.Remove(h)">Remove this hazard</button>
                                    </div>
                                }
                                @if (act.Hazards.Count == 0) { <p class="mt-2 text-xs text-muted">No hazards yet.</p> }
                            </div>
                        }
                        @if (_draft.Count == 0) { <p class="mt-4 text-muted">No work activities yet. Add one to begin.</p> }
                    </div>
                }
                else if (!_detailsOpen)
                {
                    <EmptyState Title="Pick a template" Message="Choose one on the left to see and change its activities and hazards." />
                }
            </div>
        </div>
    }
    else if (_tab == "categories")
    {
        <div class="grid gap-6 lg:grid-cols-3">
            <div class="card p-5 text-sm lg:col-span-2">
                <ul class="divide-y divide-line/60">
                    @foreach (var c in _categories)
                    {
                        <li class="flex items-center gap-3 py-2 @(c.IsActive ? "" : "opacity-50")">
                            <span class="chip chip-plain font-mono" data-tone="neutral">@c.Code</span>
                            <span class="font-medium">@c.Name</span>
                            @if (!c.IsActive) { <span class="chip" data-tone="neutral">off</span> }
                            <button class="btn btn-ghost btn-sm ml-auto" @onclick="() => EditCategory(c)">Edit</button>
                        </li>
                    }
                </ul>
            </div>
            <div class="card p-5 text-sm">
                <h2 class="mb-3 font-display text-base font-extrabold text-ink">@(_cEditing is null ? "New category" : "Edit category")</h2>
                <div class="space-y-3">
                    <label class="block">Name <input class="input mt-1" @bind="_cName" /></label>
                    <label class="block">Short code <input class="input mt-1 font-mono" maxlength="6" @bind="_cCode" /></label>
                    <label class="block">Order <input type="number" class="input mt-1" @bind="_cOrder" /></label>
                    <label class="flex items-center gap-2"><input type="checkbox" @bind="_cActive" /> In use</label>
                </div>
                <div class="mt-4 flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveCategoryAsync">@(_cEditing is null ? "Add" : "Save")</button>
                    @if (_cEditing is not null) { <button class="btn btn-ghost" @onclick="NewCategory">New instead</button> }
                </div>
            </div>
        </div>
    }
    else if (_tab == "signoff")
    {
        <div class="card max-w-2xl p-5 text-sm">
            <h2 class="mb-1 font-display text-base font-extrabold text-ink">Who signs</h2>
            <p class="mb-3 text-muted">Ashore, company admins and the users you name on the Team page sign assessments. Onboard, the crew you mark as risk reviewers on the Crew page do.</p>
            <label class="flex items-start gap-2">
                <input type="checkbox" class="mt-1" checked="@_byAnother" @onchange="e => SetByAnotherAsync(e.Value is true)" />
                <span>Someone other than the writer must sign. Applies only when another reviewer is available on that side, so a vessel with a single reviewer is not blocked.</span>
            </label>
            <h2 class="mb-1 mt-6 font-display text-base font-extrabold text-ink">Maintenance</h2>
            <label class="flex items-start gap-2">
                <input type="checkbox" class="mt-1" checked="@_criticalNeeds" @onchange="e => SetCriticalAsync(e.Value is true)" />
                <span>Putting off a critical maintenance job needs a signed risk assessment of the vessel to be named on the request. The request form shows the vessel's signed assessments to choose from, Critical equipment first.</span>
            </label>
        </div>
    }
    else if (_matrix is not null)
    {
        <div class="grid gap-6 lg:grid-cols-2">
            <div class="card p-5 text-sm">
                <h2 class="mb-1 font-display text-base font-extrabold text-ink">The matrix</h2>
                <p class="mb-3 text-xs text-muted">Consequence (down) by probability (across). Each square shows the factor and its band.</p>
                <table class="w-full border-separate border-spacing-1 text-center text-xs">
                    <thead>
                        <tr>
                            <th></th>
                            @for (var p = 1; p <= RiskMatrix.Levels; p++) { <th class="font-normal text-muted">@_pWords[p - 1]</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var c = RiskMatrix.Levels; c >= 1; c--)
                        {
                            <tr>
                                <th class="pr-2 text-right font-normal text-muted">@_cWords[c - 1]</th>
                                @for (var p = 1; p <= RiskMatrix.Levels; p++)
                                {
                                    var factor = RiskMatrix.Factor(c, p);
                                    var band = _matrix.Matrix.BandOf(factor);
                                    <td class="rounded-lg p-2"><span class="chip" data-tone="@_matrix.Matrix.ToneOf(band)" title="@band">@factor</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="space-y-6">
                <div class="card p-5 text-sm">
                    <h2 class="mb-3 font-display text-base font-extrabold text-ink">Wording</h2>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <div class="mb-1 text-xs font-bold uppercase tracking-wider text-muted">Consequence 1 to 5</div>
                            @for (var i = 0; i < RiskMatrix.Levels; i++) { var k = i; <input class="input mb-1" @bind="_cWords[k]" /> }
                        </div>
                        <div>
                            <div class="mb-1 text-xs font-bold uppercase tracking-wider text-muted">Probability 1 to 5</div>
                            @for (var i = 0; i < RiskMatrix.Levels; i++) { var k = i; <input class="input mb-1" @bind="_pWords[k]" /> }
                        </div>
                    </div>
                    <button class="btn btn-secondary btn-sm mt-2" @onclick="SaveLabelsAsync">Save the wording</button>
                </div>

                <div class="card p-5 text-sm">
                    <h2 class="mb-1 font-display text-base font-extrabold text-ink">Bands</h2>
                    <p class="mb-3 text-xs text-muted">Each band starts at a factor and runs up to the next one. The lowest must start at 1. Assessments already made keep the band they were scored with.</p>
                    @foreach (var band in _bands)
                    {
                        var b = band;
                        <div class="mb-2 flex items-center gap-2">
                            <input class="input" @bind="b.Name" />
                            <label class="flex items-center gap-1 text-muted">from <input type="number" class="input w-20" @bind="b.Min" /></label>
                            <button class="btn btn-ghost btn-sm" @onclick="() => _bands.Remove(b)">Remove</button>
                        </div>
                    }
                    <div class="mt-2 flex gap-2">
                        <button class="btn btn-ghost btn-sm" @onclick="() => _bands.Add(new BandDraft())">+ Band</button>
                        <button class="btn btn-secondary btn-sm" @onclick="SaveBandsAsync">Save the bands</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class HazardDraft
    {
        public Guid? Id { get; set; }
        public string Hazard { get; set; } = "";
        public string Effect { get; set; } = "";
        public string Existing { get; set; } = "";
        public string Additional { get; set; } = "";
        public string Contingency { get; set; } = "";
        public int CB { get; set; }
        public int PB { get; set; }
        public int CA { get; set; }
        public int PA { get; set; }
    }

    private sealed class ActivityDraft
    {
        public Guid? Id { get; set; }
        public string Title { get; set; } = "";
        public List<HazardDraft> Hazards { get; } = [];
    }

    private sealed class BandDraft
    {
        public string Name { get; set; } = "";
        public int Min { get; set; }
    }

    private Guid _companyId;
    private bool _loaded;
    private string? _error, _notice;
    private string _tab = "templates";
    private IReadOnlyList<(string Key, string Label, int? Count)> _tabs = [];

    private List<RaCategory> _categories = [];
    private List<RaTemplateRow> _templates = [];
    private RaTemplateView? _selected;
    private RaMatrixView? _matrix;
    private List<ActivityDraft> _draft = [];

    private bool _detailsOpen;
    private string _tName = "", _tJob = "", _tContingency = "";
    private Guid? _tCategory;
    private bool _tActive = true;

    private RaCategory? _cEditing;
    private string _cName = "", _cCode = "";
    private int _cOrder;
    private bool _cActive = true;

    private string[] _cWords = new string[RiskMatrix.Levels], _pWords = new string[RiskMatrix.Levels];
    private List<BandDraft> _bands = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        await LoadAsync();
        NewCategory();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _categories = await Svc.ListCategoriesAsync(_companyId);
        _templates = await Svc.ListTemplatesAsync(_companyId);
        _matrix = await Svc.GetMatrixAsync(_companyId);
        _cWords = [.. _matrix.Consequence];
        _pWords = [.. _matrix.Probability];
        _bands = _matrix.Bands.Select(b => new BandDraft { Name = b.Name, Min = b.MinFactor }).ToList();
        _byAnother = await Svc.GetSignOffByAnotherPersonAsync(_companyId);
        _criticalNeeds = await Svc.GetRequiredForCriticalDeferralAsync(_companyId);
        _tabs = [("templates", "Templates", _templates.Count), ("categories", "Categories", _categories.Count), ("matrix", "Risk matrix", null), ("signoff", "Sign-off", null)];
    }

    private bool _byAnother, _criticalNeeds;

    private async Task SetCriticalAsync(bool on)
    {
        _error = _notice = null;
        try { await Svc.SetRequiredForCriticalDeferralAsync(_companyId, on); _criticalNeeds = on; _notice = on ? "A critical job now needs a risk assessment to be put off." : "A critical job can be put off without one again."; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task SetByAnotherAsync(bool on)
    {
        _error = _notice = null;
        try { await Svc.SetSignOffByAnotherPersonAsync(_companyId, on); _byAnother = on; _notice = on ? "Someone other than the writer must now sign." : "The writer may sign their own assessment again."; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private void SetTab(string tab) { _tab = tab; _error = _notice = null; }

    private RenderFragment ScoreOptions(IReadOnlyList<string> words) => __builder =>
    {
        <option value="0">(not scored)</option>
        @for (var i = 0; i < words.Count; i++) { <option value="@(i + 1)">@(i + 1) · @words[i]</option> }
    };

    private RenderFragment BandChip(int consequence, int probability) => __builder =>
    {
        if (RiskMatrix.IsLevel(consequence) && RiskMatrix.IsLevel(probability))
        {
            var factor = RiskMatrix.Factor(consequence, probability);
            var band = _matrix!.Matrix.BandOf(factor);
            <span class="chip" data-tone="@_matrix.Matrix.ToneOf(band)">@band · @factor</span>
        }
    };

    // ---- templates ----

    private async Task SelectAsync(Guid id)
    {
        _error = _notice = null; _detailsOpen = false;
        _selected = await Svc.GetTemplateAsync(_companyId, id);
        _draft = _selected is null ? [] : DraftOf(_selected);
    }

    private static List<ActivityDraft> DraftOf(RaTemplateView view)
    {
        var drafts = new List<ActivityDraft>();
        foreach (var a in view.Activities)
        {
            var d = new ActivityDraft { Id = a.Id, Title = a.Title };
            foreach (var h in view.Hazards.Where(h => h.ActivityId == a.Id))
                d.Hazards.Add(new HazardDraft { Id = h.Id, Hazard = h.Hazard, Effect = h.Effect, Existing = h.ExistingControls, Additional = h.AdditionalControls, Contingency = h.Contingency,
                    CB = h.ConsequenceBefore, PB = h.ProbabilityBefore, CA = h.ConsequenceAfter, PA = h.ProbabilityAfter });
            drafts.Add(d);
        }
        return drafts;
    }

    private void StartNewTemplate()
    {
        _error = _notice = null; _selected = null; _draft = []; _detailsOpen = true;
        (_tName, _tCategory, _tJob, _tContingency, _tActive) = ("", null, "", "", true);
    }

    private void StartEditDetails()
    {
        if (_selected is null) return;
        _error = _notice = null; _detailsOpen = true;
        var t = _selected.Template;
        (_tName, _tCategory, _tJob, _tContingency, _tActive) = (t.Name, t.CategoryId, t.JobDescription, t.Contingency, t.IsActive);
    }

    private async Task SaveTemplateAsync()
    {
        _error = _notice = null;
        try
        {
            var saved = await Svc.SaveTemplateAsync(_companyId, _selected?.Template.Id, _tName, _tCategory, _tJob, _tContingency, _tActive);
            _detailsOpen = false;
            await LoadAsync();
            await SelectAsync(saved.Id);
            _notice = "Saved the template.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private void AddActivity() => _draft.Add(new ActivityDraft());

    private static void AddHazard(ActivityDraft activity) => activity.Hazards.Add(new HazardDraft());

    private async Task SaveContentAsync()
    {
        _error = _notice = null;
        if (_selected is null) return;
        try
        {
            var input = _draft.Select(a => new RaTemplateActivityInput(a.Id, a.Title, a.Hazards.Select(h =>
                new RaTemplateHazardInput(h.Id, h.Hazard, h.Effect, h.Existing, h.Additional, h.CB, h.PB, h.CA, h.PA, h.Contingency)).ToList())).ToList();
            await Svc.SaveTemplateContentAsync(_companyId, _selected.Template.Id, input);
            await LoadAsync();
            await SelectAsync(_selected.Template.Id);
            _notice = "Saved the activities and hazards.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    // ---- categories ----

    private void NewCategory()
    {
        _cEditing = null;
        (_cName, _cCode, _cActive) = ("", "", true);
        _cOrder = (_categories.Select(c => c.SortOrder).DefaultIfEmpty(-1).Max()) + 1;
    }

    private void EditCategory(RaCategory c)
    {
        _error = _notice = null; _cEditing = c;
        (_cName, _cCode, _cOrder, _cActive) = (c.Name, c.Code, c.SortOrder, c.IsActive);
    }

    private async Task SaveCategoryAsync()
    {
        _error = _notice = null;
        try
        {
            await Svc.SaveCategoryAsync(_companyId, _cEditing?.Id, _cName, _cCode, _cOrder, _cActive);
            await LoadAsync();
            NewCategory();
            _notice = "Saved the category.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    // ---- matrix ----

    private async Task SaveLabelsAsync()
    {
        _error = _notice = null;
        try { await Svc.SaveLabelsAsync(_companyId, _cWords, _pWords); await LoadAsync(); _notice = "Saved the wording."; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task SaveBandsAsync()
    {
        _error = _notice = null;
        try { await Svc.SaveBandsAsync(_companyId, _bands.Select(b => new RaBandInput(b.Name, b.Min)).ToList()); await LoadAsync(); _notice = "Saved the bands."; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }
}
