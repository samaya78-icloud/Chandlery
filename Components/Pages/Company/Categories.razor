@page "/company/categories"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject ToastService Toasts

<PageTitle>Categories · Chandlery</PageTitle>

<PageHeader Eyebrow="Master data" Title="Item Categories"
            Subtitle="Your company's own classification tree. Link categories to departments so each department can only pick the items it should. A category with items or sub-categories can be disabled instead of deleted.">
    <Actions>
        <button @onclick="OpenAdd" class="btn btn-primary">+ Add Category</button>
    </Actions>
</PageHeader>

@if (_form != FormMode.None)
{
    <div class="mb-6 max-w-md card p-4">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">@(_form == FormMode.Add ? "New category" : "Edit category")</h2>
        <div class="mb-3">
            <label class="label">Name</label>
            <input @bind="_name" maxlength="80" class="input" />
        </div>
        <div class="mb-4">
            <label class="label">Parent category</label>
            <select @bind="_parentId" class="select">
                <option value="0">None (top-level)</option>
                @foreach (var (category, path, _) in ParentChoices)
                {
                    <option value="@category.Id">@path</option>
                }
            </select>
        </div>
        @if (_error is not null)
        {
            <div class="mb-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
        }
        <div class="flex gap-3">
            <button @onclick="Save" class="btn btn-primary">Save</button>
            <button @onclick="CloseForm" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
}

@if (!_loaded)
{
    <Skeleton Rows="5" />
}
else if (_tree.Count == 0)
{
    <EmptyState Title="No categories yet" Message="Add your first category to start classifying items." />
}
else
{
    <div class="card">
        <ul class="divide-y divide-line">
            @foreach (var (category, _, depth) in _tree)
            {
                var c = category;
                var usage = _usage.GetValueOrDefault(c.Id);
                var empty = usage.Items == 0 && usage.Children == 0;
                <li class="flex flex-wrap items-center gap-2 px-4 py-2.5 text-sm" style="padding-left: @(16 + depth * 24)px">
                    @if (depth > 0) { <span class="text-slate-300">&#8627;</span> }
                    <span class="@((depth == 0 ? "font-semibold text-ink" : "text-ink-2") + (c.IsActive ? "" : " line-through opacity-60"))">@c.Name</span>
                    @if (!c.IsActive) { <span class="chip chip-plain" data-tone="neutral">Disabled</span> }
                    @if (usage.Items > 0) { <span class="text-xs text-muted">@usage.Items item(s)</span> }
                    <span class="ml-auto flex items-center gap-3">
                        <button @onclick="() => OpenEdit(c)" class="text-xs font-medium text-accent-600 hover:text-accent-700">Edit</button>
                        <button @onclick="() => Toggle(c)" class="text-xs font-medium text-amber-600 hover:text-amber-700">@(c.IsActive ? "Disable" : "Enable")</button>
                        @if (empty)
                        {
                            <button @onclick="() => Delete(c)" class="text-xs font-medium text-rose-600 hover:text-rose-700">Delete</button>
                        }
                    </span>
                </li>
            }
        </ul>
    </div>
    <p class="mt-3 text-xs text-muted">Delete appears only for a category with no items and no sub-categories. Disabling a category also hides everything beneath it from new requisitions and orders; existing documents are not changed.</p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum FormMode { None, Add, Edit }

    private int _companyId;
    private bool _loaded;
    private List<Category> _categories = new();
    private List<(Category Category, string Path, int Depth)> _tree = new();
    private Dictionary<int, (int Items, int Children)> _usage = new();
    private FormMode _form;
    private int _editingId;
    private string _name = "";
    private int _parentId;
    private string? _error;

    /// <summary>Parents offered in the form: enabled categories, and when editing, never the category itself or anything beneath it.</summary>
    private IEnumerable<(Category Category, string Path, int Depth)> ParentChoices
    {
        get
        {
            var blocked = _form == FormMode.Edit ? CategoryIds.Descendants(_categories, _editingId) : new HashSet<int>();
            var active = Category.ActiveIds(_categories);
            return _tree.Where(t => !blocked.Contains(t.Category.Id) && (active.Contains(t.Category.Id) || t.Category.Id == _parentId));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _categories = await Procurement.GetCategoriesAsync(_companyId);
        _tree = Category.BuildTree(_categories);
        _usage = await Procurement.GetCategoryUsageAsync(_companyId);
    }

    private void OpenAdd()
    {
        _form = FormMode.Add;
        _name = "";
        _parentId = 0;
        _error = null;
    }

    private void OpenEdit(Category category)
    {
        _form = FormMode.Edit;
        _editingId = category.Id;
        _name = category.Name;
        _parentId = category.ParentCategoryId ?? 0;
        _error = null;
    }

    private void CloseForm() => _form = FormMode.None;

    private async Task Save()
    {
        _error = null;
        try
        {
            var parent = _parentId == 0 ? (int?)null : _parentId;
            if (_form == FormMode.Add) await Procurement.AddCategoryAsync(_companyId, _name, parent);
            else await Procurement.UpdateCategoryAsync(_companyId, _editingId, _name, parent);
            await Load();
            _form = FormMode.None;
            await Toasts.Success("Category saved");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Toggle(Category category)
    {
        try
        {
            await Procurement.SetCategoryActiveAsync(_companyId, category.Id, !category.IsActive);
            await Load();
            await Toasts.Success(category.IsActive ? $"{category.Name} disabled" : $"{category.Name} enabled");
        }
        catch (InvalidOperationException ex)
        {
            await Toasts.Error(ex.Message);
        }
    }

    private async Task Delete(Category category)
    {
        try
        {
            await Procurement.DeleteCategoryAsync(_companyId, category.Id);
            await Load();
            await Toasts.Success($"{category.Name} deleted");
        }
        catch (InvalidOperationException ex)
        {
            await Toasts.Error(ex.Message);
        }
    }
}
