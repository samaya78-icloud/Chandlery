@page "/company/categories"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement

<PageTitle>Categories · Chandlery</PageTitle>

<PageHeader Eyebrow="Master data" Title="Item Categories" Subtitle="Shared classification tree, visible to every company on Chandlery.">
    <Actions>
        <button @onclick="() => _showForm = !_showForm" class="btn btn-primary">+ Add Category</button>
    </Actions>
</PageHeader>

@if (_showForm)
{
    <div class="mb-6 max-w-md card p-4">
        <div class="mb-3">
            <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
            <input @bind="_name" class="input" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Parent Category</label>
            <select @bind="_parentId" class="input">
                <option value="0">None (top-level)</option>
                @foreach (var (category, path, _) in _tree)
                {
                    <option value="@category.Id">@path</option>
                }
            </select>
        </div>
        <button @onclick="Add" class="btn btn-primary">Save</button>
    </div>
}

<div class="card">
    <ul class="divide-y divide-slate-50">
        @foreach (var (category, _, depth) in _tree)
        {
            <li class="flex items-center gap-2 px-4 py-2.5 text-sm" style="padding-left: @(16 + depth * 24)px">
                @if (depth > 0)
                {
                    <span class="text-slate-300">&#8627;</span>
                }
                <span class="@(depth == 0 ? "font-semibold text-slate-800" : "text-slate-600")">@category.Name</span>
            </li>
        }
    </ul>
</div>

@code {
    private List<Category> _categories = new();
    private List<(Category Category, string Path, int Depth)> _tree = new();
    private bool _showForm;
    private string _name = "";
    private int _parentId;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _categories = await Procurement.GetCategoriesAsync();
        _tree = Category.BuildTree(_categories);
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        await Procurement.AddCategoryAsync(_name, _parentId == 0 ? null : _parentId);
        await Load();
        _name = "";
        _parentId = 0;
        _showForm = false;
    }
}
