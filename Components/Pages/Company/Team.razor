@page "/company/team"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject VesselGroupService Groups
@inject RiskLibraryService RiskLibrary
@inject ProjectService ProjectSvc

<PageTitle>Team · Chandlery</PageTitle>

<PageHeader Eyebrow="Admin" Title="Team" Subtitle="@($"{_users.Count:N0} users in your company.")">
    <Actions>
        <button @onclick="() => _showForm = !_showForm" class="btn btn-primary">+ Add User</button>
    </Actions>
</PageHeader>

@if (_showForm)
{
    <div class="mb-6 max-w-md card p-4">
        <div class="mb-3">
            <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
            <input @bind="_name" class="input" />
        </div>
        <div class="mb-3">
            <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>
            <input @bind="_email" type="email" class="input" />
        </div>
        <div class="mb-3">
            <label class="mb-1 block text-sm font-medium text-slate-700">Role</label>
            <SelectBox TValue="UserRole" @bind-Value="_role" Options="_roleOptions" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Temporary Password</label>
            <input @bind="_password" type="text" placeholder="Share this with the user directly"
                   class="input" />
            <p class="mt-1 text-xs text-slate-400">No email invites yet — share this password with them yourself.</p>
        </div>

        @if (_error is not null)
        {
            <div class="mb-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
        }

        <button @onclick="Add" class="btn btn-primary">Save</button>
    </div>
}

<div class="card">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                <th class="px-4 py-3 font-medium">Name</th>
                <th class="px-4 py-3 font-medium">Email</th>
                <th class="px-4 py-3 font-medium">Role</th>
                <th class="px-4 py-3 font-medium">Vessel groups</th>
                <th class="px-4 py-3 font-medium">Risk reviewer</th>
                <th class="px-4 py-3 font-medium">Project manager</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in _users)
            {
                <tr class="border-b border-slate-50 last:border-0 hover:bg-slate-50">
                    <td class="px-4 py-3 font-medium text-slate-800">@u.DisplayName</td>
                    <td class="px-4 py-3 text-slate-600">@u.Email</td>
                    <td class="px-4 py-3">
                        <span class="@(u.Role == UserRole.CompanyAdmin ? "bg-indigo-50 text-indigo-600" : "bg-slate-100 text-slate-500") rounded-full px-2.5 py-1 text-xs font-medium">
                            @(u.Role == UserRole.CompanyAdmin ? "Admin" : "User")
                        </span>
                    </td>
                    <td class="px-4 py-3 text-slate-600">
                        @if (_scopeUserId == u.Id)
                        {
                            <div class="max-w-xs">
                                <SelectBox TValue="Guid" Multiple="true" Values="_scopeValues" Options="_groupOptions" Placeholder="All vessels" SearchPlaceholder="Search groups…" />
                                <div class="mt-2 flex gap-2">
                                    <button @onclick="SaveScope" class="btn btn-primary btn-sm">Save</button>
                                    <button @onclick="() => _scopeUserId = null" class="btn btn-secondary btn-sm">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span>@ScopeText(u)</span>
                            <button @onclick="() => EditScope(u)" class="ml-2 text-xs font-medium text-indigo-600 hover:underline">Edit</button>
                        }
                    </td>
                    <td class="px-4 py-3 text-slate-600">
                        @if (u.Role == UserRole.CompanyAdmin) { <span class="text-xs text-slate-400">always (admin)</span> }
                        else { <label class="flex items-center gap-2 text-xs"><input type="checkbox" checked="@u.IsRiskReviewer" @onchange="e => SetReviewerAsync(u, e.Value is true)" /> signs risk assessments</label> }
                    </td>
                    <td class="px-4 py-3 text-slate-600">
                        @if (u.Role == UserRole.CompanyAdmin) { <span class="text-xs text-slate-400">always (admin)</span> }
                        else { <label class="flex items-center gap-2 text-xs"><input type="checkbox" checked="@u.IsProjectManager" @onchange="e => SetProjectManagerAsync(u, e.Value is true)" /> plans and runs projects</label> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private List<AppUser> _users = new();
    private bool _showForm;
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private UserRole _role = UserRole.CompanyUser;
    private readonly List<SelectOption<UserRole>> _roleOptions = new()
    {
        new(UserRole.CompanyUser, "Company User", "Can raise requisitions and orders"),
        new(UserRole.CompanyAdmin, "Company Admin", "Also manages the team, approval matrix and finalizes invoices")
    };
    private string? _error;
    private Dictionary<Guid, HashSet<Guid>> _scopes = new();
    private List<SelectOption<Guid>> _groupOptions = new();
    private Dictionary<Guid, string> _groupNames = new();
    private Guid? _scopeUserId;
    private HashSet<Guid> _scopeValues = new();
    private Actor _actor = Actor.System;

    private async Task SetReviewerAsync(AppUser user, bool on)
    {
        _error = null;
        try { await RiskLibrary.SetRiskReviewerAsync(_companyId, user.Id, on); user.IsRiskReviewer = on; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task SetProjectManagerAsync(AppUser user, bool on)
    {
        _error = null;
        try { await ProjectSvc.SetProjectManagerAsync(_companyId, user.Id, on); user.IsProjectManager = on; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = Guid.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);
        _users = (await Procurement.GetCompanyUsersAsync(_companyId)).OrderByDescending(u => u.CreatedAt).ThenByDescending(u => u.Id).ToList();
        var tree = VesselGroup.BuildTree(await Groups.GetGroupsAsync(_companyId));
        _groupOptions = tree.Select(t => new SelectOption<Guid>(t.Group.Id, t.Path)).ToList();
        _groupNames = tree.ToDictionary(t => t.Group.Id, t => t.Path);
        _scopes = await Groups.GetAllUserScopesAsync(_companyId);
    }

    private string ScopeText(AppUser user) =>
        _scopes.TryGetValue(user.Id, out var ids) && ids.Count > 0 ? string.Join(", ", ids.Select(id => _groupNames.GetValueOrDefault(id, "?"))) : "All vessels";

    private void EditScope(AppUser user)
    {
        _scopeUserId = user.Id;
        _scopeValues = _scopes.TryGetValue(user.Id, out var ids) ? new HashSet<Guid>(ids) : new HashSet<Guid>();
    }

    private async Task SaveScope()
    {
        if (_scopeUserId is null) return;
        try
        {
            await Groups.SetUserScopeAsync(_companyId, _scopeUserId.Value, _scopeValues, _actor);
            _error = null;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }
        _scopes = await Groups.GetAllUserScopesAsync(_companyId);
        _scopeUserId = null;
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "All fields are required.";
            return;
        }

        try
        {
            await Procurement.AddCompanyUserAsync(_companyId, _email, _name, _password, _role);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }

        _users = (await Procurement.GetCompanyUsersAsync(_companyId)).OrderByDescending(u => u.CreatedAt).ThenByDescending(u => u.Id).ToList();
        _name = "";
        _email = "";
        _password = "";
        _role = UserRole.CompanyUser;
        _error = null;
        _showForm = false;
    }
}
