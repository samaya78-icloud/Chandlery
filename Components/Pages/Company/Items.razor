@page "/company/items"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject ToastService Toasts

<PageTitle>Items Catalog · Chandlery</PageTitle>

<PageHeader Eyebrow="Master data" Title="Items Catalog" Subtitle="@($"{_count:N0} items in your catalog — the single list every requisition and order draws from, within each department's categories.")">
    <Actions>
        <a href="/company/items/import" class="btn btn-secondary">Import CSV</a>
        <button @onclick="OpenAdd" class="btn btn-primary">+ Add Item</button>
    </Actions>
</PageHeader>

@if (_editingId != -1)
{
    <div class="mb-6 max-w-md card p-4">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">@(_editingId == 0 ? "New item" : "Edit item")</h2>
        <div class="mb-3">
            <label class="label">Code</label>
            <input @bind="_code" class="input" />
        </div>
        <div class="mb-3">
            <label class="label">Name</label>
            <input @bind="_name" class="input" />
        </div>
        <div class="mb-3">
            <label class="label">Category</label>
            @if (_formTree.Count == 0)
            {
                <p class="text-xs text-muted">No enabled categories yet — add one on the Categories page first.</p>
            }
            else
            {
                <select @bind="_categoryId" class="select">
                    <option value="0">Select category...</option>
                    @foreach (var (category, path, _) in _formTree)
                    {
                        <option value="@category.Id">@path</option>
                    }
                </select>
            }
        </div>
        <div class="mb-4">
            <label class="label">Unit of Measure</label>
            <input @bind="_uom" placeholder="e.g. Pcs, Drum, Litre" class="input" />
        </div>

        @if (_error is not null)
        {
            <div class="mb-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
        }

        <div class="flex gap-3">
            <button @onclick="Save" class="btn btn-primary">Save</button>
            <button @onclick="() => _editingId = -1" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
}

<div class="mb-4 flex flex-wrap items-center gap-3">
    <select @bind="_filterCategoryId" @bind:after="CategoryChanged" class="select max-w-md">
        <option value="0">All categories</option>
        @foreach (var (category, path, _) in _tree)
        {
            <option value="@category.Id">@path@(category.IsActive ? "" : " (disabled)")</option>
        }
    </select>
    <span class="text-sm text-muted">Includes sub-categories</span>
</div>

@if (_companyId != 0)
{
    <DataGrid @ref="_grid" TItem="Item" ItemsProvider="LoadPage" ItemName="items" ExportName="items" PageSize="25" EmptyText="No items match these filters.">
        <GridColumn Title="Code" Key="code" Text="i => i.Code" Context="item">
            <DocLink Kind="DocKind.Item" Id="item.Id" Text="@item.Code" />
        </GridColumn>
        <GridColumn Title="Name" Key="name" Text="i => i.Name" CellClass="text-ink" />
        <GridColumn Title="Category" Key="category" Text="i => CategoryPath(i.CategoryId)" Sortable="false" CellClass="text-muted" />
        <GridColumn Title="UOM" Key="uom" Text="i => i.UnitOfMeasure" Filter="GridFilter.Select" OptionsLoader="LoadUomOptions" />
        <GridColumn Title="Status" Key="status" Text="i => StatusText(i)" Filter="GridFilter.Select" Chips="true" Options="StatusOptions" Context="item">
            <span class="chip" data-tone="@(item.IsActive ? "success" : "neutral")">@StatusText(item)</span>
        </GridColumn>
        <GridColumn Title="" Filter="GridFilter.None" CellClass="whitespace-nowrap text-right" Context="item">
            <button @onclick="() => OpenEdit(item)" class="text-xs font-medium text-accent-600 hover:text-accent-700">Edit</button>
            <button @onclick="() => Toggle(item)" class="ml-3 text-xs font-medium text-amber-600 hover:text-amber-700">@(item.IsActive ? "Disable" : "Enable")</button>
            @if (!_used.Contains(item.Id))
            {
                <button @onclick="() => Delete(item)" class="ml-3 text-xs font-medium text-rose-600 hover:text-rose-700">Delete</button>
            }
        </GridColumn>
    </DataGrid>
    <p class="mt-3 text-xs text-muted">Delete appears only for items that are on no requisition, RFQ, purchase order or delivery. Otherwise disable the item: it stays on old documents but cannot be added to new ones.</p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StatusOptions = { "Active", "Disabled" };

    private DataGrid<Item>? _grid;
    private int _companyId;
    private int _count;
    private List<Category> _categories = new();
    private List<(Category Category, string Path, int Depth)> _tree = new();
    private List<(Category Category, string Path, int Depth)> _formTree = new();
    private Dictionary<int, string> _pathById = new();
    private HashSet<int> _used = new();

    /// <summary>-1 = form closed, 0 = adding, otherwise the id of the item being edited.</summary>
    private int _editingId = -1;
    private string _code = "";
    private string _name = "";
    private string _uom = "";
    private int _categoryId;
    private string? _error;

    private int _filterCategoryId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _companyId = companyId;

        await LoadCategories();
        _count = await Procurement.GetItemCountAsync(companyId);
    }

    private async Task LoadCategories()
    {
        _categories = await Procurement.GetCategoriesAsync(_companyId);
        _tree = Category.BuildTree(_categories);
        _pathById = _tree.ToDictionary(t => t.Category.Id, t => t.Path);
    }

    private static string StatusText(Item item) => item.IsActive ? "Active" : "Disabled";

    private string CategoryPath(int categoryId) => _pathById.GetValueOrDefault(categoryId, "—");

    private async Task<IEnumerable<string>> LoadUomOptions() => await Procurement.GetItemUomOptionsAsync(_companyId);

    /// <summary>
    /// The category dropdown (with its sub-categories) and the Category column's text filter both narrow the
    /// item query to a set of category ids, because the category path is built from the tree, not stored on the item.
    /// </summary>
    private async Task<GridResult<Item>> LoadPage(GridRequest request)
    {
        HashSet<int>? allowed = _filterCategoryId == 0 ? null : CategoryIds.Descendants(_categories, _filterCategoryId);

        var term = request.Text("category");
        if (term != "")
        {
            var matching = _tree.Where(t => t.Path.Contains(term, StringComparison.OrdinalIgnoreCase))
                .Select(t => t.Category.Id).ToHashSet();
            if (allowed is not null) matching.IntersectWith(allowed);
            allowed = matching;
        }

        var result = await Procurement.GetItemPageAsync(_companyId, request, allowed);
        _used = await Procurement.GetUsedItemIdsAsync(_companyId, result.Rows.Select(i => i.Id).ToList());
        return result;
    }

    private Task CategoryChanged() => _grid is null ? Task.CompletedTask : _grid.ReloadAsync(resetPage: true);

    private void OpenAdd()
    {
        _editingId = 0;
        _code = _name = _uom = "";
        _categoryId = 0;
        _error = null;
        _formTree = FormChoices(0);
    }

    private void OpenEdit(Item item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _uom = item.UnitOfMeasure;
        _categoryId = item.CategoryId;
        _error = null;
        _formTree = FormChoices(item.CategoryId);
    }

    /// <summary>Enabled categories, plus the item's current one so editing a disabled-category item still shows where it sits.</summary>
    private List<(Category Category, string Path, int Depth)> FormChoices(int currentCategoryId)
    {
        var active = Category.ActiveIds(_categories);
        return _tree.Where(t => active.Contains(t.Category.Id) || t.Category.Id == currentCategoryId).ToList();
    }

    private async Task Save()
    {
        _error = null;
        try
        {
            if (_editingId == 0) await Procurement.AddItemAsync(_companyId, _code, _name, _categoryId, _uom);
            else await Procurement.UpdateItemAsync(_companyId, _editingId, _code, _name, _categoryId, _uom);
            _count = await Procurement.GetItemCountAsync(_companyId);
            _editingId = -1;
            if (_grid is not null) await _grid.ReloadAsync();
            await Toasts.Success("Item saved");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Toggle(Item item)
    {
        try
        {
            var enable = !item.IsActive;
            await Procurement.SetItemActiveAsync(_companyId, item.Id, enable);
            if (_grid is not null) await _grid.ReloadAsync();
            await Toasts.Success(enable ? $"{item.Code} enabled" : $"{item.Code} disabled");
        }
        catch (InvalidOperationException ex)
        {
            await Toasts.Error(ex.Message);
        }
    }

    private async Task Delete(Item item)
    {
        try
        {
            await Procurement.DeleteItemAsync(_companyId, item.Id);
            _count = await Procurement.GetItemCountAsync(_companyId);
            if (_grid is not null) await _grid.ReloadAsync();
            await Toasts.Success($"{item.Code} deleted");
        }
        catch (InvalidOperationException ex)
        {
            await Toasts.Error(ex.Message);
        }
    }
}
