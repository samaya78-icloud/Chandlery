@page "/company/requisitions/new"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject RequisitionService Requisitions
@inject NavigationManager Navigation
@inject WorklistService Worklist
@inject PmsIntegrationService PmsLinks

<PageTitle>New Requisition · Chandlery</PageTitle>

<PageHeader Eyebrow="Procurement" Title="New Requisition" Subtitle="Enter what the vessel needs once. You choose the suppliers and send the RFQ from the requisition afterwards." />

@if (_companyId != Guid.Empty)
{
<div class="max-w-5xl space-y-6">

    @if (_spareHint.Count > 0)
    {
        <div class="rounded-xl border border-sky-300/60 bg-sky-50/70 px-4 py-3 text-sm text-sky-900 dark:bg-sky-500/10 dark:text-sky-100">
            <p class="font-medium">Spares kept for this job's machinery</p>
            <p class="mt-0.5 text-xs">The job has no department, so choose one below, then add these from the catalog:</p>
            <ul class="mt-1 list-disc pl-5 text-xs">@foreach (var line in _spareHint) { <li>@line</li> }</ul>
        </div>
    }

    <div class="card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-400">Requisition details</h2>

        <div class="mb-5 flex gap-6">
            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="reqn-type" checked="@(_reqn.Type == RfqType.Stores)" @onchange="() => _reqn.Type = RfqType.Stores" /> Stores
            </label>
            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="reqn-type" checked="@(_reqn.Type == RfqType.Spares)" @onchange="() => _reqn.Type = RfqType.Spares" /> Spares
            </label>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Vessel <span class="text-rose-500">*</span></label>
                <SelectBox TValue="Guid" @bind-Value="_reqn.VesselId" Options="_vesselOptions" Placeholder="Select vessel…" />
                @if (_vessels.Count == 0)
                {
                    <p class="mt-1 text-xs text-slate-400">No vessels yet &mdash; <a href="/company/vessels" class="text-indigo-600 underline">add one</a> first.</p>
                }
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Department @if (_departments.Count > 0) { <span class="text-rose-500">*</span> }</label>
                <SelectBox TValue="Guid" @bind-Value="_departmentId" Options="_departmentOptions" Placeholder="@(_departments.Count > 0 ? "Select department…" : "Not specified")" />
                @if (_departments.Count > 0)
                {
                    <p class="mt-1 text-xs text-slate-400">The department decides which categories and items you can add.</p>
                }
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Urgency</label>
                <SelectBox TValue="Urgency" @bind-Value="_reqn.Urgency" Options="_urgencyOptions" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Delivery port <span class="text-rose-500">*</span></label>
                <SelectBox TValue="Guid" @bind-Value="_portId" Options="_portOptions" Placeholder="Select port…" SearchPlaceholder="Search ports…" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Requisition date</label>
                <input type="date" @bind="_reqn.ReqnDate" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Est. delivery date</label>
                <input type="date" @bind="_reqn.EstDeliveryDate" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Vessel ETA</label>
                <input type="date" @bind="_reqn.VesselEta" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Vessel ETD</label>
                <input type="date" @bind="_reqn.VesselEtd" class="@InputClass" />
            </div>
        </div>

        <div class="mt-6">
            <label class="mb-1 block text-sm font-medium text-slate-700">Remarks</label>
            <textarea @bind="_reqn.Remarks" rows="2" class="@InputClass"></textarea>
        </div>
    </div>

    <div class="card p-6">
        <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-400">Attachments <span class="font-normal normal-case text-muted">(optional)</span></h2>
        <p class="mb-3 text-xs text-muted">Photos, drawings or other PDFs for the whole requisition. Files stay internal unless you tick "suppliers": those are shown to the suppliers on the RFQ so they can quote against them. You can also attach files to individual lines below.</p>
        <FilePicker Files="_reqn.Files" OnChanged="StateHasChanged" />
    </div>

    <ItemLinePicker CompanyId="_companyId" Lines="_reqn.Lines" ShowAttachments="true" ShowDrawingNo="@(_reqn.Type == RfqType.Spares)"
                    DepartmentId="@(_departmentId == Guid.Empty ? null : _departmentId)" RequireDepartment="@(_departments.Count > 0)"
                    VesselId="@(_reqn.VesselId == Guid.Empty ? null : _reqn.VesselId)" PolicyFor="PolicyAction.Requisition"
                    CopySourceLabel="requisition" CopySources="_copySources" OnChanged="StateHasChanged" />

    @if (_error is not null)
    {
        <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }

    <div class="flex gap-3">
        <button @onclick="Submit" disabled="@_busy" class="btn btn-primary">
            @(_busy ? "Saving…" : $"Save requisition ({_reqn.Lines.Count} lines)")
        </button>
        <a href="/company/requisitions" class="btn btn-secondary">Cancel</a>
    </div>
</div>
}

@code {
    private const string InputClass = "input";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    /// <summary>Set when the page is opened from a worklist task ("purchase needed"): fills in the vessel, department, urgency and a note.</summary>
    [SupplyParameterFromQuery(Name = "task")] public Guid? TaskId { get; set; }
    private WorklistTask? _fromTask;
    private List<string> _spareHint = [];

    /// <summary>Set when the page is opened from a maintenance job ("order the spares"): fills in the vessel, department, urgency, a note and a line for each spare.</summary>
    [SupplyParameterFromQuery(Name = "pmsjob")] public Guid? PmsJobId { get; set; }

    private Guid _companyId;
    private Guid _departmentId;
    private Guid _portId;
    private Actor _actor = Actor.System;
    private readonly NewRequisition _reqn = new();
    private List<Vessel> _vessels = new();
    private List<Department> _departments = new();
    private List<Port> _ports = new();
    private List<SelectOption<Guid>> _vesselOptions = new(), _departmentOptions = new(), _portOptions = new();
    private readonly List<SelectOption<Urgency>> _urgencyOptions = SelectOptions.FromEnum<Urgency>();
    private List<LineCopySource> _copySources = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = Guid.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);

        _vessels = await Procurement.GetVesselsAsync(companyId, _actor.UserId);
        _departments = await Procurement.GetDepartmentsAsync(companyId);
        _ports = await Procurement.GetPortsAsync();
        _vesselOptions = SelectOptions.From(_vessels, v => v.Id, v => v.Name);
        _departmentOptions = SelectOptions.From(_departments, d => d.Id, d => d.Name);
        _portOptions = SelectOptions.From(_ports, p => p.Id, p => $"{p.Name}, {p.Country}");

        var recent = await Requisitions.GetRecentAsync(companyId);
        _copySources = recent.Select(r => new LineCopySource(
            r.Id,
            $"{r.ReqnNumber} · {r.Lines.Count} lines · {r.ReqnDate:dd-MMM-yyyy}",
            r.Lines.Select(l => new NewRfqLine { ItemId = l.ItemId, Quantity = l.Quantity, Description = l.Description ?? "", DrawingNo = l.DrawingNo ?? "" }).ToList())).ToList();

        if (TaskId is { } taskId && (await Worklist.GetAsync(companyId, taskId))?.Task is { } task && _vessels.Any(v => v.Id == task.VesselId))
        {
            _fromTask = task;
            _reqn.VesselId = task.VesselId;
            if (task.DepartmentId is { } dept && _departments.Any(d => d.Id == dept)) _departmentId = dept;
            _reqn.Urgency = task.Priority == WorklistPriority.Urgent ? Urgency.Urgent : Urgency.Normal;
            _reqn.Remarks = $"For worklist task {task.Code}: {task.Title}";
        }

        if (PmsJobId is { } pmsJobId && await PmsLinks.RequisitionDraftAsync(companyId, pmsJobId) is { } draft && _vessels.Any(v => v.Id == draft.Requisition.VesselId))
        {
            var d = draft.Requisition;
            (_reqn.Type, _reqn.VesselId, _reqn.Urgency, _reqn.Remarks) = (d.Type, d.VesselId, d.Urgency, d.Remarks);
            if (d.DepartmentId is { } dept && _departments.Any(x => x.Id == dept)) _departmentId = dept;
            // The line picker only keeps items the chosen department may use, so the spares go in as lines only when the job's department is known;
            // otherwise they are listed here to be added once a department is chosen.
            if (_departmentId != Guid.Empty || _departments.Count == 0) _reqn.Lines = d.Lines;
            else _spareHint = draft.SpareSummary;
        }

        _companyId = companyId; // the form is only rendered once everything above is loaded
    }

    private async Task Submit()
    {
        _error = null;
        _reqn.DepartmentId = _departmentId == Guid.Empty ? null : _departmentId;
        _reqn.DeliveryPortId = _portId == Guid.Empty ? null : _portId;

        _busy = true;
        try
        {
            var created = await Requisitions.CreateAsync(_companyId, _reqn, _actor);
            if (_fromTask is not null)
            {
                try { await Worklist.AddEntryAsync(_companyId, _fromTask.Id, new WorklistEntryInput(WorklistEntryType.Link, LinkType: WorklistLinkTypes.Requisition, LinkTarget: created.Id, LinkLabel: $"Requisition {created.ReqnNumber}"), _actor); }
                catch (InvalidOperationException) { /* the requisition is saved; a task that cannot take the link (cancelled, or the module switched off) is left as it was */ }
            }
            Navigation.NavigateTo($"/company/requisitions/{created.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
