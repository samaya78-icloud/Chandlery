@page "/company/rfqs"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject NavigationManager Navigation

<PageTitle>RFQs · Chandlery</PageTitle>

<PageHeader Eyebrow="Procurement" Title="Requests for Quote" Subtitle="@($"{_count:N0} RFQs — raised from requisitions, compared and awarded line by line.")">
    <Actions>
        <a href="/company/requisitions/new" class="btn btn-primary">+ New requisition</a>
    </Actions>
</PageHeader>

@if (_companyId != 0)
{
    <DataGrid TItem="RfqListRow" ItemsProvider="LoadPage" ItemName="RFQs" ExportName="rfqs" PageSize="25" EmptyText="No RFQs match these filters." OnRowClick="Open">
        <GridColumn Title="RFQ #" Key="rfq" Text="r => r.Rfq.RfqNumber" Context="row">
            <DocLink Kind="DocKind.Rfq" Id="row.Rfq.Id" Text="@row.Rfq.RfqNumber" />
        </GridColumn>
        <GridColumn Title="Vessel" Key="vessel" Text="r => r.Rfq.Vessel" Context="row">
            @if (row.Rfq.VesselId is { } vesselId)
            {
                <DocLink Kind="DocKind.Vessel" Id="vesselId" Text="@row.Rfq.Vessel" Plain="true" />
            }
            else
            {
                @row.Rfq.Vessel
            }
        </GridColumn>
        <GridColumn Title="Type" Key="type" Text="r => r.Rfq.Type.ToString()" Filter="GridFilter.Select" Options="TypeOptions" Context="row">
            <StatusChip Value="row.Rfq.Type" />
        </GridColumn>
        <GridColumn Title="Created" Key="created" Date="r => r.Rfq.CreatedDate" />
        <GridColumn Title="Due" Key="due" Date="r => r.Rfq.DueDate" />
        <GridColumn Title="Suppliers Invited" Key="suppliers" Text="r => r.SupplierText" Sortable="false" Context="row">
            @if (row.Suppliers.Count == 0)
            {
                <span class="text-muted">—</span>
            }
            else
            {
                <div class="flex flex-col gap-0.5">
                    @foreach (var s in row.Suppliers.Take(3))
                    {
                        <DocLink Kind="DocKind.Supplier" Id="s.Id" Text="@s.Name" Plain="true" />
                    }
                    @if (row.Suppliers.Count > 3)
                    {
                        <span class="text-xs text-muted" title="@row.SupplierText">+@(row.Suppliers.Count - 3) more</span>
                    }
                </div>
            }
        </GridColumn>
        <GridColumn Title="Quotes In" Key="quotes" Text="r => r.QuoteCount.ToString()" Filter="GridFilter.Select" OptionsLoader="LoadQuoteOptions" />
        <GridColumn Title="Status" Key="status" Text="r => r.Rfq.Status.ToString()" Filter="GridFilter.Select" Chips="true" Options="StatusOptions" Context="row">
            <StatusChip Value="row.Rfq.Status" />
        </GridColumn>
        <GridColumn Title="" Filter="GridFilter.None" CellClass="whitespace-nowrap text-right"><span class="link">Open &rarr;</span></GridColumn>
    </DataGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] TypeOptions = Enum.GetNames<RfqType>();
    private static readonly string[] StatusOptions = Enum.GetNames<RfqStatus>();

    private int _companyId;
    private int _count;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _count = await Procurement.GetRfqCountAsync(companyId);
        _companyId = companyId; // the grid is only rendered once this is set
    }

    private Task<GridResult<RfqListRow>> LoadPage(GridRequest request) => Procurement.GetRfqPageAsync(_companyId, request);

    private async Task<IEnumerable<string>> LoadQuoteOptions() => await Procurement.GetRfqQuoteCountOptionsAsync(_companyId);

    private void Open(RfqListRow row) => Navigation.NavigateTo($"/company/rfqs/{row.Rfq.Id}");
}
