@page "/company/purchase-orders/new-spot"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject NavigationManager Navigation

<PageTitle>New Spot PO · Chandlery</PageTitle>

<PageHeader Eyebrow="Procurement" Title="New Spot PO"
            Subtitle="Order straight from a supplier without an RFQ. The order goes through the approval matrix by its total, like any other PO." />

@if (_companyId != 0)
{
<div class="max-w-5xl space-y-6">

    <div class="card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">Order details</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <label class="label">Vessel</label>
                <select @bind="_vesselId" class="select">
                    <option value="0">Choose a vessel…</option>
                    @foreach (var v in _vessels)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="label">Department @if (_departments.Count > 0) { <span class="text-rose-500">*</span> }</label>
                <select @bind="_departmentId" class="select">
                    <option value="0">@(_departments.Count > 0 ? "Select department…" : "No department")</option>
                    @foreach (var d in _departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="label">Supplier</label>
                <select @bind="_supplierId" class="select">
                    <option value="0">Choose a supplier…</option>
                    @foreach (var s in _suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="label">Supplier reference</label>
                <input @bind="_po.SupplierRef" placeholder="Their quote or proforma number" class="input" />
            </div>
            <div>
                <label class="label">Currency</label>
                <input @bind="_po.Currency" maxlength="3" class="input uppercase" />
            </div>
            <div>
                <label class="label">Order port</label>
                <select @bind="_portId" class="select">
                    <option value="0">Not specified</option>
                    @foreach (var p in _ports)
                    {
                        <option value="@p.Id">@p.Name, @p.Country</option>
                    }
                </select>
            </div>
        </div>

        <div class="mt-4">
            <label class="label">Remarks</label>
            <textarea @bind="_po.Remarks" rows="2" class="textarea"></textarea>
        </div>

        <label class="mt-4 flex items-start gap-2 text-sm text-ink">
            <input type="checkbox" class="mt-0.5" checked="@_po.IsDummy" @onchange="e => _po.IsDummy = (bool)e.Value!" />
            <span>
                <span class="font-medium">Record-only PO</span>
                <span class="block text-xs text-muted">Order placed outside Chandlery (phone, email, port agent). No prices and no approval. Use it so deliveries and invoices can be linked to it.</span>
            </span>
        </label>
    </div>

    <ItemLinePicker CompanyId="_companyId" Lines="_po.Lines" ShowPrice="@(!_po.IsDummy)" OnChanged="StateHasChanged"
                    DepartmentId="@(_departmentId == 0 ? null : _departmentId)" RequireDepartment="@(_departments.Count > 0)" />

    @if (!_po.IsDummy)
    {
        <div class="card p-6">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">Discount, charges and total</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                <div>
                    <label class="label">Header discount %</label>
                    <input type="number" min="0" max="100" step="any" @bind="_po.DiscountPct" @bind:event="oninput" class="input" />
                </div>
                <div>
                    <label class="label">Additional charges</label>
                    <input type="number" min="0" step="any" @bind="_po.AdditionalCharges" @bind:event="oninput" class="input" />
                </div>
                <div>
                    <label class="label">Charges description</label>
                    <input @bind="_po.AdditionalChargeDescription" placeholder="e.g. Freight" class="input" />
                </div>
            </div>
            <dl class="mt-5 ml-auto max-w-xs space-y-1 text-sm">
                <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd class="tabular-nums">@Money.Format(Subtotal, Currency)</dd></div>
                @if (_po.DiscountPct > 0)
                {
                    <div class="flex justify-between"><dt class="text-muted">Discount @_po.DiscountPct%</dt><dd class="tabular-nums">- @Money.Format(Subtotal * _po.DiscountPct / 100m, Currency)</dd></div>
                }
                @if (_po.AdditionalCharges > 0)
                {
                    <div class="flex justify-between"><dt class="text-muted">Charges</dt><dd class="tabular-nums">@Money.Format(_po.AdditionalCharges, Currency)</dd></div>
                }
                <div class="flex justify-between border-t border-line pt-2 text-base font-bold text-ink"><dt>Total</dt><dd class="tabular-nums">@Money.Format(Total, Currency)</dd></div>
            </dl>
        </div>
    }

    @if (_error is not null)
    {
        <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }

    <div class="flex gap-3">
        <button @onclick="Submit" disabled="@_busy" class="btn btn-primary">
            @(_busy ? "Creating…" : $"Create spot PO ({_po.Lines.Count} lines)")
        </button>
        <a href="/company/purchase-orders" class="btn btn-secondary">Cancel</a>
    </div>
</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private Actor _actor = Actor.System;
    private int _vesselId;
    private int _departmentId;
    private int _supplierId;
    private int _portId;
    private readonly NewSpotPo _po = new();
    private List<Vessel> _vessels = new();
    private List<Department> _departments = new();
    private List<Port> _ports = new();
    private List<Supplier> _suppliers = new();
    private string? _error;
    private bool _busy;

    private string Currency => string.IsNullOrWhiteSpace(_po.Currency) ? "USD" : _po.Currency.Trim().ToUpperInvariant();
    private decimal Subtotal => _po.Lines.Sum(l => Money.LineNet(l.Quantity, l.UnitPrice, l.DiscountPct));
    private decimal Total => Money.GrandTotal(Subtotal, _po.DiscountPct, _po.AdditionalCharges);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);

        _vessels = await Procurement.GetVesselsAsync(companyId);
        _departments = await Procurement.GetDepartmentsAsync(companyId);
        _ports = await Procurement.GetPortsAsync();
        _suppliers = await Procurement.GetCompanySuppliersAsync(companyId);

        _companyId = companyId; // the form is only rendered once everything above is loaded
    }

    private async Task Submit()
    {
        _error = null;

        if (_vesselId == 0) { _error = "Choose the vessel this order is for."; return; }
        if (_supplierId == 0) { _error = "Choose a supplier."; return; }
        if (_departments.Count > 0 && _departmentId == 0) { _error = "Choose a department."; return; }
        if (_po.Lines.Count == 0) { _error = "Add at least one line item."; return; }

        var zeroQty = _po.Lines.Count(l => l.Quantity <= 0);
        if (zeroQty > 0)
        {
            _error = $"{zeroQty} line(s) have no quantity. Every line needs a quantity above zero.";
            return;
        }
        if (!_po.IsDummy)
        {
            var unpriced = _po.Lines.Count(l => l.UnitPrice <= 0);
            if (unpriced > 0)
            {
                _error = $"{unpriced} line(s) have no unit price. Price every line, or tick Record-only PO if this order has no value.";
                return;
            }
        }

        var request = new NewSpotPo
        {
            VesselId = _vesselId,
            DepartmentId = _departmentId == 0 ? null : _departmentId,
            SupplierId = _supplierId,
            SupplierRef = _po.SupplierRef,
            Currency = Currency,
            OrderPortId = _portId == 0 ? null : _portId,
            Remarks = _po.Remarks,
            IsDummy = _po.IsDummy,
            DiscountPct = _po.DiscountPct,
            AdditionalCharges = _po.AdditionalCharges,
            AdditionalChargeDescription = _po.AdditionalChargeDescription,
            Lines = _po.Lines
        };

        _busy = true;
        try
        {
            var po = await Procurement.CreateSpotPoAsync(_companyId, request, _actor);
            Navigation.NavigateTo($"/company/purchase-orders/{po.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
