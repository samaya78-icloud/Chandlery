@page "/company/rfqs/new"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject NavigationManager Navigation

<PageTitle>New RFQ · Chandlery</PageTitle>

<PageHeader Eyebrow="Procurement" Title="New Request for Quote" Subtitle="Enter the items once and send them to every supplier you choose." />

@if (_companyId != 0)
{
<div class="max-w-5xl space-y-6">

    @* Header *@
    <div class="card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-400">RFQ details</h2>

        <div class="mb-5 flex gap-6">
            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="rfq-type" checked="@(_rfq.Type == RfqType.Stores)" @onchange="() => _rfq.Type = RfqType.Stores" /> Stores
            </label>
            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="rfq-type" checked="@(_rfq.Type == RfqType.Spares)" @onchange="() => _rfq.Type = RfqType.Spares" /> Spares
            </label>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Vessel</label>
                <select @bind="_vesselId" class="@InputClass">
                    <option value="0">@(_vessels.Count == 0 ? "Type a vessel name below" : "Other (type below)")</option>
                    @foreach (var v in _vessels)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </select>
                @if (_vesselId == 0)
                {
                    <input @bind="_rfq.VesselName" type="text" placeholder="e.g. MV Sea Falcon" class="@(InputClass + " mt-2")" />
                }
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Delivery port</label>
                <select @bind="_portId" class="@InputClass">
                    <option value="0">Not specified</option>
                    @foreach (var p in _ports)
                    {
                        <option value="@p.Id">@p.Name, @p.Country</option>
                    }
                </select>
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Quotes due by</label>
                <input type="date" @bind="_rfq.DueDate" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Date required</label>
                <input type="date" @bind="_rfq.DateRequired" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Vessel ETA</label>
                <input type="date" @bind="_rfq.VesselEta" class="@InputClass" />
            </div>
        </div>

        <h2 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-slate-400">Buyer contact</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Name</label>
                <input @bind="_rfq.BuyerName" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Designation</label>
                <input @bind="_rfq.BuyerDesignation" placeholder="e.g. Procurement Executive" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>
                <input @bind="_rfq.BuyerEmail" type="email" class="@InputClass" />
            </div>
        </div>

        @if (_rfq.Type == RfqType.Spares)
        {
            <h2 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-slate-400">Equipment</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Description</label>
                    <input @bind="_rfq.EquipmentDescription" placeholder="e.g. Main Engine No.1" class="@InputClass" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Maker</label>
                    <input @bind="_rfq.EquipmentMaker" class="@InputClass" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Particulars / model</label>
                    <input @bind="_rfq.EquipmentParticulars" class="@InputClass" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Serial no.</label>
                    <input @bind="_rfq.EquipmentSerialNo" class="@InputClass" />
                </div>
            </div>
        }

        <div class="mt-6">
            <label class="mb-1 block text-sm font-medium text-slate-700">Remarks</label>
            <textarea @bind="_rfq.Remarks" rows="2" class="@InputClass"></textarea>
        </div>
    </div>

    @* Lines *@
    <ItemLinePicker CompanyId="_companyId" Lines="_rfq.Lines" ShowDrawingNo="@(_rfq.Type == RfqType.Spares)"
                    CopySourceLabel="RFQ" CopySources="_copySources" OnChanged="StateHasChanged" />

    @* Suppliers *@
    <div class="card p-6">
        <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-400">Suppliers</h2>
        <p class="mb-4 text-xs text-slate-400">Every supplier you tick receives this same RFQ and quotes against the same lines.</p>
        @if (_suppliers.Count == 0)
        {
            <p class="text-sm text-slate-400">No suppliers yet &mdash; add one on the Suppliers page first.</p>
        }
        else
        {
            <div class="flex flex-col gap-2">
                @foreach (var supplier in _suppliers)
                {
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <input type="checkbox" checked="@_rfq.InvitedSupplierIds.Contains(supplier.Id)" @onchange="e => ToggleSupplier(supplier.Id, (bool)e.Value!)" />
                        @supplier.Name
                    </label>
                }
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }

    <div class="flex gap-3">
        <button @onclick="Submit" disabled="@_busy" class="btn btn-primary">
            @(_busy ? "Sending…" : $"Send RFQ ({_rfq.Lines.Count} lines)")
        </button>
        <a href="/company/rfqs" class="btn btn-secondary">Cancel</a>
    </div>
</div>
}

@code {
    private const string InputClass = "input";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private Actor _actor = Actor.System;
    private int _vesselId;
    private int _portId;
    private readonly NewRfq _rfq = new();
    private List<Vessel> _vessels = new();
    private List<Port> _ports = new();
    private List<Supplier> _suppliers = new();
    private List<LineCopySource> _copySources = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);
        _rfq.BuyerName = authState.User.Identity?.Name ?? "";
        _rfq.BuyerEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

        _vessels = await Procurement.GetVesselsAsync(companyId);
        _ports = await Procurement.GetPortsAsync();
        _suppliers = await Procurement.GetCompanySuppliersAsync(companyId);

        var past = await Procurement.GetRfqsAsync(companyId);
        _copySources = past.Select(r => new LineCopySource(
            r.Id,
            $"{r.RfqNumber} · {r.Vessel} · {r.Lines.Count} lines · {r.CreatedDate:dd-MMM-yyyy}",
            r.Lines.Select(l => new NewRfqLine { ItemId = l.ItemId, Quantity = l.Quantity, Description = l.Description ?? "", DrawingNo = l.DrawingNo ?? "" }).ToList())).ToList();

        _companyId = companyId; // the form is only rendered once everything above is loaded
    }

    private void ToggleSupplier(int supplierId, bool selected)
    {
        if (selected) { if (!_rfq.InvitedSupplierIds.Contains(supplierId)) _rfq.InvitedSupplierIds.Add(supplierId); }
        else _rfq.InvitedSupplierIds.Remove(supplierId);
    }

    private async Task Submit()
    {
        _error = null;

        if (_vesselId == 0 && string.IsNullOrWhiteSpace(_rfq.VesselName))
        {
            _error = "Vessel is required.";
            return;
        }
        if (!_rfq.DueDate.HasValue)
        {
            _error = "Set the date quotes are due by.";
            return;
        }
        if (_rfq.DueDate.Value.Date < DateTime.UtcNow.Date)
        {
            _error = "The due date can't be in the past.";
            return;
        }
        if (_rfq.Lines.Count == 0)
        {
            _error = "Add at least one line item.";
            return;
        }
        var zeroQty = _rfq.Lines.Count(l => l.Quantity <= 0);
        if (zeroQty > 0)
        {
            _error = $"{zeroQty} line(s) have no quantity. Every line needs a quantity above zero (use the filter to find them, or remove the line).";
            return;
        }

        var request = new NewRfq
        {
            Type = _rfq.Type,
            VesselId = _vesselId == 0 ? null : _vesselId,
            VesselName = _rfq.VesselName,
            DeliveryPortId = _portId == 0 ? null : _portId,
            VesselEta = _rfq.VesselEta,
            DateRequired = _rfq.DateRequired,
            DueDate = _rfq.DueDate,
            BuyerName = _rfq.BuyerName,
            BuyerDesignation = _rfq.BuyerDesignation,
            BuyerEmail = _rfq.BuyerEmail,
            Remarks = _rfq.Remarks,
            EquipmentDescription = _rfq.EquipmentDescription,
            EquipmentParticulars = _rfq.EquipmentParticulars,
            EquipmentMaker = _rfq.EquipmentMaker,
            EquipmentSerialNo = _rfq.EquipmentSerialNo,
            Lines = _rfq.Lines,
            InvitedSupplierIds = _rfq.InvitedSupplierIds
        };

        _busy = true;
        try
        {
            var rfq = await Procurement.CreateRfqAsync(_companyId, request, _actor);
            Navigation.NavigateTo($"/company/rfqs/{rfq.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
