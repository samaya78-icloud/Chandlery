@page "/company/invoices/new-spot"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject InvoiceService InvoiceSvc
@inject FxService FxSvc
@inject NavigationManager Navigation

<PageTitle>New Spot Invoice · Chandlery</PageTitle>

<PageHeader Eyebrow="Procurement" Title="New Spot Invoice"
            Subtitle="Record an invoice that has no purchase order, such as a port service or a one-off repair. It goes straight to approval by its total." />

@if (_companyId != 0)
{
<div class="max-w-5xl space-y-6">
    <div class="card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">Invoice details</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="label">Supplier</label>
                <SelectBox TValue="int" @bind-Value="_supplierId" @bind-Value:after="LoadBanks" Provider="Procurement.SupplierSelectProvider(_companyId)" Resolve="Procurement.SupplierSelectResolver()"
                           Placeholder="Choose a supplier…" SearchPlaceholder="Search suppliers by name or email…" />
            </div>
            <div><label class="label">Supplier invoice no.</label><input @bind="_req.SupplierInvoiceRef" class="input" /></div>
            <div><label class="label">Currency</label><SelectBox TValue="string" @bind-Value="_req.Currency" Options="_currencyOptions" Placeholder="Currency" SearchPlaceholder="Search currencies…" /></div>
            <div><label class="label">Invoice date</label><input type="date" @bind="_req.InvoiceDate" class="input" /></div>
            <div><label class="label">Due date (optional)</label><input type="date" @bind="_req.DueDate" class="input" /></div>
            <div>
                <label class="label">Tax code</label>
                <SelectBox TValue="int" @bind-Value="_taxCodeId" Options="_taxOptions" Placeholder="No tax" AllowClear="true" />
            </div>
            <div>
                <label class="label">Department@(_departments.Count > 0 ? " *" : "")</label>
                <SelectBox TValue="int" @bind-Value="_departmentId" Options="_departmentOptions" Placeholder="@(_departments.Count > 0 ? "Select department…" : "No department")" />
            </div>
            <div>
                <label class="label">Vessel</label>
                <SelectBox TValue="int" @bind-Value="_vesselId" Options="_vesselOptions" Placeholder="None" AllowClear="true" />
            </div>
            <div><label class="label">Cost centre</label><input @bind="_req.CostCentre" class="input" /></div>
            <div class="md:col-span-3">
                <label class="label">Pay into (the supplier's saved accounts)</label>
                <SelectBox TValue="int" @bind-Value="_bankId" Options="_bankOptions" Disabled="@(_supplierId == 0 || _banks.Count == 0)" AllowClear="true" Class="max-w-xl"
                           Placeholder="@(_supplierId == 0 ? "Choose a supplier first" : _banks.Count == 0 ? "This supplier has not saved a bank account" : "Not specified")" />
            </div>
        </div>
    </div>

    <ItemLinePicker CompanyId="_companyId" Lines="_req.Lines" ShowPrice="true" OnChanged="StateHasChanged"
                    DepartmentId="@(_departmentId == 0 ? null : _departmentId)" RequireDepartment="@(_departments.Count > 0)" />

    <div class="card p-6">
        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div><label class="label">Additional items</label><input type="number" min="0" step="any" @bind="_req.AdditionalItemsCost" @bind:event="oninput" class="input" /></div>
            <div><label class="label">Delivery cost</label><input type="number" min="0" step="any" @bind="_req.AdditionalDeliveryCost" @bind:event="oninput" class="input" /></div>
            <div><label class="label">Discount / credit</label><input type="number" min="0" step="any" @bind="_req.DiscountOrCredit" @bind:event="oninput" class="input" /></div>
        </div>
        <dl class="ml-auto mt-5 max-w-xs space-y-1 text-sm">
            <div class="flex justify-between"><dt class="text-muted">Lines</dt><dd class="tabular-nums">@Money.Format(LinesTotal, Currency)</dd></div>
            <div class="flex justify-between border-t border-line pt-2 text-base font-bold text-ink"><dt>Total before tax</dt><dd class="tabular-nums">@Money.Format(Total, Currency)</dd></div>
        </dl>
    </div>

    <div class="card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">Documents and remarks</h2>
        <label class="label">Supplier's invoice and other documents (PDF, PNG, JPG, XLSX or DOCX, up to 20 MB each)</label>
        <InputFile OnChange="OnFiles" multiple class="input max-w-xl" accept=".pdf,.png,.jpg,.jpeg,.xlsx,.docx" />
        @if (_uploads.Count > 0)
        {
            <ul class="mt-3 space-y-1 text-sm">
                @foreach (var u in _uploads)
                {
                    var upload = u;
                    <li class="flex items-center gap-3 text-ink">&#10003; @u.FileName <span class="text-xs text-muted">@(u.Data.Length / 1024) KB</span>
                        <button type="button" @onclick="() => _uploads.Remove(upload)" class="text-xs font-medium text-rose-600">Remove</button></li>
                }
            </ul>
        }
        <div class="mt-5"><label class="label">Remarks</label><textarea @bind="_req.Remarks" rows="2" class="textarea"></textarea></div>
    </div>

    @if (_error is not null)
    {
        <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }
    <div class="flex gap-3">
        <button @onclick="Submit" disabled="@_busy" class="btn btn-primary">@(_busy ? "Saving…" : "Create and send for approval")</button>
        <a href="/company/invoices" class="btn btn-secondary">Cancel</a>
    </div>
</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private Actor _actor = Actor.System;
    private readonly NewSpotInvoice _req = new();
    private readonly List<UploadedFile> _uploads = new();
    private List<Department> _departments = new();
    private List<Vessel> _vessels = new();
    private List<TaxCode> _taxCodes = new();
    private List<SupplierBankAccount> _banks = new();
    private List<SelectOption<string>> _currencyOptions = new();
    private List<SelectOption<int>> _departmentOptions = new(), _vesselOptions = new(), _taxOptions = new(), _bankOptions = new();
    private int _supplierId, _departmentId, _vesselId, _taxCodeId, _bankId;
    private bool _busy;
    private string? _error;

    private string Currency => string.IsNullOrWhiteSpace(_req.Currency) ? "USD" : _req.Currency.Trim().ToUpperInvariant();
    private decimal LinesTotal => _req.Lines.Sum(l => Money.LineNet(l.Quantity, l.UnitPrice, l.DiscountPct));
    private decimal Total => LinesTotal + _req.AdditionalItemsCost + _req.AdditionalDeliveryCost - _req.DiscountOrCredit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);
        _departments = await Procurement.GetDepartmentsAsync(companyId);
        _vessels = await Procurement.GetVesselsAsync(companyId);
        _taxCodes = await InvoiceSvc.GetTaxCodesAsync(companyId);
        _departmentOptions = SelectOptions.From(_departments, d => d.Id, d => d.Name);
        _vesselOptions = SelectOptions.From(_vessels, v => v.Id, v => v.Name);
        _taxOptions = SelectOptions.From(_taxCodes, t => t.Id, t => $"{t.Code} · {t.RatePct:0.##}%", t => t.Description);
        _currencyOptions = await FxSvc.GetCompanyCurrencyOptionsAsync(companyId);
        _companyId = companyId; // the form is only rendered once everything above is loaded
    }

    private async Task LoadBanks()
    {
        _bankId = 0;
        _banks = _supplierId == 0 ? new() : await InvoiceSvc.GetBankAccountsAsync(_supplierId);
        _bankOptions = SelectOptions.From(_banks, b => b.Id, b => $"{b.BankName} · {b.AccountNumber}", b => $"{b.AccountName} ({b.Currency})");
    }

    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                _uploads.Add(new UploadedFile(file.Name, file.ContentType, memory.ToArray()));
            }
        }
        catch (IOException)
        {
            _error = "A file is larger than 20 MB and was not added.";
        }
    }

    private async Task Submit()
    {
        _error = null;
        if (_supplierId == 0) { _error = "Choose a supplier."; return; }
        if (_departments.Count > 0 && _departmentId == 0) { _error = "Choose a department."; return; }
        _req.SupplierId = _supplierId;
        _req.Currency = Currency;
        _req.DepartmentId = _departmentId == 0 ? null : _departmentId;
        _req.VesselId = _vesselId == 0 ? null : _vesselId;
        _req.TaxCodeId = _taxCodeId == 0 ? null : _taxCodeId;
        _req.BankAccountId = _bankId == 0 ? null : _bankId;

        _busy = true;
        try
        {
            var invoice = await InvoiceSvc.CreateSpotAsync(_companyId, _req, _uploads, _actor);
            Navigation.NavigateTo($"/company/invoices/{invoice.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
