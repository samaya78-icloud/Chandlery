@page "/company/items/import"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement

<PageTitle>Import Items · Chandlery</PageTitle>

<PageHeader Eyebrow="Master data" Title="Import Items" Subtitle="Load a catalog from a CSV file. Existing item codes are skipped; missing categories are created." />

<div class="max-w-3xl space-y-6">
    <div class="card p-6">
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-400">File format</h2>
        <p class="mb-3 text-sm text-slate-600">Four columns: <b>Code, Name, Category, UOM</b>. The category is the full path separated by <code>&gt;</code>. A header row is optional.</p>
        <pre class="overflow-x-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">Code,Name,Category,UOM
PRV-0001,"Potatoes, washed",Store &gt; Provisions &gt; Fresh Vegetables,kg
PRV-0002,Long grain rice 25kg,Store &gt; Provisions &gt; Dry Goods,bag</pre>
        <p class="mt-3 text-xs text-slate-400">Up to @ItemImport.MaxRows items per file, 2 MB maximum.</p>
        <p class="mt-2 text-sm"><a href="/samples/catalog-sample.csv" download class="font-medium text-indigo-600 hover:text-indigo-700">Download a sample file</a> <span class="text-slate-400">(351 generic provisions, galley and deck/engine stores items, for trying the import and bulk RFQs)</span></p>
    </div>

    <div class="card p-6">
        <label class="mb-2 block text-sm font-medium text-slate-700">CSV file</label>
        <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" class="block text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700" />

        @if (_fileName is not null)
        {
            <div class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-700">
                <p><b>@_fileName</b>: @_rows.Count items ready to import across @_pathCount categories.</p>
                @if (_errors.Count > 0)
                {
                    <p class="mt-2 font-medium text-rose-600">@_errors.Count row(s) will be skipped:</p>
                    <ul class="mt-1 list-disc pl-5 text-xs text-rose-600">
                        @foreach (var e in _errors.Take(15)) { <li>@e</li> }
                        @if (_errors.Count > 15) { <li>…and @(_errors.Count - 15) more</li> }
                    </ul>
                }
            </div>
            <button @onclick="Import" disabled="@(_rows.Count == 0 || _busy)"
                    class="mt-4 btn btn-primary">
                @(_busy ? "Importing…" : $"Import {_rows.Count} items")
            </button>
        }

        @if (_error is not null)
        {
            <div class="mt-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
        }
        @if (_result is not null)
        {
            <div class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">
                Imported @_result.Created items. @_result.SkippedDuplicates skipped as duplicates, @_result.CategoriesCreated new categories created.
                <a href="/company/items" class="ml-1 font-medium underline">View catalog</a>
            </div>
        }
    </div>
</div>

@code {
    private const long MaxFileBytes = 2 * 1024 * 1024;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private string? _fileName;
    private List<ItemImportRow> _rows = new();
    private List<string> _errors = new();
    private int _pathCount;
    private bool _busy;
    private string? _error;
    private ItemImportResult? _result;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        _rows = new();
        _errors = new();
        _fileName = null;

        var file = e.File;
        if (file.Size > MaxFileBytes)
        {
            _error = "That file is larger than 2 MB.";
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(MaxFileBytes));
            var text = await reader.ReadToEndAsync();
            (_rows, _errors) = ItemImport.Parse(text);
            _pathCount = _rows.Select(r => r.CategoryPath).Distinct(StringComparer.OrdinalIgnoreCase).Count();
            _fileName = file.Name;
        }
        catch (IOException)
        {
            _error = "Couldn't read that file.";
        }
    }

    private async Task Import()
    {
        _busy = true;
        _error = null;
        try
        {
            _result = await Procurement.ImportItemsAsync(_companyId, _rows);
            _rows = new();
            _fileName = null;
        }
        catch (Exception)
        {
            _error = "The import failed part-way, so some items may already have been added. Re-running the same file is safe: existing codes are skipped.";
        }
        finally
        {
            _busy = false;
        }
    }
}
