@page "/company/rfqs/{RfqId:int}"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject RequisitionService Requisitions
@inject FxService FxSvc
@inject AttachmentService Attach
@inject NavigationManager Navigation

<PageTitle>@(_rfq?.RfqNumber ?? "RFQ") · Chandlery</PageTitle>

@if (_rfq is null)
{
    <p class="text-sm text-slate-500">RFQ not found.</p>
}
else
{
    <PageHeader Eyebrow="Request for quote" Title="@_rfq.RfqNumber">
        <Badges>
            <StatusChip Value="_rfq.Status" />
            <StatusChip Value="_rfq.Type" />
        </Badges>
        <Facts>
            @if (_rfq.VesselId is { } vesselId)
            {
                <DocLink Kind="DocKind.Vessel" Id="vesselId" Text="@_rfq.Vessel" />
            }
            else
            {
                <span>@_rfq.Vessel</span>
            }
            <span>&middot; Created @_rfq.CreatedDate.ToString("MMM d, yyyy")</span>
            @if (_requisition is not null)
            {
                <span>&middot; From requisition</span>
                <DocLink Kind="DocKind.Requisition" Id="_requisition.Id" Text="@_requisition.ReqnNumber" />
            }
        </Facts>
        <Actions>
            <button onclick="window.print()" class="btn btn-secondary btn-sm">Print</button>
        </Actions>
    </PageHeader>

    <RelatedDocuments CompanyId="_companyId" Kind="DocKind.Rfq" Id="_rfq.Id" Version="_auditVersion" />

    <div class="mb-6 grid grid-cols-2 gap-4 card p-4 text-sm md:grid-cols-4">
        <div><p class="text-xs uppercase tracking-wide text-slate-400">Delivery port</p><p class="font-medium text-slate-800">@(PortLabel() ?? "—")</p></div>
        <div><p class="text-xs uppercase tracking-wide text-slate-400">Quotes due</p><p class="font-medium text-slate-800">@Date(_rfq.DueDate)@(_rfq.IsPastDue ? " (closed)" : "")</p></div>
        <div><p class="text-xs uppercase tracking-wide text-slate-400">Date required</p><p class="font-medium text-slate-800">@Date(_rfq.DateRequired)</p></div>
        <div><p class="text-xs uppercase tracking-wide text-slate-400">Vessel ETA</p><p class="font-medium text-slate-800">@Date(_rfq.VesselEta)</p></div>
        <div class="col-span-2"><p class="text-xs uppercase tracking-wide text-slate-400">Buyer contact</p><p class="font-medium text-slate-800">@_rfq.BuyerName @(string.IsNullOrWhiteSpace(_rfq.BuyerDesignation) ? "" : "· " + _rfq.BuyerDesignation)</p><p class="text-slate-500">@_rfq.BuyerEmail</p></div>
        @if (_rfq.Type == RfqType.Spares)
        {
            <div class="col-span-2"><p class="text-xs uppercase tracking-wide text-slate-400">Equipment</p><p class="font-medium text-slate-800">@_rfq.EquipmentDescription</p><p class="text-slate-500">@_rfq.EquipmentMaker @_rfq.EquipmentParticulars @(string.IsNullOrWhiteSpace(_rfq.EquipmentSerialNo) ? "" : "· S/N " + _rfq.EquipmentSerialNo)</p></div>
        }
        @if (!string.IsNullOrWhiteSpace(_rfq.Remarks))
        {
            <div class="col-span-2 md:col-span-4"><p class="text-xs uppercase tracking-wide text-slate-400">Remarks</p><p class="text-slate-700">@_rfq.Remarks</p></div>
        }
    </div>

    @if (_files.Header.Count > 0)
    {
        <div class="mb-6 card p-4">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-400">Attachments from the requisition</h2>
            <p class="mb-3 text-xs text-muted">Suppliers only see the ones tagged "Shown to suppliers". Change that on the requisition.</p>
            <AttachmentList Items="_files.Header" />
        </div>
    }

    @if (_newlyRaisedPos.Count > 0)
    {
        <div class="mb-6 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            Raised @_newlyRaisedPos.Count purchase order(s):
            @foreach (var raised in _newlyRaisedPos)
            {
                <a href="/company/purchase-orders/@raised.Id" class="link mr-2">@raised.PoNumber</a>
            }
            @if (_newlyRaisedPos.Any(p => p.Status == PoStatus.PendingApproval))
            {
                <span>&mdash; waiting for approval before they are released to the supplier.</span>
            }
        </div>
    }
    @if (_error is not null)
    {
        <div class="mb-6 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-600">@_error</div>
    }

    @* Supplier terms and totals *@
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Suppliers</h2>
    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        @foreach (var supplierId in _rfq.InvitedSupplierIds)
        {
            var supplier = _suppliersById.GetValueOrDefault(supplierId);
            var quote = _quotes.FirstOrDefault(q => q.SupplierId == supplierId);
            <div class="card p-4">
                <div class="flex items-center justify-between">
                    @if (supplier is not null)
                    {
                        <DocLink Kind="DocKind.Supplier" Id="supplier.Id" Text="@supplier.Name" />
                    }
                    @if (quote is null)
                    {
                        <StatusChip Label="No quote yet" Tone="warning" />
                    }
                    else
                    {
                        <StatusChip Label="Quoted" Tone="info" />
                    }
                </div>
                @if (quote is not null)
                {
                    <p class="mt-2 text-xl font-bold text-slate-900">@Money.Format(quote.GrandTotal(_rfq.Lines), quote.Currency)</p>
                    <p><UsdEquivalent Amount="quote.GrandTotal(_rfq.Lines)" Currency="@quote.Currency" /></p>
                    <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-slate-500">
                        <dt>Delivery</dt><dd class="text-slate-700">@(quote.DeliveryDays.HasValue ? quote.DeliveryDays + " days" : "—")</dd>
                        <dt>Valid until</dt><dd class="text-slate-700">@Date(quote.ValidityDate)</dd>
                        <dt>Discount</dt><dd class="text-slate-700">@quote.DiscountPct.ToString("0.##")%</dd>
                        <dt>Additional charges</dt><dd class="text-slate-700">@Money.Format(quote.AdditionalCharges, quote.Currency)@(string.IsNullOrWhiteSpace(quote.AdditionalChargeDescription) ? "" : " (" + quote.AdditionalChargeDescription + ")")</dd>
                        <dt>Supplier ref</dt><dd class="text-slate-700">@(string.IsNullOrWhiteSpace(quote.SupplierRef) ? "—" : quote.SupplierRef)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(quote.Remarks))
                    {
                        <p class="mt-2 text-xs text-slate-500">@quote.Remarks</p>
                    }
                }
            </div>
        }
    </div>

    @* Quick select: fill in the winner on many lines at once *@
    @if (_quotes.Count > 0 && OpenLines.Any())
    {
        var totals = TotalRows;
        var lowest = totals.Where(t => t.Complete && t.Cmp.HasValue).OrderBy(t => t.Cmp).FirstOrDefault();
        var perLine = BestPerLine();
        var bySupplier = perLine.GroupBy(kv => kv.Value).Select(g => (Supplier: _suppliersById.GetValueOrDefault(g.Key)?.Name ?? "", Lines: g.Count())).OrderByDescending(x => x.Lines).ToList();
        var openCount = OpenLines.Count();
        var chosenCount = _pickSupplier == 0 ? 0 : OpenLines.Count(l => QuoteLineFor(_pickSupplier, l.Id) is not null);

        <div class="mb-6 card p-5 print:hidden">
            <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Quick select winners</h2>
                @if (_rfq.Lines.Any(l => l.WinningSupplierId.HasValue && !_poItemIds.Contains(l.ItemId)))
                {
                    <button @onclick="ClearAll" disabled="@_busy" class="text-xs font-medium text-rose-600 hover:text-rose-700">Clear all selections</button>
                }
            </div>
            <p class="mb-4 text-xs text-muted">
                Fills in the winner on every line that has no purchase order yet. You can still change any line by hand below.
                @if (!_singleCurrency) { <span>Quotes in different currencies are compared in US dollars at today's rate.</span> }
            </p>
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                <div class="rounded-xl border border-line p-4">
                    <p class="text-sm font-semibold text-ink">One supplier for everything</p>
                    <p class="mb-3 text-xs text-muted">Choose the supplier yourself.</p>
                    <SelectBox TValue="int" @bind-Value="_pickSupplier" Options="_quotedSupplierOptions" Placeholder="Choose a supplier…" SearchPlaceholder="Search…" />
                    @if (_pickSupplier != 0)
                    {
                        <p class="mt-2 text-xs text-muted">Quoted @chosenCount of @openCount open lines@(chosenCount < openCount ? "; the rest stay as they are." : ".")</p>
                    }
                    <button @onclick="SelectOneSupplier" disabled="@(_busy || _pickSupplier == 0 || chosenCount == 0)" class="btn btn-secondary btn-sm mt-3">Select all lines</button>
                </div>

                <div class="rounded-xl border border-line p-4">
                    <p class="text-sm font-semibold text-ink">Lowest total quote</p>
                    <p class="mb-3 text-xs text-muted">The supplier whose whole quote costs least, among those who quoted every open line.</p>
                    <ul class="space-y-1 text-xs">
                        @foreach (var t in totals)
                        {
                            <li class="flex items-center justify-between gap-2 @(lowest is not null && t.Quote.SupplierId == lowest.Quote.SupplierId ? "font-semibold text-ink" : "text-muted")">
                                <span class="truncate">@t.Supplier</span>
                                <span class="tabular-nums">
                                    @if (!t.Complete) { <span>partial: @t.Quoted of @openCount</span> }
                                    else if (t.Cmp is null) { <span>no rate for @t.Quote.Currency</span> }
                                    else { <span>@Money.Format(t.Cmp.Value, CmpCurrency(t.Quote))</span> }
                                </span>
                            </li>
                        }
                    </ul>
                    <button @onclick="() => SelectLowestTotal(lowest)" disabled="@(_busy || lowest is null)" class="btn btn-secondary btn-sm mt-3">
                        @(lowest is null ? "No complete quote to compare" : "Select " + lowest.Supplier)
                    </button>
                </div>

                <div class="rounded-xl border border-line p-4">
                    <p class="text-sm font-semibold text-ink">Cheapest for each line</p>
                    <p class="mb-3 text-xs text-muted">Every line goes to whoever quoted the lowest price for it (after the line and header discounts), so the order can split across suppliers.</p>
                    @if (bySupplier.Count == 0)
                    {
                        <p class="text-xs text-muted">No line has a quote that can be compared yet.</p>
                    }
                    else
                    {
                        <ul class="space-y-1 text-xs text-muted">
                            @foreach (var x in bySupplier)
                            {
                                <li class="flex justify-between gap-2"><span class="truncate">@x.Supplier</span><span class="tabular-nums">@x.Lines line(s)</span></li>
                            }
                            @if (perLine.Count < openCount)
                            {
                                <li class="text-amber-600">@(openCount - perLine.Count) line(s) have no comparable quote</li>
                            }
                        </ul>
                    }
                    <button @onclick="() => SelectCheapestPerLine(perLine)" disabled="@(_busy || perLine.Count == 0)" class="btn btn-secondary btn-sm mt-3">Select cheapest per line</button>
                </div>
            </div>
            @if (_info is not null)
            {
                <p class="mt-4 text-sm text-emerald-600">@_info</p>
            }
        </div>

        var selectedOpen = OpenLines.Count(l => l.WinningSupplierId.HasValue);
        <div class="mb-6 card p-5 print:hidden">
            <div class="mb-1 flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Draft evaluation</h2>
                @if (selectedOpen > 0) { <StatusChip Label="Draft" Tone="warning" /> }
            </div>
            <p class="mb-3 text-xs text-muted">
                Your selections are kept as you make them, so you can leave this page and come back to change them. Nothing goes to a supplier until you raise the purchase orders.
                @if (_rfq.EvaluationUpdatedAt is { } updated)
                {
                    <span class="text-ink">Last updated @updated.ToString("dd MMM yyyy HH:mm") UTC@(string.IsNullOrEmpty(_rfq.EvaluationUpdatedByName) ? "" : " by " + _rfq.EvaluationUpdatedByName).</span>
                }
            </p>
            <label class="label">Note for the evaluation (optional)</label>
            <textarea @bind="_evaluationNote" rows="2" class="textarea" placeholder="For example: waiting for a better price on the filters, approval from the superintendent needed."></textarea>
            <div class="mt-3 flex flex-wrap items-center gap-3">
                <button @onclick="SaveDraft" disabled="@_busy" class="btn btn-secondary btn-sm">Save draft</button>
                <span class="text-xs text-muted">@selectedOpen of @OpenLines.Count() open lines selected</span>
                @if (_draftInfo is not null) { <span class="text-sm text-emerald-600">@_draftInfo</span> }
            </div>
        </div>
    }

    @* Line comparison *@
    var visibleLines = VisibleLines;
    @if (_rfq.Lines.Count > LinePageSize)
    {
        <div class="mb-3 flex items-center gap-3 print:hidden">
            <input @bind="_lineFilter" @bind:after="() => _linePage = 1" placeholder="Filter lines by code or name…"
                   class="input w-64" />
            <span class="text-sm text-slate-500">@visibleLines.Count of @_rfq.Lines.Count lines</span>
        </div>
    }
    <div class="flex flex-col gap-4">
        @foreach (var line in visibleLines.Skip((_linePage - 1) * LinePageSize).Take(LinePageSize))
        {
            var item = _itemsById.GetValueOrDefault(line.ItemId);
            var isPoRaised = _poItemIds.Contains(line.ItemId);
            <div class="card">
                <div class="flex items-center justify-between border-b border-slate-100 p-4">
                    <div>
                        <p class="font-semibold text-slate-800">@item?.Name</p>
                        <p class="text-xs text-slate-400">@item?.Code &middot; Qty @Money.Qty(line.Quantity) @line.Uom@(string.IsNullOrWhiteSpace(line.DrawingNo) ? "" : " · Drawing " + line.DrawingNo)</p>
                        @if (!string.IsNullOrWhiteSpace(line.Description))
                        {
                            <p class="mt-1 text-xs text-slate-500">@line.Description</p>
                        }
                        @if (_files.ByLine.TryGetValue(line.Id, out var lineFiles))
                        {
                            <div class="mt-2"><AttachmentList Items="lineFiles" Compact="true" /></div>
                        }
                    </div>
                    @if (isPoRaised)
                    {
                        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-600">PO Raised</span>
                    }
                    else if (line.WinningSupplierId.HasValue)
                    {
                        <span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-600">Selected &middot; draft, no PO yet</span>
                    }
                </div>

                <div class="grid grid-cols-1 divide-y divide-slate-50 md:grid-cols-2 md:divide-x md:divide-y-0">
                    @foreach (var supplierId in _rfq.InvitedSupplierIds)
                    {
                        var supplier = _suppliersById.GetValueOrDefault(supplierId);
                        var quote = _quotes.FirstOrDefault(q => q.SupplierId == supplierId);
                        var quoteLine = quote?.Lines.FirstOrDefault(ql => ql.RfqLineId == line.Id);
                        var isWinner = line.WinningSupplierId == supplierId;

                        <div class="p-4">
                            <div class="mb-2 flex items-center justify-between">
                                <p class="text-sm font-medium text-slate-700">@supplier?.Name</p>
                                @if (quote is not null && quoteLine is not null && IsLowest(line.Id, quote, quoteLine))
                                {
                                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-600">Lowest</span>
                                }
                            </div>
                            @if (quote is null || quoteLine is null)
                            {
                                <p class="text-sm text-slate-400">No quote yet</p>
                            }
                            else
                            {
                                <p class="text-lg font-bold text-slate-800">@Money.Format(NetUnit(quoteLine), quote.Currency)</p>
                                <p class="text-xs text-slate-400">
                                    List @Money.Format(quoteLine.UnitPrice, quote.Currency)@(quoteLine.DiscountPct > 0 ? $" less {quoteLine.DiscountPct:0.##}%" : "")
                                    &middot; line total @Money.Format(Money.LineNet(line.Quantity, quoteLine.UnitPrice, quoteLine.DiscountPct), quote.Currency)
                                </p>
                                @if (!string.IsNullOrWhiteSpace(quoteLine.OfferText))
                                {
                                    <p class="mt-1 text-xs italic text-fuchsia-700">Offer: @quoteLine.OfferText</p>
                                }
                                <label class="mt-3 flex items-center gap-2 text-sm @(isPoRaised ? "text-slate-300" : "text-slate-600") print:hidden">
                                    <input type="radio" name="@($"award-{line.Id}")" disabled="@isPoRaised"
                                           checked="@isWinner" @onchange="() => Award(line.Id, supplierId)" />
                                    Select as winner
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (visibleLines.Count > LinePageSize)
    {
        <div class="mt-4 flex items-center justify-between text-xs text-slate-500 print:hidden">
            <span>Showing @((_linePage - 1) * LinePageSize + 1)–@Math.Min(_linePage * LinePageSize, visibleLines.Count) of @visibleLines.Count</span>
            <div class="flex items-center gap-2">
                <button @onclick="() => _linePage--" disabled="@(_linePage <= 1)" class="btn btn-secondary btn-sm">&lsaquo; Prev</button>
                <span>Page @_linePage of @((int)Math.Ceiling(visibleLines.Count / (double)LinePageSize))</span>
                <button @onclick="() => _linePage++" disabled="@(_linePage * LinePageSize >= visibleLines.Count)" class="btn btn-secondary btn-sm">Next &rsaquo;</button>
            </div>
        </div>
    }

    <div class="mt-6 flex items-center gap-3 print:hidden">
        @if (_rfq.Lines.Any(l => l.WinningSupplierId.HasValue && !_poItemIds.Contains(l.ItemId)))
        {
            <button @onclick="RaisePurchaseOrders" class="btn btn-primary">Raise Purchase Order(s)</button>
            <span class="text-sm text-muted">Creates one PO per winning supplier for the awarded lines that have no PO yet.</span>
        }
        else if (_poItemIds.Count > 0)
        {
            <span class="text-sm text-muted">
                @(_rfq.Lines.All(l => _poItemIds.Contains(l.ItemId))
                    ? "Every line of this RFQ now has a purchase order."
                    : "Purchase orders have been raised for every awarded line so far. Award the remaining lines above to raise more.")
            </span>
        }
        else
        {
            <button disabled class="btn btn-primary">Raise Purchase Order(s)</button>
            <span class="text-sm text-muted">Select a winner on at least one line first.</span>
        }
    </div>

    @if (_rfq.Status != RfqStatus.Awarded)
    {
        <div class="mt-8 max-w-2xl card p-4 print:hidden">
            <h2 class="text-sm font-semibold text-ink">Invite more suppliers</h2>
            <p class="mb-3 mt-1 text-xs text-muted">They receive this same RFQ and quote the same lines, so nothing is entered again. Suppliers already on it are greyed out.</p>
            <SupplierPicker CompanyId="_companyId" Selected="_toInvite" Excluded="AlreadyInvited" OnChanged="StateHasChanged" />
            <button @onclick="InviteSelected" disabled="@(_toInvite.Count == 0)"
                    class="mt-3 btn btn-primary btn-sm">
                Send to @_toInvite.Count supplier(s)
            </button>
        </div>
    }

    <div class="mt-8">
        <AuditHistory CompanyId="_companyId" EntityType="@AuditEntityTypes.Rfq" EntityId="_rfq.Id" Version="_auditVersion" />
    </div>
}

@code {
    [Parameter] public int RfqId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private Actor _actor = Actor.System;
    private int _auditVersion;
    private Requisition? _requisition;
    private Rfq? _rfq;
    private List<Quote> _quotes = new();
    private HashSet<int> _poItemIds = new();
    private List<PurchaseOrder> _newlyRaisedPos = new();
    private Dictionary<int, Item> _itemsById = new();
    private Dictionary<int, Supplier> _suppliersById = new();
    private List<Port> _ports = new();
    private IReadOnlyDictionary<int, string> AlreadyInvited => _rfq!.InvitedSupplierIds.ToDictionary(id => id, _ => "Already invited");
    private HashSet<int> _toInvite = new();
    private string? _error;
    private string? _info;
    private RfqFiles _files = RfqFiles.Empty;
    private string? _draftInfo;
    private string _evaluationNote = "";
    private bool _noteLoaded;
    private bool _busy;
    private int _pickSupplier;
    private List<SelectOption<int>> _quotedSupplierOptions = new();
    private Dictionary<string, decimal> _unitsPerUsd = new();

    private const int LinePageSize = 25;
    private string _lineFilter = "";
    private int _linePage = 1;

    private List<RfqLine> VisibleLines
    {
        get
        {
            if (_rfq is null) return new();
            if (string.IsNullOrWhiteSpace(_lineFilter)) return _rfq.Lines;
            var term = _lineFilter.Trim();
            return _rfq.Lines.Where(l =>
            {
                var item = _itemsById.GetValueOrDefault(l.ItemId);
                return item is not null && (item.Code.Contains(term, StringComparison.OrdinalIgnoreCase)
                                            || item.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(authState.User);
        await Load();
    }

    private async Task Load()
    {
        _rfq = await Procurement.GetRfqAsync(_companyId, RfqId);
        if (_rfq is null) return;

        if (!_noteLoaded) { _evaluationNote = _rfq.EvaluationNote; _noteLoaded = true; } // later reloads must not wipe a note being typed
        _requisition = _rfq.RequisitionId.HasValue ? await Requisitions.GetAsync(_companyId, _rfq.RequisitionId.Value) : null;
        _auditVersion++;

        _quotes = await Procurement.GetQuotesForRfqAsync(_companyId, RfqId);
        _files = await Attach.ForRfqAsync(_companyId, RfqId);

        var pos = await Procurement.GetPurchaseOrdersAsync(_companyId);
        _poItemIds = pos.Where(po => po.RfqId == RfqId).SelectMany(po => po.Lines).Select(l => l.ItemId).ToHashSet();

        var items = await Procurement.GetItemsByIdsAsync(_rfq.Lines.Select(l => l.ItemId));
        _itemsById = items.ToDictionary(i => i.Id);

        var suppliers = await Procurement.GetSuppliersByIdsAsync(_rfq.InvitedSupplierIds);
        _suppliersById = suppliers.ToDictionary(s => s.Id);

        _ports = await Procurement.GetPortsAsync();

        _unitsPerUsd = (await FxSvc.GetRatesAsync(_companyId, _quotes.Select(q => q.Currency))).ToDictionary(r => r.Key, r => r.Value.UnitsPerUsd);
        _quotedSupplierOptions = _rfq.InvitedSupplierIds.Where(id => _quotes.Any(q => q.SupplierId == id))
            .Select(id => new SelectOption<int>(id, _suppliersById.GetValueOrDefault(id)?.Name ?? "Supplier " + id)).ToList();
        if (_pickSupplier != 0 && _quotedSupplierOptions.All(o => o.Value != _pickSupplier)) _pickSupplier = 0;

        _toInvite.Clear();
    }

    private static string Date(DateTime? d) => d.HasValue ? d.Value.ToString("MMM d, yyyy") : "—";

    private string? PortLabel()
    {
        var port = _ports.FirstOrDefault(p => p.Id == _rfq?.DeliveryPortId);
        return port is null ? null : $"{port.Name}, {port.Country}";
    }

    private static decimal NetUnit(QuoteLine ql) => Money.Round(ql.UnitPrice * (1 - ql.DiscountPct / 100m));

    // ---- Comparing quotes (used by "Lowest" and the quick-select options) ----

    private IEnumerable<RfqLine> OpenLines => _rfq is null ? Enumerable.Empty<RfqLine>() : _rfq.Lines.Where(l => !_poItemIds.Contains(l.ItemId));

    /// <summary>True when every quote is in the same currency, so amounts compare as they are.</summary>
    private bool _singleCurrency => _quotes.Select(q => q.Currency).Distinct().Count() <= 1;

    private string CmpCurrency(Quote quote) => _singleCurrency ? quote.Currency : "USD";

    /// <summary>The amount in US dollars (or as it is when all quotes share a currency). Null when there is no exchange rate for it.</summary>
    private decimal? Cmp(string currency, decimal amount)
    {
        if (_singleCurrency) return amount;
        return _unitsPerUsd.TryGetValue(currency, out var rate) && rate > 0 ? amount / rate : null;
    }

    private QuoteLine? QuoteLineFor(int supplierId, int rfqLineId) =>
        _quotes.FirstOrDefault(q => q.SupplierId == supplierId)?.Lines.FirstOrDefault(l => l.RfqLineId == rfqLineId);

    /// <summary>What one unit really costs: the line discount, then the supplier's header discount.</summary>
    private decimal? EffectiveUnit(Quote quote, QuoteLine quoteLine) =>
        Cmp(quote.Currency, quoteLine.UnitPrice * (1 - quoteLine.DiscountPct / 100m) * (1 - quote.DiscountPct / 100m));

    private record TotalRow(Quote Quote, string Supplier, int Quoted, bool Complete, decimal? Cmp);

    /// <summary>Each supplier's total for the lines that still have no PO (header discount and charges included).</summary>
    private List<TotalRow> TotalRows
    {
        get
        {
            var open = OpenLines.ToList();
            return _rfq!.InvitedSupplierIds
                .Select(id => _quotes.FirstOrDefault(q => q.SupplierId == id))
                .Where(q => q is not null)
                .Select(q =>
                {
                    var quoted = open.Count(l => q!.Lines.Any(ql => ql.RfqLineId == l.Id));
                    var subtotal = open.Sum(l => q!.Lines.FirstOrDefault(ql => ql.RfqLineId == l.Id) is { } ql ? Money.LineNet(l.Quantity, ql.UnitPrice, ql.DiscountPct) : 0m);
                    var total = Money.GrandTotal(subtotal, q!.DiscountPct, q.AdditionalCharges);
                    return new TotalRow(q, _suppliersById.GetValueOrDefault(q.SupplierId)?.Name ?? "", quoted, quoted == open.Count, Cmp(q.Currency, total));
                })
                .ToList();
        }
    }

    /// <summary>The cheapest comparable quote for each open line (the first invited supplier wins a tie).</summary>
    private Dictionary<int, int> BestPerLine()
    {
        var best = new Dictionary<int, int>();
        foreach (var line in OpenLines)
        {
            decimal? lowest = null;
            foreach (var supplierId in _rfq!.InvitedSupplierIds)
            {
                var quote = _quotes.FirstOrDefault(q => q.SupplierId == supplierId);
                var ql = quote is null ? null : QuoteLineFor(supplierId, line.Id);
                var price = quote is null || ql is null ? null : EffectiveUnit(quote, ql);
                if (price is null) continue;
                if (lowest is null || price < lowest) { lowest = price; best[line.Id] = supplierId; }
            }
        }
        return best;
    }

    /// <summary>Lowest effective unit price among the quotes that can be compared (needs at least two).</summary>
    private bool IsLowest(int rfqLineId, Quote quote, QuoteLine quoteLine)
    {
        var comparable = _quotes
            .Select(q => (Quote: q, Line: q.Lines.FirstOrDefault(l => l.RfqLineId == rfqLineId)))
            .Where(x => x.Line is not null)
            .Select(x => EffectiveUnit(x.Quote, x.Line!))
            .Where(p => p is not null)
            .ToList();
        var mine = EffectiveUnit(quote, quoteLine);
        return comparable.Count >= 2 && mine is not null && mine == comparable.Min();
    }

    private async Task RunQuickSelect(Func<Task<string>> action)
    {
        _error = null;
        _info = null;
        _busy = true;
        try
        {
            _info = await action();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
        await Load();
    }

    private async Task SaveDraft()
    {
        _error = null;
        _draftInfo = null;
        _busy = true;
        try
        {
            _draftInfo = await Procurement.SaveEvaluationDraftAsync(_companyId, RfqId, _evaluationNote, _actor);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
        var saved = _draftInfo;
        await Load();
        _draftInfo = saved;
    }

    private Task SelectOneSupplier() => RunQuickSelect(async () =>
    {
        var name = _suppliersById.GetValueOrDefault(_pickSupplier)?.Name ?? "the supplier";
        var map = OpenLines.Where(l => QuoteLineFor(_pickSupplier, l.Id) is not null).ToDictionary(l => l.Id, _ => _pickSupplier);
        var n = await Procurement.AwardLinesAsync(_companyId, RfqId, map, _actor, $"all lines to {name}");
        return $"{name} selected on {n} line(s).";
    });

    private Task SelectLowestTotal(TotalRow? lowest) => RunQuickSelect(async () =>
    {
        if (lowest is null) return "No complete quote to compare.";
        var map = OpenLines.ToDictionary(l => l.Id, _ => lowest.Quote.SupplierId);
        var n = await Procurement.AwardLinesAsync(_companyId, RfqId, map, _actor, $"lowest total quote, {lowest.Supplier}");
        return $"{lowest.Supplier} selected on {n} line(s) (lowest total quote).";
    });

    private Task SelectCheapestPerLine(Dictionary<int, int> perLine) => RunQuickSelect(async () =>
    {
        var n = await Procurement.AwardLinesAsync(_companyId, RfqId, perLine, _actor, "cheapest quote for each line");
        var suppliers = perLine.Values.Distinct().Count();
        return $"Cheapest quote selected on {n} line(s) across {suppliers} supplier(s).";
    });

    private Task ClearAll() => RunQuickSelect(async () =>
    {
        var n = await Procurement.ClearAwardsAsync(_companyId, RfqId, _actor);
        return $"Cleared the selection on {n} line(s).";
    });

