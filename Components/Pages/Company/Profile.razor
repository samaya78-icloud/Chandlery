@page "/company/profile"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject ProcurementService Procurement
@inject HelpService Help

<PageTitle>Company Profile · Chandlery</PageTitle>

<PageHeader Eyebrow="Master data" Title="Company Profile" Subtitle="Manage your company's details." />

@if (_company is null)
{
    <p class="text-sm text-slate-500">Loading…</p>
}
else
{
    <div class="max-w-xl card p-6">
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Company Name</label>
            <input @bind="_name" class="input" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Registration Number</label>
            <input @bind="_registrationNumber" class="input" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Address</label>
            <textarea @bind="_address" rows="2" class="input"></textarea>
        </div>
        <div class="mb-5">
            <label class="mb-1 block text-sm font-medium text-slate-700">Contact Email</label>
            <input @bind="_contactEmail" type="email" class="input" />
        </div>

        <div class="mb-5 rounded-xl border border-line bg-surface-2 p-3">
            <label class="flex items-start gap-3 text-sm">
                <input type="checkbox" class="mt-1" @bind="_helpOn" />
                <span>
                    <span class="font-medium text-ink">Help assistant</span>
                    <span class="block text-muted">Lets your office users ask questions about the page they are on. @(Help.UsesAi ? "Only the page name and the question are sent; no company data." : "This server has no AI key, so it answers from the built-in help for each module; nothing is sent anywhere.")</span>
                </span>
            </label>
        </div>

        @if (_saved)
        {
            <div class="mb-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">Saved.</div>
        }

        <button @onclick="Save" class="btn btn-primary">
            Save changes
        </button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Company? _company;
    private string _name = "";
    private string? _registrationNumber;
    private string? _address;
    private string _contactEmail = "";
    private bool _saved;
    private bool _helpOn = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = Guid.Parse(authState.User.FindFirst("CompanyId")!.Value);

        _company = await Procurement.GetCompanyAsync(_companyId);
        if (_company is not null)
        {
            _name = _company.Name;
            _registrationNumber = _company.RegistrationNumber;
            _address = _company.Address;
            _contactEmail = _company.ContactEmail;
            _helpOn = _company.HelpAssistantEnabled;
        }
    }

    private async Task Save()
    {
        await Procurement.UpdateCompanyAsync(_companyId, _name, _registrationNumber, _address, _contactEmail);
        await Help.SetEnabledAsync(_companyId, _helpOn);
        _saved = true;
    }
}
