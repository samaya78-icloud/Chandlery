@page "/company/profile"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject ProcurementService Procurement

<PageTitle>Company Profile · Chandlery</PageTitle>

<PageHeader Eyebrow="Admin" Title="Company Profile" Subtitle="Manage your company's details." />

@if (_company is null)
{
    <p class="text-sm text-slate-500">Loading…</p>
}
else
{
    <div class="max-w-xl card p-6">
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Company Name</label>
            <input @bind="_name" class="input" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Registration Number</label>
            <input @bind="_registrationNumber" class="input" />
        </div>
        <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Address</label>
            <textarea @bind="_address" rows="2" class="input"></textarea>
        </div>
        <div class="mb-5">
            <label class="mb-1 block text-sm font-medium text-slate-700">Contact Email</label>
            <input @bind="_contactEmail" type="email" class="input" />
        </div>

        @if (_saved)
        {
            <div class="mb-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">Saved.</div>
        }

        <button @onclick="Save" class="btn btn-primary">
            Save changes
        </button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private Company? _company;
    private string _name = "";
    private string? _registrationNumber;
    private string? _address;
    private string _contactEmail = "";
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);

        _company = await Procurement.GetCompanyAsync(_companyId);
        if (_company is not null)
        {
            _name = _company.Name;
            _registrationNumber = _company.RegistrationNumber;
            _address = _company.Address;
            _contactEmail = _company.ContactEmail;
        }
    }

    private async Task Save()
    {
        await Procurement.UpdateCompanyAsync(_companyId, _name, _registrationNumber, _address, _contactEmail);
        _saved = true;
    }
}
