@page "/company/approval-matrix"
@attribute [Authorize(Roles = "CompanyAdmin")]
@rendermode InteractiveServer
@inject ApprovalService Approvals
@inject ProcurementService Procurement

<PageTitle>Approval Matrix · Chandlery</PageTitle>

<PageHeader Eyebrow="Admin" Title="Approval Matrix"
            Subtitle="Decides who must approve each purchase order. A PO uses the rules of its department (or the 'All departments' rules when its department has none), picks the smallest amount limit that covers its total, and needs one approver at each step, in order. Name the steps below (for example 'Superintendent review') and the names show everywhere approvals appear. Limits are in US dollars: an order or invoice in another currency is converted at that day's exchange rate before it is compared (see Exchange Rates). With no rules at all, POs are approved automatically." />

@if (_loaded)
{
    @if (_rules.Count == 0)
    {
        <div class="mb-6"><EmptyState Title="No rules yet" Message="Purchase orders are approved automatically until you add the first rule below." /></div>
    }
    else
    {
        <div class="mb-6">
            <DataGrid TItem="ApprovalRuleRow" Items="_rules" ItemName="rules" EmptyText="No rules match these filters.">
                <GridColumn Title="Department" Text="r => r.Department" Filter="GridFilter.Select" CellClass="font-medium text-slate-800" />
                <GridColumn Title="Up to amount (USD)" Text="r => UpToText(r)" Filter="GridFilter.Select" />
                <GridColumn Title="Step" Text="r => StepText(r)" Filter="GridFilter.Select" />
                <GridColumn Title="Approver" Text="r => r.Approver" Filter="GridFilter.Select" />
                <GridColumn Title="" Filter="GridFilter.None" CellClass="text-right" Context="row">
                    <button @onclick="() => Delete(row.Rule.Id)" class="text-xs font-medium text-rose-600 hover:text-rose-700">Delete</button>
                </GridColumn>
            </DataGrid>
        </div>
    }

    <div class="mb-6 max-w-3xl card p-6">
        <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-400">Name the approval steps</h2>
        <p class="mb-4 text-xs text-slate-400">Approvals happen in order: step 1, then 2, then 3. Give each a name your team recognises. Leave a box empty to use the default shown in grey.</p>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            @for (var i = 0; i < 3; i++)
            {
                var index = i;
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Step @(index + 1)</label>
                    <input @bind="_stepNames[index]" maxlength="@ApprovalLevelNames.MaxLength" placeholder="@ApprovalLevelNames.Default(index + 1)" class="@InputClass" />
                </div>
            }
        </div>
        <button @onclick="SaveNames" class="mt-4 btn btn-secondary">Save names</button>
    </div>

    <div class="mb-6 max-w-3xl card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-400">Add a rule</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Department</label>
                <SelectBox TValue="int" @bind-Value="_departmentId" Options="_deptOptions" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Up to amount (USD)</label>
                <input @bind="_upTo" placeholder="empty = no limit" class="@InputClass" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Step</label>
                <SelectBox TValue="int" @bind-Value="_level" Options="StepOptions" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Approver</label>
                <SelectBox TValue="int" @bind-Value="_approverId" Options="_userOptions" Placeholder="Select…" SearchPlaceholder="Search people…" />
            </div>
        </div>
        <p class="mt-3 text-xs text-slate-400">Several approvers on the same step and amount limit are alternatives: any one of them can approve that step.</p>
        <button @onclick="AddRule" class="mt-4 btn btn-primary">Add rule</button>
    </div>

    <div class="mb-6 max-w-3xl card p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-400">Copy a department's rules</h2>
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">From</label>
                <SelectBox TValue="int" @bind-Value="_copyFrom" Options="_deptOptions" Class="min-w-56" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">To (must have no rules yet)</label>
                <SelectBox TValue="int" @bind-Value="_copyTo" Options="_deptOptions" Class="min-w-56" />
            </div>
            <button @onclick="Copy" class="btn btn-secondary">Copy rules</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="max-w-3xl rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="max-w-3xl rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700">@_message</div>
    }
}

@code {
    private const string InputClass = "input";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _companyId;
    private bool _loaded;
    private List<ApprovalRuleRow> _rules = new();
    private List<Department> _departments = new();
    private List<AppUser> _users = new();
    private List<SelectOption<int>> _deptOptions = new(), _userOptions = new();

    private List<SelectOption<int>> StepOptions => Enumerable.Range(1, 3).Select(l => new SelectOption<int>(l, _levelNames.Name(l))).ToList();
    private ApprovalLevelNames _levelNames = new(new string?[3]);
    private string[] _stepNames = new string[3] { "", "", "" };

    private int _departmentId, _level = 1, _approverId, _copyFrom, _copyTo;
    private string _upTo = "";
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        _companyId = int.Parse(authState.User.FindFirst("CompanyId")!.Value);
        _departments = await Procurement.GetDepartmentsAsync(_companyId);
        _users = await Procurement.GetCompanyUsersAsync(_companyId);
        _deptOptions = new List<SelectOption<int>> { new(0, "All departments") }.Concat(SelectOptions.From(_departments, d => d.Id, d => d.Name)).ToList();
        _userOptions = SelectOptions.From(_users, u => u.Id, u => u.DisplayName, u => u.Email);
        await Reload();
        _loaded = true;
    }

    private static string UpToText(ApprovalRuleRow row) => row.Rule.UpToAmount.HasValue ? row.Rule.UpToAmount.Value.ToString("N2") : "No limit";

    private async Task Reload()
    {
        _rules = await Approvals.GetRulesAsync(_companyId);
        _levelNames = await Approvals.GetLevelNamesAsync(_companyId);
        _stepNames = _levelNames.Raw();
    }

    private string StepText(ApprovalRuleRow row) => _levelNames.Name(row.Rule.Level);

    private async Task SaveNames()
    {
        _error = _message = null;
        try
        {
            await Approvals.SetLevelNamesAsync(_companyId, _stepNames);
            await Reload();
            _message = "Step names saved.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task AddRule()
    {
        _error = _message = null;

        decimal? upTo = null;
        if (!string.IsNullOrWhiteSpace(_upTo))
        {
            if (!decimal.TryParse(_upTo.Replace(",", ""), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                _error = "The amount isn't a number.";
                return;
            }
            upTo = parsed;
        }

        try
        {
            await Approvals.AddRuleAsync(_companyId, _departmentId == 0 ? null : _departmentId, upTo, _level, _approverId);
            await Reload();
            _message = "Rule added.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task Delete(int ruleId)
    {
        _error = _message = null;
        await Approvals.DeleteRuleAsync(_companyId, ruleId);
        await Reload();
    }

    private async Task Copy()
    {
        _error = _message = null;
        try
        {
            var copied = await Approvals.CopyRulesAsync(_companyId, _copyFrom == 0 ? null : _copyFrom, _copyTo == 0 ? null : _copyTo);
            await Reload();
            _message = $"Copied {copied} rule(s).";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }
}
