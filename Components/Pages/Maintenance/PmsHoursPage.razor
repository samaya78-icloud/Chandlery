@page "/pms/hours"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@inject PmsService Svc

<PageTitle>Running hours · Chandlery</PageTitle>

<PageHeader Eyebrow="@(NodeContext.Current.IsVessel ? "Vessel" : "Fleet")" Title="Running hours"
            Subtitle="Read each hour meter and enter it here, ideally every day. Jobs driven by running hours are projected from these readings. A wrong reading is never edited: enter the right figure as a correction.">
    <Actions>
        <a href="/pms" class="btn btn-secondary">Back to the plan</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else if (_vessels.Count == 0)
{
    <EmptyState Title="Planned maintenance is switched off" Message="The module has not been switched on for this vessel." />
}
else
{
    @if (_vessels.Count > 1)
    {
        <div class="card mb-5 p-4 text-sm">
            <label>Vessel
                <select class="select mt-1" @bind="_vesselId" @bind:after="LoadAsync">
                    @foreach (var v in _vessels) { <option value="@v.Id">@v.Name</option> }
                </select>
            </label>
        </div>
    }

    @if (_meters.Count == 0)
    {
        <EmptyState Title="No hour meters" Message="Mark machinery as having an hour meter under Machinery, then its readings are entered here." />
    }

    <div class="space-y-3">
        @foreach (var m in _meters)
        {
            var latest = _latest.GetValueOrDefault(m.Id);
            var row = Row(m.Id);
            var age = latest is null ? (int?)null : (_today - latest.ReadingDate.Date).Days;
            <div class="card p-4">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                    <div class="min-w-[12rem] flex-1">
                        <p class="font-medium text-ink">@m.Name@(m.IsCritical ? " ·" : "") @if (m.IsCritical) { <span class="chip" data-tone="danger">critical</span> }</p>
                        <p class="text-xs @(age is null or > 7 ? "text-amber-700" : "text-muted")">
                            @(latest is null ? "No reading yet" : $"Last: {latest.Hours:N1} h on {latest.ReadingDate:dd MMM yyyy} ({(age == 0 ? "today" : age + " days ago")})")
                        </p>
                    </div>
                    <input type="date" class="input w-40" @bind="row.Date" />
                    <input type="number" step="0.1" min="0" class="input w-32" placeholder="hours" @bind="row.Hours" />
                    <label class="flex items-center gap-1 text-xs text-muted"><input type="checkbox" @bind="row.Correction" /> correction</label>
                    <button class="btn btn-primary btn-sm" @onclick="() => SaveAsync(m.Id)">Save</button>
                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleHistoryAsync(m.Id)">@(row.ShowHistory ? "Hide" : "History")</button>
                </div>
                @if (row.Error is not null) { <p class="mt-2 text-sm text-rose-700">@row.Error</p> }
                @if (row.Saved) { <p class="mt-2 text-sm text-emerald-700">Saved. Jobs on this machinery have been worked out again.</p> }
                @if (row.ShowHistory)
                {
                    <table class="mt-3 w-full text-left text-xs">
                        <thead><tr class="border-b border-line text-muted"><th class="py-1 font-medium">Date</th><th class="py-1 text-right font-medium">Hours</th><th class="py-1 font-medium">Entered by</th><th class="py-1 font-medium">Note</th></tr></thead>
                        <tbody>
                        @foreach (var r in row.History)
                        {
                            <tr class="border-b border-line/50"><td class="py-1">@r.ReadingDate.ToString("dd MMM yyyy")</td><td class="py-1 text-right">@r.Hours.ToString("N1")</td>
                                <td class="py-1">@r.AuthorName @(r.IsCorrection ? "· correction" : "")</td><td class="py-1 text-muted">@r.Note</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class RowState
    {
        public DateTime? Date = DateTime.UtcNow.Date;
        public decimal? Hours;
        public bool Correction, ShowHistory, Saved;
        public string? Error;
        public List<RunningHoursReading> History = [];
    }

    private Guid _companyId, _vesselId;
    private Actor _actor = Actor.System;
    private bool _loaded;
    private DateTime _today = DateTime.UtcNow.Date;
    private List<(Guid Id, string Name)> _vessels = [];
    private List<MachineryItem> _meters = [];
    private Dictionary<Guid, RunningHoursReading> _latest = [];
    private readonly Dictionary<Guid, RowState> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _vessels = await Svc.EnabledVesselsAsync(_companyId);
        if (_vessels.Count > 0) _vesselId = _vessels[0].Id;
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        if (_vesselId == Guid.Empty) return;
        _today = DateTime.UtcNow.Date;
        _meters = (await Svc.ListMachineryAsync(_companyId, _vesselId)).Where(m => m.HasHourMeter).ToList();
        _latest = await Svc.LatestReadingsAsync(_companyId, _vesselId);
    }

    private RowState Row(Guid id) => _rows.TryGetValue(id, out var r) ? r : _rows[id] = new RowState();

    private async Task SaveAsync(Guid itemId)
    {
        var row = Row(itemId);
        row.Error = null; row.Saved = false;
        try
        {
            if (row.Date is null || row.Hours is null) throw new InvalidOperationException("Enter the date and the hours shown on the meter.");
            await Svc.RecordReadingAsync(_companyId, itemId, row.Date.Value, row.Hours.Value, row.Correction, "", _actor);
            row.Saved = true; row.Hours = null; row.Correction = false;
            _latest = await Svc.LatestReadingsAsync(_companyId, _vesselId);
            if (row.ShowHistory) row.History = await Svc.ReadingsAsync(_companyId, itemId);
        }
        catch (InvalidOperationException ex) { row.Error = ex.Message; }
    }

    private async Task ToggleHistoryAsync(Guid itemId)
    {
        var row = Row(itemId);
        row.ShowHistory = !row.ShowHistory;
        if (row.ShowHistory) row.History = await Svc.ReadingsAsync(_companyId, itemId);
    }
}
