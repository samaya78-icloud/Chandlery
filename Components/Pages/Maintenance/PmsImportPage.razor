@page "/pms/import"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@using System.Text
@inject PmsService Pms
@inject PmsImportService Importer

<PageTitle>Import a plan · Chandlery</PageTitle>

<PageHeader Eyebrow="@(NodeContext.Current.IsVessel ? "Vessel" : "Fleet")" Title="Import a maintenance plan"
            Subtitle="Bring an existing plan from a spreadsheet. Check how the columns are read, see what would be added, then import. Nothing already on the plan is changed, and the whole file goes in or none of it.">
    <Actions>
        <a href="/samples/pms-plan-sample.csv" download class="btn btn-secondary">Sample file</a>
        <a href="/pms/machinery" class="btn btn-secondary">Machinery</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <Skeleton Rows="3" />
}
else if (_vessels.Count == 0)
{
    <EmptyState Title="Planned maintenance is switched off" Message="The module has not been switched on for this vessel." />
}
else
{
    @if (_error is not null) { <div class="mb-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">@_error</div> }

    @if (_result is not null)
    {
        <div class="card mb-6 p-5 text-sm">
            <h2 class="font-display text-lg font-extrabold text-ink">Imported</h2>
            <p class="mt-1">Added <b>@_result.JobsAdded</b> job(s) (@_result.FromLibrary from the library, @_result.OwnJobs of the vessel's own) and <b>@_result.MachineryAdded</b> machinery item(s), with <b>@_result.HistoryRecorded</b> earlier completion(s) kept as read-only history.@(_result.Skipped > 0 ? $" {_result.Skipped} already on the plan were skipped." : "")</p>
            @if (_result.Problems.Count > 0)
            {
                <ul class="mt-2 list-disc pl-5 text-xs text-amber-800">@foreach (var p in _result.Problems.Take(20)) { <li>@p</li> }</ul>
            }
            <p class="mt-3"><a href="/pms" class="btn btn-primary btn-sm">Open the plan</a> <a href="/pms/import" class="btn btn-secondary btn-sm" @onclick="Reset">Import another file</a></p>
        </div>
    }
    else
    {
        <div class="card mb-6 p-5 text-sm">
            <h2 class="font-display text-lg font-extrabold text-ink">1. The file</h2>
            @if (_vessels.Count > 1)
            {
                <label class="mt-2 block">Import onto
                    <select class="select mt-1 max-w-xs" @bind="_vesselId" @bind:after="PreviewAsync">
                        @foreach (var v in _vessels) { <option value="@v.Id">@v.Name</option> }
                    </select>
                </label>
            }
            <label class="mt-3 block">Excel (.xlsx) or CSV file, with a header row
                <InputFile OnChange="OnFileAsync" accept=".csv,.xlsx" class="mt-1 block text-sm" />
            </label>
            <p class="mt-1 text-xs text-muted">Up to @PmsImportFile.MaxRows.ToString("N0") rows. Dates are read day first (05/03/2026) or as 2026-03-05. An interval can be "3 months", "500 hrs", "Annual" or "6 months / 4000 hrs".</p>
            @if (_table is not null) { <p class="mt-2">@_fileName: <b>@_table.Rows.Count.ToString("N0")</b> row(s), @_table.Headers.Count columns.</p> }
        </div>

        @if (_table is not null)
        {
            <div class="card mb-6 p-5 text-sm">
                <h2 class="font-display text-lg font-extrabold text-ink">2. Which column is which</h2>
                <p class="mb-3 text-xs text-muted">Guessed from the headings; change any that are wrong. A job needs its machinery (location, system or equipment), a code, a title and an interval.</p>
                <div class="grid gap-3 md:grid-cols-3">
                    @foreach (var f in Fields)
                    {
                        <label>@Label(f)
                            <select class="select mt-1" value="@_mapping.Of(f)" @onchange="e => MapAsync(f, e.Value)">
                                <option value="-1">Not in the file</option>
                                @for (var i = 0; i < _table.Headers.Count; i++) { <option value="@i">@_table.Headers[i]</option> }
                            </select>
                        </label>
                    }
                </div>
            </div>
        }

        @if (_plan is not null)
        {
            <div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4 xl:grid-cols-6">
                <StatCard Label="Rows" Value="@_plan.Rows.Count.ToString("N0")" />
                <StatCard Label="Ready" Value="@_plan.Valid.ToString("N0")" Tone="success" />
                <StatCard Label="With problems" Value="@_plan.Invalid.ToString("N0")" Tone="@(_plan.Invalid > 0 ? "danger" : "success")" Hint="Left out" />
                <StatCard Label="New machinery" Value="@_plan.NewMachinery.ToString("N0")" />
                <StatCard Label="Library matches" Value="@_plan.WithLibraryMatch.ToString("N0")" Tone="info" />
                <StatCard Label="Already there" Value="@_plan.AlreadyOnPlan.ToString("N0")" Hint="Skipped" />
            </div>

            @if (_plan.HoursJobs > 0)
            {
                <p class="mb-4 rounded-lg bg-sky-50 px-3 py-2 text-xs text-sky-900 dark:bg-sky-500/10 dark:text-sky-100">@_plan.HoursJobs.ToString("N0") job(s) run on running hours. Their due date is worked out once running-hours readings are entered under Running hours; until then they show as having no schedule (a job with a calendar interval as well is due by the calendar meanwhile).</p>
            }

            <div class="card mb-6 p-5 text-sm">
                <h2 class="font-display text-lg font-extrabold text-ink">3. Library jobs</h2>
                <p class="mb-2 text-xs text-muted">Where a library job matches (same code, same title, or a very similar title), the job can be made from the library, so it follows library updates. Otherwise it is the vessel's own.</p>
                <div class="flex flex-wrap gap-4">
                    <label class="flex items-center gap-2"><input type="radio" name="match" checked="@(_mode == MatchMode.Confident)" @onchange="() => _mode = MatchMode.Confident" /> Same code or same title only</label>
                    <label class="flex items-center gap-2"><input type="radio" name="match" checked="@(_mode == MatchMode.All)" @onchange="() => _mode = MatchMode.All" /> Include similar titles</label>
                    <label class="flex items-center gap-2"><input type="radio" name="match" checked="@(_mode == MatchMode.None)" @onchange="() => _mode = MatchMode.None" /> Never: keep them all as the vessel's own</label>
                </div>
                <p class="mt-2 text-xs text-muted">With this choice @_plan.Rows.Count(r => r.IsValid && UseTemplate(r)) job(s) come from the library; the rest are the vessel's own.</p>
            </div>

            <div class="card mb-6 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead><tr class="border-b border-line text-xs uppercase tracking-wide text-muted">
                        <th class="px-3 py-2 font-medium">Line</th><th class="px-3 py-2 font-medium">Machinery</th><th class="px-3 py-2 font-medium">Job</th><th class="px-3 py-2 font-medium">Every</th>
                        <th class="px-3 py-2 font-medium">Last done</th><th class="px-3 py-2 font-medium">Library</th><th class="px-3 py-2 font-medium">Notes</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var r in _plan.Rows.OrderBy(r => r.IsValid).ThenBy(r => r.Line).Take(60))
                    {
                        <tr class="border-b border-line/60 align-top @(r.IsValid ? "" : "bg-rose-50/40 dark:bg-rose-500/5")">
                            <td class="px-3 py-2 text-xs text-muted">@r.Line</td>
                            <td class="px-3 py-2 text-xs">@r.PathText</td>
                            <td class="px-3 py-2"><span class="font-mono text-xs font-semibold">@r.Code</span> @r.Title</td>
                            <td class="px-3 py-2 whitespace-nowrap text-xs">@Every(r)</td>
                            <td class="px-3 py-2 whitespace-nowrap text-xs">@(r.LastDoneDate?.ToString("dd MMM yyyy") ?? "–")@(r.LastDoneHours is { } h ? $" · {h:N0} h" : "")</td>
                            <td class="px-3 py-2 text-xs">@if (r.Match is not null) { <span class="chip chip-plain" data-tone="@(UseTemplate(r) ? "success" : "neutral")">@r.Match.Code · @(r.MatchKind switch { MatchKind.Code => "same code", MatchKind.Title => "same title", _ => "similar" })</span> }</td>
                            <td class="px-3 py-2 text-xs">
                                @foreach (var e in r.Errors) { <div class="text-rose-700">@e</div> }
                                @foreach (var w in r.Warnings) { <div class="text-amber-700">@w</div> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                @if (_plan.Rows.Count > 60) { <p class="px-4 py-2 text-xs text-muted">Showing the rows with problems first, then the others, 60 in all of @_plan.Rows.Count.ToString("N0").</p> }
            </div>

            <div class="flex items-center gap-3">
                <button class="btn btn-primary" disabled="@(_plan.Valid == 0 || _busy)" @onclick="ImportAsync">@(_busy ? "Importing…" : $"Import {_plan.Valid - _plan.AlreadyOnPlan:N0} job(s)")</button>
                @if (_plan.Invalid > 0) { <span class="text-xs text-muted">@_plan.Invalid row(s) with problems are left out. Fix them in the file and import it again: what is already there is skipped.</span> }
            </div>
        }
    }
}

@code {
    private enum MatchMode { Confident, All, None }

    private static readonly ImportField[] Fields = [ImportField.Location, ImportField.System, ImportField.SubSystem, ImportField.Equipment, ImportField.JobCode, ImportField.JobTitle, ImportField.Interval,
        ImportField.LastDoneDate, ImportField.LastDoneHours, ImportField.Critical, ImportField.Department, ImportField.Instructions];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId, _vesselId;
    private Actor _actor = Actor.System;
    private bool _loaded, _busy;
    private string? _error, _fileName;
    private List<(Guid Id, string Name)> _vessels = [];
    private ImportTable? _table;
    private ImportMapping _mapping = new();
    private ImportPlan? _plan;
    private ImportResult? _result;
    private MatchMode _mode = MatchMode.Confident;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _vessels = await Pms.EnabledVesselsAsync(_companyId);
        if (_vessels.Count > 0) _vesselId = _vessels[0].Id;
        _loaded = true;
    }

    private static string Label(ImportField f) => f switch
    {
        ImportField.Location => "Location", ImportField.System => "System", ImportField.SubSystem => "Sub-system", ImportField.Equipment => "Equipment", ImportField.JobCode => "Job code",
        ImportField.JobTitle => "Job", ImportField.Interval => "Interval", ImportField.LastDoneDate => "Last done (date)", ImportField.LastDoneHours => "Running hours at last done",
        ImportField.Critical => "Critical", ImportField.Department => "Department", _ => "Checklist or notes",
    };

    private bool UseTemplate(ImportRow r) => r.Match is not null && _mode switch
    {
        MatchMode.All => true, MatchMode.Confident => r.MatchKind is MatchKind.Code or MatchKind.Title, _ => false,
    };

    private static string Every(ImportRow r)
    {
        var parts = new List<string>();
        if (r.CalendarInterval is > 0) parts.Add($"{r.CalendarInterval} {r.CalendarUnit.ToString().ToLowerInvariant()}");
        if (r.HoursInterval is > 0) parts.Add($"{r.HoursInterval:N0} h");
        return string.Join(" / ", parts);
    }

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        _error = null; _plan = null; _table = null; _result = null;
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024) { _error = "That file is larger than 10 MB."; return; }
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;
            _table = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ? PmsImportFile.ReadXlsx(stream) : PmsImportFile.ReadCsv(Encoding.UTF8.GetString(stream.ToArray()));
            _fileName = file.Name;
            if (_table.Headers.Count == 0 || _table.Rows.Count == 0) { _error = "The file has no rows to import."; _table = null; return; }
            _mapping = PmsImportColumns.Suggest(_table.Headers);
            await PreviewAsync();
        }
        catch (Exception ex) when (ex is InvalidDataException or IOException or InvalidOperationException or ArgumentException)
        {
            _error = "That file could not be read. Use an Excel .xlsx or a CSV file."; _table = null;
        }
    }

    private async Task MapAsync(ImportField field, object? value)
    {
        _mapping = _mapping.With(field, int.TryParse(value?.ToString(), out var i) ? i : -1);
        await PreviewAsync();
    }

    private async Task PreviewAsync()
    {
        _error = null;
        if (_table is null) return;
        try { _plan = await Importer.PreviewAsync(_companyId, _vesselId, _table, _mapping); }
        catch (InvalidOperationException ex) { _error = ex.Message; _plan = null; }
    }

    private async Task ImportAsync()
    {
        _error = null; _busy = true;
        try { _result = await Importer.ApplyAsync(_companyId, _vesselId, _plan!.Rows, UseTemplate, _actor); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void Reset() { _table = null; _plan = null; _result = null; _fileName = null; _error = null; }
}
