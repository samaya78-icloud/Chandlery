@page "/projects/{ProjectId:guid}"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@attribute [VesselAllowed]
@rendermode InteractiveServer
@inject ProjectService Svc
@inject ToastService Toasts

<PageTitle>@(_detail?.Project.Code ?? "Project") · Chandlery</PageTitle>

@if (!_loaded)
{
    <Skeleton Rows="6" />
}
else if (_detail is null)
{
    <EmptyState Title="Project not found" Message="It may belong to another company, or the module may be switched off.">
        <Action><a href="/projects" class="btn btn-secondary">Back to projects</a></Action>
    </EmptyState>
}
else
{
    var p = _detail.Project;
    var editable = ProjectStatusRules.IsEditable(_detail.Status);
    var canEdit = _mayManage && editable;
    <PageHeader Eyebrow="@p.Code" Title="@p.Title">
        <Badges>
            <StatusChip Value="_detail.Status" />
            <StatusChip Label="@(p.Type == ProjectType.Drydock ? "Drydock" : "Technical project")" Tone="accent" />
            @if (p.IsUwild) { <StatusChip Label="UWILD" Tone="info" /> }
        </Badges>
        <Facts>
            @if (_onVessel) { <span>@_vesselName</span> } else { <DocLink Kind="DocKind.Vessel" Id="p.VesselId" Text="@_vesselName" /> }
            @if (p.SuperintendentName != "") { <span>&middot; @p.SuperintendentName in charge</span> }
            @if (p.Yard != "") { <span>&middot; @p.Yard</span> }
            @if (p.PlannedStart is { } ps) { <span>&middot; planned @ps.ToString("d MMM yyyy")@(p.PlannedEnd is { } pe ? " to " + pe.ToString("d MMM yyyy") : "")</span> }
        </Facts>
        <Actions>
            @if (canEdit)
            {
                <button @onclick="OpenDetails" class="btn btn-secondary btn-sm">Edit details</button>
                @if (BudgetPending is { } waitingRequest)
                {
                    <button @onclick="() => WithdrawSubmission(waitingRequest.Request.Id)" disabled="@_busy" class="btn btn-secondary btn-sm">Withdraw submission</button>
                }
                else
                {
                    @foreach (var kind in NextSteps(_detail.Status))
                    {
                        <button @onclick="() => OpenStep(kind)" class="@("btn btn-sm " + (kind == ProjectEventKind.Withdrawn ? "btn-secondary" : "btn-primary"))">@(kind == ProjectEventKind.Approved && _needsMatrix ? "Submit for approval" : StepLabel(kind))</button>
                    }
                }
                @if (_detail.Status is ProjectStatus.Approved or ProjectStatus.Ongoing)
                {
                    <button @onclick="() => _variationOpen = !_variationOpen" class="btn btn-secondary btn-sm">Request variation</button>
                    @if (p.Type == ProjectType.Drydock)
                    {
                        <button @onclick="() => _extensionOpen = !_extensionOpen" class="btn btn-secondary btn-sm">Request more days</button>
                    }
                }
            }
        </Actions>
    </PageHeader>

    @if (!editable)
    {
        <div class="mb-6 rounded-xl border border-line bg-surface-2/60 px-4 py-3 text-sm">This project is closed and locked. Nothing on it can be changed.</div>
    }
    @if (_error is not null)
    {
        <div class="mb-6 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }
    @if (_info.Count > 0)
    {
        <div class="mb-6 rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-800 dark:bg-sky-500/10 dark:text-sky-200">
            <ul class="space-y-1">@foreach (var note in _info) { <li>@note</li> }</ul>
        </div>
    }

    @if (_step is { } step)
    {
        <div class="card mb-6 border-accent-300 p-5">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-muted">@(step == ProjectEventKind.Approved && _needsMatrix ? "Submit for approval" : StepLabel(step))</h2>
            <p class="mb-3 text-sm text-muted">@(step == ProjectEventKind.Approved && _needsMatrix ? "The approval matrix names who approves a budget of " + Money.Format(_budgetTotal + _contingency, "USD") + " (with contingency). The budget is held still until they answer." : StepHelp(step))</p>
            <div class="flex flex-wrap items-end gap-4">
                @if (step is ProjectEventKind.Started or ProjectEventKind.Completed)
                {
                    <label class="text-sm">Date it took effect <input type="date" @bind="_stepDate" class="input mt-1" /></label>
                }
                <label class="min-w-[18rem] flex-1 text-sm">@(step == ProjectEventKind.Closed ? "Reconciliation note (required)" : "Note")
                    <input @bind="_stepNote" class="input mt-1" placeholder="@(step == ProjectEventKind.Closed ? "How the cost came out against the budget" : "Optional")" /></label>
                <button @onclick="ConfirmStep" disabled="@_busy" class="btn btn-primary">Confirm</button>
                <button @onclick="() => _step = null" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (_variationOpen && canEdit)
    {
        <div class="card mb-6 border-accent-300 p-5">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-muted">Request a variation</h2>
            <p class="mb-3 text-sm text-muted">Extra work found after approval, with the extra money it needs. @(_needsMatrix ? "The approval matrix decides who approves it, by this amount." : "No approval rules apply, so it is added straight away.") Once approved it joins the specification and the budget.</p>
            <div class="flex flex-wrap items-end gap-4">
                <label class="text-sm">Changes an existing job
                    <select class="select mt-1" @bind="_variationItem">
                        <option value="@Guid.Empty">No, it is extra work</option>
                        @foreach (var open in p.Items.Where(i => i.Status == ProjectItemStatus.Open).OrderBy(i => i.SortOrder)) { <option value="@open.Id">@open.Group: @open.Description</option> }
                    </select>
                </label>
                @if (_variationItem == Guid.Empty)
                {
                    <label class="text-sm">Group <input @bind="_variationGroup" class="input mt-1" placeholder="Variations" /></label>
                }
                <label class="min-w-[16rem] flex-1 text-sm">@(_variationItem == Guid.Empty ? "The extra work" : "The job as it now reads") <input @bind="_variationText" class="input mt-1" /></label>
                <label class="text-sm">Extra amount (USD) <input type="number" step="0.01" min="0" @bind="_variationAmount" class="input mt-1 w-40 text-right" /></label>
                <label class="text-sm">Budget category
                    <select class="select mt-1" @bind="_variationCategory">
                        <option value="">None</option>
                        @foreach (var c in BudgetCategories()) { <option value="@c">@c</option> }
                    </select>
                </label>
                <label class="min-w-[16rem] flex-1 text-sm">Why <input @bind="_variationReason" class="input mt-1" /></label>
                <button @onclick="RequestVariation" disabled="@_busy" class="btn btn-primary">Submit</button>
                <button @onclick="() => _variationOpen = false" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (_extensionOpen && canEdit)
    {
        <div class="card mb-6 border-accent-300 p-5">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-muted">Request more days in the yard</h2>
            <p class="mb-3 text-sm text-muted">The planned end moves by the days asked for once this is approved. @(_needsMatrix ? "The approval matrix decides who approves it, by what it costs; more than " + ProjectService.ExtensionSecondApprovalDays + " days also needs the second step." : "No approval rules apply, so it is applied straight away.")</p>
            <div class="flex flex-wrap items-end gap-4">
                <label class="text-sm">Extra days <input type="number" min="1" max="365" @bind="_extensionDays" class="input mt-1 w-28 text-right" /></label>
                <label class="text-sm">What it costs (USD, if anything) <input type="number" step="0.01" min="0" @bind="_extensionAmount" class="input mt-1 w-40 text-right" /></label>
                <label class="text-sm">Budget category
                    <select class="select mt-1" @bind="_extensionCategory">
                        <option value="">None</option>
                        @foreach (var c in BudgetCategories()) { <option value="@c">@c</option> }
                    </select>
                </label>
                <label class="min-w-[16rem] flex-1 text-sm">Why <input @bind="_extensionReason" class="input mt-1" /></label>
                <button @onclick="RequestExtension" disabled="@_busy" class="btn btn-primary">Submit</button>
                <button @onclick="() => _extensionOpen = false" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (_editDetails)
    {
        <div class="card mb-6 p-5">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Details</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="md:col-span-2"><label class="label">Title</label><input @bind="_title" class="input" /></div>
                <div class="md:col-span-2"><label class="label">Scope</label><textarea @bind="_description" rows="3" class="textarea"></textarea></div>
                <div><label class="label">Type</label><SelectBox TValue="ProjectType" @bind-Value="_type" Options="_typeOptions" /></div>
                <div><label class="label">Superintendent in charge</label><SelectBox TValue="Guid" @bind-Value="_superintendentId" Options="_userOptions" Placeholder="Not named yet" AllowClear="true" /></div>
                <div><label class="label">Yard</label><input @bind="_yard" class="input" /></div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="label">Planned start</label><input type="date" @bind="_start" class="input" /></div>
                    <div><label class="label">Planned end</label><input type="date" @bind="_end" class="input" /></div>
                </div>
                <label class="flex items-center gap-2 text-sm md:col-span-2"><input type="checkbox" @bind="_uwild" /> Underwater inspection in lieu of drydock (UWILD)</label>
            </div>
            <div class="mt-4 flex gap-3">
                <button @onclick="SaveDetails" disabled="@_busy" class="btn btn-primary">Save details</button>
                <button @onclick="() => _editDetails = false" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }
    else if (p.Description != "")
    {
        <p class="mb-6 max-w-4xl text-sm text-ink-2">@p.Description</p>
    }

    @* ---- at a glance ---- *@
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard Label="Days" Value="@DaysText()" Hint="@DaysHint()" Tone="info" />
        <StatCard Label="Specification" Value="@($"{_detail.Project.Items.Count(i => i.Status == ProjectItemStatus.Done)} of {_detail.Project.Items.Count}")" Hint="@($"{_detail.Project.Items.Count(i => i.Status == ProjectItemStatus.Open)} open · {_detail.Project.Items.Count(i => i.Status == ProjectItemStatus.Dropped)} dropped")" Tone="accent" />
        @if (!_onVessel)
        {
        <StatCard Label="Budget" Value="@(_budgetTotal == 0 ? "—" : Money.Format(_budgetTotal, "USD"))" Hint="@(_contingency == 0 ? "No contingency set" : $"plus {Money.Format(_contingency, "USD")} contingency held")" Tone="accent" />
        <StatCard Label="Cost to date" Value="@(_cost!.Cost.ToDate == 0 ? "—" : Money.Format(_cost.Cost.ToDate, "USD"))" Hint="@VarianceText()" Tone="@(OverBudget ? "danger" : "success")" />
        }
    </div>

    @* ---- specification ---- *@
    <section class="card mb-6 p-5">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Specification</h2>
            @if (canEdit)
            {
                <button @onclick="ToggleImport" class="btn btn-secondary btn-sm ml-auto">@(_importOpen ? "Close import" : "Import from Worklist and maintenance")</button>
                <button @onclick="AddItem" class="btn btn-secondary btn-sm">+ Add item</button>
                <button @onclick="SaveItems" disabled="@_busy" class="btn btn-primary btn-sm">Save specification</button>
            }
        </div>
        @if (_importOpen && _candidates is { } cand)
        {
            <div class="mb-5 space-y-4 rounded-xl border border-line bg-surface-2/60 p-4 text-sm">
                <div>
                    <div class="mb-2 flex flex-wrap items-center gap-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-muted">Worklist tasks deferred to drydock</h3>
                        @if (!cand.WorklistOn) { <span class="text-muted">The worklist is not switched on for this vessel.</span> }
                        else if (cand.NatureName is null) { <span class="text-muted">No nature is marked as "deferred to drydock" yet.@(_isAdmin ? " Choose one here." : " A company admin can choose one here.")</span> }
                        else { <span class="text-muted">open tasks of the nature "@cand.NatureName"</span> }
                        @if (_isAdmin && cand.WorklistOn)
                        {
                            <span class="ml-auto flex items-center gap-2">
                                <span class="w-56"><SelectBox TValue="Guid" @bind-Value="_natureChoice" Options="_natureOptions" Placeholder="Choose the nature…" AllowClear="true" Small="true" /></span>
                                <button @onclick="SaveNature" disabled="@_busy" class="btn btn-secondary btn-sm">Use this nature</button>
                            </span>
                        }
                    </div>
                    @if (cand.Tasks.Count == 0 && cand.NatureName is not null)
                    {
                        <p class="text-muted">No open tasks of that nature that are not already on this project.</p>
                    }
                    @foreach (var t in cand.Tasks)
                    {
                        <label class="flex flex-wrap items-center gap-3 py-1">
                            <input type="checkbox" checked="@_pickTasks.Contains(t.Id)" @onchange="e => Pick(_pickTasks, t.Id, e.Value is true)" />
                            <span class="font-mono text-xs font-semibold">@t.Code</span><span>@t.Title</span>
                            @if (t.Urgent) { <StatusChip Label="Urgent" Tone="danger" /> }
                            @if (t.Target is { } target) { <span class="text-xs text-muted">target @target.ToString("d MMM yyyy")</span> }
                        </label>
                    }
                </div>

                <div>
                    <div class="mb-2 flex flex-wrap items-center gap-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-muted">Maintenance jobs coming due</h3>
                        @if (!cand.PmsOn) { <span class="text-muted">Maintenance is not switched on for this vessel.</span> }
                        else
                        {
                            <span class="ml-auto flex items-center gap-2 text-muted">due within <input type="number" min="0" max="730" @bind="_dueDays" class="input w-20 text-right" /> days
                                <button @onclick="LoadCandidatesAsync" class="btn btn-secondary btn-sm">Show</button></span>
                        }
                    </div>
                    @if (cand.PmsOn && cand.Jobs.Count == 0)
                    {
                        <p class="text-muted">No jobs due in that time that are not already on this project.</p>
                    }
                    @foreach (var j in cand.Jobs)
                    {
                        <label class="flex flex-wrap items-center gap-3 py-1">
                            <input type="checkbox" checked="@_pickJobs.Contains(j.Id)" @onchange="e => Pick(_pickJobs, j.Id, e.Value is true)" />
                            <span class="font-mono text-xs font-semibold">@j.Code</span><span>@j.Title</span>
                            @if (j.Machinery != "") { <span class="text-xs text-muted">@j.Machinery</span> }
                            @if (j.Critical) { <StatusChip Label="Critical" Tone="danger" /> }
                            @if (j.Due is { } due) { <span class="@("text-xs " + (due.Date < DateTime.UtcNow.Date ? "text-rose-600" : "text-muted"))">@(due.Date < DateTime.UtcNow.Date ? "overdue since" : "due") @due.ToString("d MMM yyyy")</span> }
                        </label>
                    }
                </div>

                <div class="flex items-center gap-3">
                    <button @onclick="ImportPicked" disabled="@(_busy || _pickTasks.Count + _pickJobs.Count == 0)" class="btn btn-primary btn-sm">Add selected (@(_pickTasks.Count + _pickJobs.Count))</button>
                    <span class="text-xs text-muted">Each is added as a job on the specification, remembers where it came from, and cannot be added twice.</span>
                </div>
            </div>
        }
        @if (_items.Count == 0)
        {
            <p class="text-sm text-muted">No items yet. Add the jobs this project covers.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-xs uppercase tracking-wide text-muted">
                        <tr><th class="p-2">Group</th><th class="p-2">Job</th><th class="p-2">From</th><th class="p-2">Status</th>@if (!_onVessel) { <th class="p-2 text-right">Estimate (USD)</th><th class="p-2 text-right">Yard quote (USD)</th> }<th class="p-2"></th></tr>
                    </thead>
                    <tbody class="divide-y divide-line/60">
                        @foreach (var row in _items)
                        {
                            <tr>
                                <td class="p-2">@if (canEdit) { <input @bind="row.Group" class="input w-32" /> } else { @row.Group }</td>
                                <td class="p-2">@if (canEdit) { <input @bind="row.Description" class="input min-w-[16rem]" /> } else { @row.Description }</td>
                                <td class="p-2 whitespace-nowrap text-muted">
                                    @if (row.Source == ProjectItemSource.WorklistTask && row.SourceId is { } taskId) { <a href="/worklist/@taskId" class="link">@SourceText(row)</a> }
                                    else if (row.Source == ProjectItemSource.PmsJob && row.SourceId is { } jobId)
                                    {
                                        <a href="/pms/jobs/@jobId" class="link">@SourceText(row)</a>
                                        @if (row.Id is { } itemId && _pmsWaiting.Contains(itemId)) { <div class="text-xs text-amber-600">Record the job as done in maintenance</div> }
                                    }
                                    else { @SourceText(row) }
                                </td>
                                <td class="p-2 w-36">@if (canEdit) { <SelectBox TValue="ProjectItemStatus" @bind-Value="row.Status" Options="_itemStatusOptions" Small="true" /> } else { @row.Status }</td>
                                @if (!_onVessel)
                                {
                                <td class="p-2 text-right">@if (canEdit) { <input type="number" step="0.01" min="0" @bind="row.Estimated" class="input w-32 text-right" /> } else { @(row.Estimated is { } est ? Money.Format(est, "USD") : "—") }</td>
                                <td class="p-2 text-right">@if (canEdit) { <input type="number" step="0.01" min="0" @bind="row.Quoted" class="input w-32 text-right" /> } else { @(row.Quoted is { } quote ? Money.Format(quote, "USD") : "—") }</td>
                                }
                                <td class="p-2 text-right">@if (canEdit) { <button @onclick="() => _items.Remove(row)" class="text-xs text-rose-600 hover:underline">Remove</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!_onVessel)
            {
                <p class="mt-2 text-xs text-muted">Estimates and yard quotes are kept at the office; the vessel sees the jobs and their status, never the amounts.</p>
            }
        }
    </section>

    @* ---- requests from the vessel ---- *@
    @if (_requests.Count > 0 || (_onVessel && editable))
    {
        <section class="card mb-6 p-5">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-muted">@(_onVessel ? "Jobs you have asked for" : "Requests from the vessel")</h2>
            @if (_onVessel)
            {
                <p class="mb-3 text-sm text-muted">Found something that needs doing while the work is going on? Ask for it to be added. The office will add it to the specification, or tell you why not.</p>
            }
            @if (_requests.Count == 0)
            {
                <p class="mb-3 text-sm text-muted">No requests yet.</p>
            }
            else
            {
                <ul class="mb-4 divide-y divide-line/60 text-sm">
                    @foreach (var v in _requests)
                    {
                        var r = v.Request;
                        <li class="py-3">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="font-medium">@r.Description</span>
                                @if (v.Decision is null) { <StatusChip Label="Waiting" Tone="warning" /> }
                                else if (v.Decision.Accepted) { <StatusChip Label="Added to the specification" Tone="success" /> }
                                else { <StatusChip Label="Declined" Tone="danger" /> }
                            </div>
                            @if (r.Reason != "") { <p class="mt-1 text-ink-2">@r.Reason</p> }
                            <p class="text-xs text-muted">@r.RequestedByName · @r.At.ToString("d MMM yyyy HH:mm")@AnswerText(v)</p>
                            @if (v.Decision is null && canEdit && _answers.TryGetValue(r.Id, out var answer))
                            {
                                <div class="mt-2 flex flex-wrap items-end gap-3">
                                    <label class="text-xs text-muted">Group <input @bind="answer.Group" class="input mt-1 w-40" /></label>
                                    <button @onclick="() => DecideAsync(r.Id, true)" disabled="@_busy" class="btn btn-primary btn-sm">Add to the specification</button>
                                    <label class="min-w-[14rem] flex-1 text-xs text-muted">Reason, if declined <input @bind="answer.Note" class="input mt-1" /></label>
                                    <button @onclick="() => DecideAsync(r.Id, false)" disabled="@_busy" class="btn btn-secondary btn-sm">Decline</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            @if (_onVessel && editable)
            {
                <div class="space-y-3 text-sm">
                    <label class="block">The job <input @bind="_requestText" class="input mt-1" placeholder="What needs doing" /></label>
                    <label class="block">What was found, and where <textarea @bind="_requestReason" rows="2" class="textarea mt-1"></textarea></label>
                    <button @onclick="SendRequestAsync" disabled="@_busy" class="btn btn-primary">Send request</button>
                </div>
            }
        </section>
    }

    @* ---- budget and cost: office only, shown to every office user; only managers can change them ---- *@
    @if (!_onVessel)
    {
        <section class="card mb-6 p-5">
            <div class="mb-3 flex flex-wrap items-center gap-3">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Budget</h2>
                @if (canEdit)
                {
                    <button @onclick="AddLine" class="btn btn-secondary btn-sm ml-auto">+ Add line</button>
                    <button @onclick="SaveBudget" disabled="@_busy" class="btn btn-primary btn-sm">Save budget</button>
                }
            </div>
            @if (_lines.Count == 0)
            {
                <p class="text-sm text-muted">No budget lines yet.@(canEdit ? " Add the categories this project will spend on." : "")</p>
            }
            else
            {
                <div class="overflow-x-auto"><table class="w-full max-w-3xl text-sm">
                    <thead class="text-left text-xs uppercase tracking-wide text-muted"><tr><th class="p-2">Category</th><th class="p-2 text-right">Planned (USD)</th><th class="p-2 text-right">Contingency %</th><th class="p-2"></th></tr></thead>
                    <tbody class="divide-y divide-line/60">
                        @foreach (var line in _lines)
                        {
                            <tr>
                                <td class="p-2">@if (canEdit) { <input @bind="line.Category" class="input" /> } else { @line.Category }</td>
                                <td class="p-2 text-right">@if (canEdit) { <input type="number" step="0.01" min="0" @bind="line.PlannedUsd" class="input w-36 text-right" /> } else { @Money.Format(line.PlannedUsd, "USD") }</td>
                                <td class="p-2 text-right">@if (canEdit) { <input type="number" step="0.5" min="0" max="100" @bind="line.ContingencyPct" class="input w-24 text-right" /> } else { @line.ContingencyPct.ToString("0.##") }</td>
                                <td class="p-2 text-right">@if (canEdit) { <button @onclick="() => _lines.Remove(line)" class="text-xs text-rose-600 hover:underline">Remove</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            @if (_approvals.Count > 0)
            {
                <p class="mt-3 text-xs text-muted">Approved at @string.Join(", then ", _approvals.Select(a => $"{Money.Format(a.TotalUsd, "USD")} on {a.At:d MMM yyyy} by {a.ApprovedByName}")). A later change to the budget does not alter what was approved.</p>
            }
        </section>

        @if (_approvalRequests.Count > 0)
        {
            <section class="mb-6">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Approvals</h2>
                @foreach (var view in _approvalRequests)
                {
                    var r = view.Request;
                    <p class="mt-4 text-sm"><span class="font-medium">@(r.Kind switch { ProjectRequestKind.Budget => "Budget", ProjectRequestKind.Extension => "Extension: " + r.Description, _ => "Variation: " + r.Description })</span>
                        <span class="text-muted">· @Money.Format(r.AmountUsd, "USD")@(r.Category != "" ? " in " + r.Category : "") · asked by @r.SubmittedByName on @r.SubmittedAt.ToString("d MMM yyyy") ·</span>
                        <StatusChip Label="@r.Status.ToString()" Tone="@(r.Status switch { ProjectRequestStatus.Approved => "success", ProjectRequestStatus.Pending => "warning", ProjectRequestStatus.Rejected => "danger", _ => "neutral" })" /></p>
                    @if (r.Reason != "") { <p class="text-xs text-muted">@r.Reason</p> }
                    <ApprovalPanel Slots="view.Slots" CanDecide="view.YourTurn" Noun="@(r.Kind switch { ProjectRequestKind.Budget => "project budget", ProjectRequestKind.Extension => "extension", _ => "variation" })" TotalText="@Money.Format(r.AmountUsd, "USD")" Busy="_busy" Error="@_error"
                                   OnDecide="args => DecideApproval(r.Id, args)" />
                }
            </section>
        }

        <section class="card mb-6 p-5">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Cost so far</h2>
            <div class="mb-4 grid grid-cols-2 gap-4 text-sm md:grid-cols-5">
                <div><p class="label">Committed</p><p class="tabular-nums text-ink">@Money.Format(_cost!.Cost.Committed, "USD")</p><p class="text-xs text-muted">approved orders not yet invoiced</p></div>
                <div><p class="label">Invoiced</p><p class="tabular-nums text-ink">@Money.Format(_cost.Cost.Invoiced, "USD")</p><p class="text-xs text-muted">finalized invoices, before tax</p></div>
                <div><p class="label">Other</p><p class="tabular-nums text-ink">@Money.Format(_cost.Cost.Other, "USD")</p><p class="text-xs text-muted">entered by hand</p></div>
                <div><p class="label">To date</p><p class="font-semibold tabular-nums text-ink">@Money.Format(_cost.Cost.ToDate, "USD")</p></div>
                <div><p class="label">@(OverBudget ? "Over budget by" : "Left in budget")</p><p class="@("font-semibold tabular-nums " + (OverBudget ? "text-rose-600" : "text-emerald-600"))">@(_budgetTotal == 0 ? "—" : Money.Format(Math.Abs(ProjectCostRules.Variance(_budgetTotal, _cost.Cost.ToDate)), "USD"))</p></div>
            </div>
            @if (_cost.Unconverted > 0)
            {
                <p class="mb-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">@_cost.Unconverted document(s) are in a currency with no exchange rate on file and are counted at their own amount. Add the rate under Exchange Rates to correct the totals.</p>
            }

            @if (_cost.Lines.Count > 0)
            {
                <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Documents behind the figures</h3>
                <div class="mb-4 overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-left text-xs uppercase tracking-wide text-muted"><tr><th class="p-2">Document</th><th class="p-2">Supplier</th><th class="p-2">Status</th><th class="p-2 text-right">Amount</th><th class="p-2 text-right">USD</th><th class="p-2">Counted as</th></tr></thead>
                        <tbody class="divide-y divide-line/60">
                            @foreach (var line in _cost.Lines)
                            {
                                <tr class="@(line.Bucket == ProjectCostBucket.NotCounted || line.Bucket == ProjectCostBucket.Settled ? "text-muted" : "")">
                                    <td class="p-2"><DocLink Kind="@(line.Kind == ProjectLinkKind.PurchaseOrder ? DocKind.PurchaseOrder : DocKind.Invoice)" Id="line.DocId" Text="@line.Number" /></td>
                                    <td class="p-2">@line.Supplier</td>
                                    <td class="p-2">@line.Status</td>
                                    <td class="p-2 text-right tabular-nums">@Money.Format(line.Amount, line.Currency)</td>
                                    <td class="p-2 text-right tabular-nums">@Money.Format(line.AmountUsd, "USD")</td>
                                    <td class="p-2">@BucketText(line.Bucket)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-4 text-sm text-muted">No orders or invoices are on this project yet. Choose the project on a requisition, order or invoice to count its cost here.</p>
            }

            <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Costs entered by hand</h3>
            @if (_cost.Entries.Count > 0)
            {
                <ul class="mb-3 divide-y divide-line/60 text-sm">
                    @foreach (var e in _cost.Entries)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-2">
                            <span class="text-muted">@e.Date.ToString("d MMM yyyy")</span><span>@e.Description</span>@if (e.Reference != "") { <span class="text-xs text-muted">@e.Reference</span> }
                            <span class="ml-auto tabular-nums">@Money.Format(e.AmountUsd, "USD")</span>
                            @if (canEdit) { <button @onclick="() => RemoveEntry(e)" class="text-xs text-rose-600 hover:underline">Remove</button> }
                        </li>
                    }
                </ul>
            }
            @if (canEdit)
            {
                <div class="flex flex-wrap items-end gap-3 text-sm">
                    <label>Date <input type="date" @bind="_entryDate" class="input mt-1" /></label>
                    <label class="min-w-[14rem] flex-1">What for <input @bind="_entryText" class="input mt-1" placeholder="Surveyor's attendance" /></label>
                    <label>Reference <input @bind="_entryRef" class="input mt-1 w-36" /></label>
                    <label>Amount (USD) <input type="number" step="0.01" @bind="_entryAmount" class="input mt-1 w-36 text-right" /></label>
                    <button @onclick="AddEntry" disabled="@_busy" class="btn btn-secondary">Add cost</button>
                </div>
                <p class="mt-1 text-xs text-muted">Enter a credit as a negative amount.</p>
            }
        </section>

        @* ---- J9: the office's planning tools. None of it leaves the office. ---- *@
        <ProjectTenders CompanyId="_companyId" ProjectId="ProjectId" User="_actor" Items="p.Items" CanEdit="@(canEdit && _detail.Status is ProjectStatus.Planning or ProjectStatus.Approved or ProjectStatus.Ongoing)" OnAwarded="ReloadAsync" />
        <ProjectPhases CompanyId="_companyId" ProjectId="ProjectId" User="_actor" CanEdit="canEdit" />
        <ProjectDocuments CompanyId="_companyId" ProjectId="ProjectId" User="_actor" CanEdit="canEdit" />
        <ProjectRisks CompanyId="_companyId" ProjectId="ProjectId" User="_actor" CanEdit="canEdit" />
    }

    @* ---- notes ---- *@
    <section class="card mb-6 p-5">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Progress notes</h2>
        @if (_detail.Notes.Count == 0)
        {
            <p class="mb-3 text-sm text-muted">No notes yet. The vessel's yard-stay reports will appear here as they come in.</p>
        }
        else
        {
            <ul class="mb-4 space-y-3 text-sm">
                @foreach (var n in _detail.Notes.OrderByDescending(n => n.Date).ThenByDescending(n => n.At))
                {
                    <li class="flex gap-3">
                        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full" style="background-image:linear-gradient(135deg,var(--accent-from),var(--accent-to))"></span>
                        <div class="min-w-0">
                            <p class="text-ink-2">@n.Text</p>
                            <p class="text-xs text-muted">@n.Date.ToString("d MMM yyyy") · @n.AuthorName · @(n.OwnerStage == SyncStages.Vessel ? "vessel" : "office")@(n.ProgressPct is { } pct ? $" · {pct}% done" : "")@(ItemOf(n.ItemId) is { } item ? " · " + item : "")</p>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (editable)
        {
            <div class="flex flex-wrap items-end gap-3 text-sm">
                <label>Day <input type="date" @bind="_noteDate" class="input mt-1" /></label>
                <label class="min-w-[18rem] flex-1">Note <input @bind="_noteText" class="input mt-1" placeholder="What happened, what is planned next" /></label>
                <label>Progress % <input type="number" min="0" max="100" @bind="_noteProgress" class="input mt-1 w-24 text-right" /></label>
                <div class="w-56"><label class="label">About</label><SelectBox TValue="Guid" @bind-Value="_noteItem" Options="_itemOptions" Placeholder="The whole project" AllowClear="true" Small="true" /></div>
                <button @onclick="AddNote" disabled="@_busy" class="btn btn-secondary">Add note</button>
            </div>
        }
    </section>

    @* ---- history ---- *@
    <section class="card mb-6 p-5">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">History</h2>
        <ul class="space-y-2 text-sm">
            <li class="text-muted">@p.CreatedAt.ToString("d MMM yyyy") · Created by @p.CreatedByName</li>
            @foreach (var e in _detail.Events)
            {
                <li><span class="font-medium">@StepDone(e.Kind)</span> <span class="text-muted">· @e.Date.ToString("d MMM yyyy") · @e.ByName@(e.Note != "" ? " · " : "")</span>@e.Note</li>
            }
        </ul>
    </section>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Actor _actor = Actor.System;
    private bool _loaded, _busy, _mayManage, _isAdmin;
    private readonly bool _onVessel = NodeContext.Current.IsVessel;
    private List<ProjectRequestView> _requests = [];
    private readonly Dictionary<Guid, AnswerRow> _answers = [];
    private string _requestText = "", _requestReason = "";
    private string? _error;
    private string _vesselName = "";
    private ProjectDetail? _detail;
    private ProjectCostSummary? _cost;
    private List<ProjectBudgetApproval> _approvals = [];
    private decimal _budgetTotal, _contingency;

    // approval through the matrix, and variations
    private List<ProjectService.ApprovalRequestView> _approvalRequests = [];
    private bool _needsMatrix, _variationOpen;
    private string _variationGroup = "", _variationText = "", _variationReason = "";
    private decimal _variationAmount;
    private Guid _variationItem;
    private bool _extensionOpen;
    private int _extensionDays = 7;
    private decimal _extensionAmount;
    private string _extensionReason = "", _extensionCategory = "", _variationCategory = "";

    /// <summary>The categories the budget already has, offered for a variation or extension so the matrix rules for a category can apply to its money.</summary>
    private List<string> BudgetCategories() => _lines.Select(l => (l.Category ?? "").Trim()).Where(c => c != "").Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
    private ProjectService.ApprovalRequestView? BudgetPending => _approvalRequests.FirstOrDefault(v => v.Request.Kind == ProjectRequestKind.Budget && v.Request.Status == ProjectRequestStatus.Pending);

    // adding from the Worklist and maintenance
    private List<string> _info = [];
    private bool _importOpen;
    private ImportCandidates? _candidates;
    private readonly HashSet<Guid> _pickTasks = [], _pickJobs = [];
    private int _dueDays = 90;
    private Guid _natureChoice;
    private List<SelectOption<Guid>> _natureOptions = [];
    private HashSet<Guid> _pmsWaiting = [];

    // what the page edits
    private readonly List<ItemRow> _items = [];
    private readonly List<LineRow> _lines = [];
    private bool _editDetails;
    private string _title = "", _description = "", _yard = "";
    private DateTime? _start, _end;
    private bool _uwild;
    private ProjectType _type;
    private Guid _superintendentId;
    private List<(Guid Id, string Name)> _users = [];
    private List<SelectOption<Guid>> _userOptions = [], _itemOptions = [];
    private ProjectEventKind? _step;
    private DateTime _stepDate = DateTime.UtcNow.Date;
    private string _stepNote = "";
    private DateTime _entryDate = DateTime.UtcNow.Date, _noteDate = DateTime.UtcNow.Date;
    private string _entryText = "", _entryRef = "", _noteText = "";
    private decimal _entryAmount;
    private int? _noteProgress;
    private Guid _noteItem;

    private readonly List<SelectOption<ProjectType>> _typeOptions = [new(ProjectType.Drydock, "Drydock"), new(ProjectType.NonDrydock, "Technical project")];
    private readonly List<SelectOption<ProjectItemStatus>> _itemStatusOptions = SelectOptions.FromEnum<ProjectItemStatus>();

    private class ItemRow
    {
        public Guid? Id;
        public string Group = "", Description = "", SourceRef = "";
        public ProjectItemSource Source;
        public Guid? SourceId;
        public ProjectItemStatus Status;
        public decimal? Estimated, Quoted;
    }

    private class AnswerRow
    {
        public string Group = "Vessel requests", Note = "";
    }

    private class LineRow
    {
        public string Category = "";
        public decimal PlannedUsd, ContingencyPct;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _mayManage = await Svc.MayManageAsync(_companyId, _actor.UserId);
        _isAdmin = state.User.IsInRole("CompanyAdmin");
        _users = _onVessel ? [] : await Svc.OfficeUsersAsync(_companyId);
        _userOptions = SelectOptions.From(_users, u => u.Id, u => u.Name);
        await ReloadAsync();
        _loaded = true;
    }

    private async Task ReloadAsync()
    {
        _detail = await Svc.GetAsync(_companyId, ProjectId);
        if (_detail is null) return;
        var vessels = await Svc.EnabledVesselsAsync(_companyId);
        _vesselName = vessels.FirstOrDefault(v => v.Id == _detail.Project.VesselId).Name ?? "";
        // Budget, cost and estimates are the office's; a vessel never reads them.
        _cost = _onVessel ? null : await Svc.CostAsync(_companyId, ProjectId);
        List<ProjectBudgetLine> lines = _onVessel ? [] : await Svc.BudgetAsync(_companyId, ProjectId);
        _approvals = _onVessel ? [] : await Svc.ApprovalsAsync(_companyId, ProjectId);
        _pmsWaiting = _onVessel ? [] : await Svc.PmsWaitingAsync(_companyId, ProjectId);
        _approvalRequests = _onVessel ? [] : await Svc.RequestsOfAsync(_companyId, ProjectId, _actor.UserId);
        _needsMatrix = !_onVessel && await Svc.NeedsMatrixAsync(_companyId, ProjectId);
        var costs = _onVessel ? new Dictionary<Guid, ProjectItemCost>() : (await Svc.ItemCostsAsync(_companyId, ProjectId)).ToDictionary(c => c.ItemId);
        _requests = await Svc.RequestsAsync(_companyId, ProjectId);
        foreach (var waiting in _requests.Where(r => r.Decision is null)) _answers.TryAdd(waiting.Request.Id, new AnswerRow());
        _budgetTotal = ProjectCostRules.Budget(lines);
        _contingency = ProjectCostRules.Contingency(lines);

        _items.Clear();
        foreach (var i in _detail.Project.Items)
        {
            costs.TryGetValue(i.Id, out var cost);
            _items.Add(new ItemRow { Id = i.Id, Group = i.Group, Description = i.Description, Source = i.Source, SourceId = i.SourceId, SourceRef = i.SourceRef, Status = i.Status, Estimated = cost?.EstimatedUsd, Quoted = cost?.QuotedUsd });
        }
        _lines.Clear();
        _lines.AddRange(lines.Select(l => new LineRow { Category = l.Category, PlannedUsd = l.PlannedUsd, ContingencyPct = l.ContingencyPct }));
        _itemOptions = _detail.Project.Items.Select(i => new SelectOption<Guid>(i.Id, i.Description)).ToList();
    }

    private async Task RunAsync(Func<Task> action, string success)
    {
        _error = null;
        _info = [];
        _busy = true;
        try
        {
            await action();
            await ReloadAsync();
            await Toasts.Success(success);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- details and steps ----

    private void OpenDetails()
    {
        var p = _detail!.Project;
        (_title, _description, _yard, _start, _end, _uwild, _type, _superintendentId) = (p.Title, p.Description, p.Yard, p.PlannedStart, p.PlannedEnd, p.IsUwild, p.Type, p.SuperintendentUserId ?? Guid.Empty);
        _editDetails = true;
    }

    private Task SaveDetails() => RunAsync(async () =>
    {
        var name = _users.FirstOrDefault(u => u.Id == _superintendentId).Name ?? "";
        await Svc.UpdateAsync(_companyId, ProjectId, new ProjectEdit(_type, _title, _description, _superintendentId == Guid.Empty ? null : _superintendentId, name, _start, _end, _yard, _uwild), _actor);
        _editDetails = false;
    }, "Details saved");

    private Task WithdrawSubmission(Guid requestId) => RunAsync(() => Svc.WithdrawRequestAsync(_companyId, requestId, _actor), "Submission withdrawn");

    private Task DecideApproval(Guid requestId, (bool Approve, string Comment) args) => RunAsync(() => Svc.DecideApprovalAsync(_companyId, requestId, _actor, args.Approve, args.Comment), args.Approve ? "Approved" : "Rejected");

    private Task RequestVariation() => RunAsync(async () =>
    {
        await Svc.RequestVariationAsync(_companyId, ProjectId, _variationGroup, _variationText, _variationAmount, _variationReason, _actor, _variationItem == Guid.Empty ? null : _variationItem, _variationCategory);
        (_variationOpen, _variationGroup, _variationText, _variationReason, _variationAmount, _variationItem, _variationCategory) = (false, "", "", "", 0m, Guid.Empty, "");
    }, "Variation requested");

    private Task RequestExtension() => RunAsync(async () =>
    {
        await Svc.RequestExtensionAsync(_companyId, ProjectId, _extensionDays, _extensionAmount, _extensionReason, _actor, _extensionCategory);
        (_extensionOpen, _extensionDays, _extensionAmount, _extensionReason, _extensionCategory) = (false, 7, 0m, "", "");
    }, "Extension requested");

    private static ProjectEventKind[] NextSteps(ProjectStatus status) => status switch
    {
        ProjectStatus.Planning => [ProjectEventKind.Approved],
        ProjectStatus.Approved => [ProjectEventKind.Started, ProjectEventKind.Withdrawn],
        ProjectStatus.Ongoing => [ProjectEventKind.Completed],
        ProjectStatus.Complete => [ProjectEventKind.Closed],
        _ => [],
    };

    private static string StepLabel(ProjectEventKind kind) => kind switch
    {
        ProjectEventKind.Approved => "Approve project", ProjectEventKind.Started => "Start work", ProjectEventKind.Completed => "Mark work complete",
        ProjectEventKind.Closed => "Close project", _ => "Withdraw approval",
    };

    private static string StepDone(ProjectEventKind kind) => kind switch
    {
        ProjectEventKind.Approved => "Approved", ProjectEventKind.Started => "Work started", ProjectEventKind.Completed => "Work completed", ProjectEventKind.Closed => "Closed", _ => "Approval withdrawn",
    };

    private static string StepHelp(ProjectEventKind kind) => kind switch
    {
        ProjectEventKind.Approved => "The budget as it stands now is kept with the approval.",
        ProjectEventKind.Started => "Give the day the ship reached the yard or the work began.",
        ProjectEventKind.Completed => "Give the day the work finished or the ship left.",
        ProjectEventKind.Closed => "Every specification item must be Done or Dropped. Closing locks the project: nothing on it can be changed afterwards.",
        _ => "Takes the project back to planning so it can be changed and approved again.",
    };

    private void OpenStep(ProjectEventKind kind) { _step = kind; _stepNote = ""; _stepDate = DateTime.UtcNow.Date; _error = null; }

    private Task ConfirmStep() => RunAsync(async () =>
    {
        if (_step == ProjectEventKind.Approved && _needsMatrix) await Svc.SubmitAsync(_companyId, ProjectId, _actor);
        else await Svc.RecordAsync(_companyId, ProjectId, _step!.Value, _stepDate, _stepNote, _actor);
        _step = null;
    }, "Recorded");

    // ---- specification ----

    private void AddItem() => _items.Add(new ItemRow { Group = _items.LastOrDefault()?.Group ?? "" });

    private Task SaveItems() => RunAsync(async () =>
    {
        _info = await Svc.SaveItemsAsync(_companyId, ProjectId, _items.Select(i => new ProjectItemInput(i.Id, i.Group, i.Description, i.Source, i.SourceId, i.SourceRef, i.Status)).ToList(), _actor);
        // New items have their ids only now; the saved items are in the same order as the rows, so each row's amounts go with its item.
        var saved = (await Svc.GetAsync(_companyId, ProjectId))!.Project.Items;
        for (var i = 0; i < _items.Count && i < saved.Count; i++)
            await Svc.SetItemCostAsync(_companyId, ProjectId, saved[i].Id, _items[i].Estimated, _items[i].Quoted, _actor);
    }, "Specification saved");

    private async Task ToggleImport()
    {
        _importOpen = !_importOpen;
        if (_importOpen) await LoadCandidatesAsync();
    }

    private async Task LoadCandidatesAsync()
    {
        _error = null;
        try
        {
            _candidates = await Svc.ImportCandidatesAsync(_companyId, ProjectId, Math.Clamp(_dueDays, 0, 730));
            _pickTasks.RemoveWhere(id => _candidates.Tasks.All(t => t.Id != id));
            _pickJobs.RemoveWhere(id => _candidates.Jobs.All(j => j.Id != id));
            _natureOptions = (await Svc.NatureOptionsAsync(_companyId)).Select(n => new SelectOption<Guid>(n.Id, n.Name)).ToList();
            _natureChoice = (await Svc.DrydockNatureAsync(_companyId))?.Id ?? Guid.Empty;
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private static void Pick(HashSet<Guid> set, Guid id, bool on)
    {
        if (on) set.Add(id); else set.Remove(id);
    }

    private Task SaveNature() => RunAsync(async () =>
    {
        await Svc.SetDrydockNatureAsync(_companyId, _natureChoice == Guid.Empty ? null : _natureChoice, _actor);
        await LoadCandidatesAsync();
    }, "Saved");

    private Task ImportPicked() => RunAsync(async () =>
    {
        var outcome = await Svc.ImportAsync(_companyId, ProjectId, _pickTasks.ToList(), _pickJobs.ToList(), _actor);
        _info = outcome.Notes;
        _pickTasks.Clear();
        _pickJobs.Clear();
        await LoadCandidatesAsync();
    }, "Added to the specification");

    private Task SendRequestAsync() => RunAsync(async () =>
    {
        await Svc.AddItemRequestAsync(_companyId, ProjectId, _requestText, _requestReason, _actor);
        (_requestText, _requestReason) = ("", "");
    }, "Request sent");

    private Task DecideAsync(Guid requestId, bool accept) => RunAsync(async () =>
    {
        var answer = _answers[requestId];
        await Svc.DecideRequestAsync(_companyId, requestId, accept, answer.Group, answer.Note, _actor);
    }, accept ? "Added to the specification" : "Declined");

    private static string AnswerText(ProjectRequestView v)
        => v.Decision is { } d ? $" · answered by {d.DecidedByName} on {d.At:d MMM yyyy}{(d.Note != "" ? " · " + d.Note : "")}" : "";

    private static string SourceText(ItemRow row) => row.Source switch
    {
        ProjectItemSource.WorklistTask => $"Worklist {row.SourceRef}".Trim(), ProjectItemSource.PmsJob => $"Maintenance {row.SourceRef}".Trim(),
        ProjectItemSource.ClassRequirement => "Class requirement", ProjectItemSource.OwnerRequest => "Owner request", ProjectItemSource.Other => "Other", ProjectItemSource.VesselRequest => "Vessel request", _ => "",
    };

    private string? ItemOf(Guid? id) => id is { } item ? _detail!.Project.Items.FirstOrDefault(i => i.Id == item)?.Description : null;

    // ---- budget and cost ----

    private void AddLine() => _lines.Add(new LineRow());

    private Task SaveBudget() => RunAsync(() => Svc.SaveBudgetAsync(_companyId, ProjectId, _lines.Select(l => new BudgetLineInput(l.Category, l.PlannedUsd, l.ContingencyPct)).ToList(), _actor), "Budget saved");

    private Task AddEntry() => RunAsync(async () =>
    {
        await Svc.AddCostEntryAsync(_companyId, ProjectId, _entryDate, _entryText, _entryRef, _entryAmount, _actor);
        (_entryText, _entryRef, _entryAmount) = ("", "", 0m);
    }, "Cost added");

    private Task RemoveEntry(ProjectCostEntry entry) => RunAsync(() => Svc.RemoveCostEntryAsync(_companyId, entry.Id, _actor), "Cost removed");

    private bool OverBudget => _budgetTotal > 0 && _cost!.Cost.ToDate > _budgetTotal;

    private string VarianceText() => _budgetTotal == 0 ? "No budget set yet" : OverBudget
        ? $"{Money.Format(_cost!.Cost.ToDate - _budgetTotal, "USD")} over budget"
        : $"{Money.Format(ProjectCostRules.Variance(_budgetTotal, _cost!.Cost.ToDate), "USD")} left in budget";

    private static string BucketText(ProjectCostBucket bucket) => bucket switch
    {
        ProjectCostBucket.Committed => "Committed", ProjectCostBucket.Invoiced => "Invoiced",
        ProjectCostBucket.Settled => "Replaced by its invoices", _ => "Not counted yet",
    };

    private string DaysText()
    {
        var p = _detail!.Project;
        var planned = ProjectCostRules.PlannedDays(p.PlannedStart, p.PlannedEnd);
        var actual = ProjectCostRules.ActualDays(_detail.ActualStart, _detail.ActualEnd, DateTime.UtcNow.Date);
        return actual is { } a ? (planned is { } pl ? $"{a} of {pl}" : $"{a}") : planned is { } x ? $"{x} planned" : "—";
    }

    private string DaysHint()
    {
        if (_detail!.ActualStart is not { } start) return "Not started";
        return _detail.ActualEnd is { } end ? $"{start:d MMM} to {end:d MMM yyyy}" : $"Started {start:d MMM yyyy}";
    }

    // ---- notes ----

    private Task AddNote() => RunAsync(async () =>
    {
        await Svc.AddNoteAsync(_companyId, ProjectId, new NewProjectNote(_noteDate, _noteText, _noteProgress, _noteItem == Guid.Empty ? null : _noteItem), _actor);
        (_noteText, _noteProgress, _noteItem) = ("", null, Guid.Empty);
    }, "Note added");
}
