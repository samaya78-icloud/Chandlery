@page "/projects/groups"
@attribute [Authorize(Roles = "CompanyAdmin,CompanyUser")]
@rendermode InteractiveServer
@inject ProjectService Svc
@inject ProjectPlanningService Planning
@inject ToastService Toasts

<PageTitle>Project groups · Chandlery</PageTitle>

<PageHeader Eyebrow="Fleet" Title="Project groups" Subtitle="One job across several ships, such as a drydock for sister vessels. Each ship keeps its own project, so it only ever sees its own; the group adds them up.">
    <Actions>
        <a href="/projects" class="btn btn-secondary">Project list</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <Skeleton Rows="4" />
}
else
{
    @if (_error is not null)
    {
        <div class="mb-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600">@_error</div>
    }

    @if (_mayManage)
    {
        <div class="card mb-5 flex flex-wrap items-end gap-3 p-4 text-sm">
            <label>New group <input class="input mt-1" @bind="_name" placeholder="Sister ships drydock 2027" /></label>
            <label class="min-w-[14rem] flex-1">Note <input class="input mt-1" @bind="_note" /></label>
            <button @onclick="Create" disabled="@_busy" class="btn btn-primary">Create group</button>
        </div>
    }

    @if (_groups.Count == 0)
    {
        <EmptyState Title="No groups yet" Message="@(_mayManage ? "Create a group, then add the projects that belong together." : "A project manager can create a group and add projects to it.")" />
    }

    @foreach (var (group, ids) in _groups)
    {
        var members = _rows.Where(r => ids.Contains(r.Row.Project.Id)).OrderBy(r => r.VesselName, StringComparer.OrdinalIgnoreCase).ToList();
        var sum = ProjectGroupRules.Summarise(members, _today);
        <section class="card mb-5 p-5">
            <div class="mb-3 flex flex-wrap items-center gap-3">
                <h2 class="text-base font-semibold">@group.Name</h2>
                @if (sum.Overall is { } overall) { <StatusChip Value="overall" /> }
                <span class="text-xs text-muted">@sum.Projects project@(sum.Projects == 1 ? "" : "s") on @sum.Vessels vessel@(sum.Vessels == 1 ? "" : "s")@(sum.Start is { } s && sum.End is { } e ? " · " + s.ToString("d MMM yyyy") + " to " + e.ToString("d MMM yyyy") : "")</span>
                @if (_mayManage) { <button @onclick="() => Delete(group.Id)" disabled="@_busy" class="ml-auto text-xs text-rose-600 hover:underline">Delete group</button> }
            </div>
            @if (group.Note != "") { <p class="mb-3 text-sm text-muted">@group.Note</p> }

            <div class="mb-4 grid grid-cols-2 gap-4 text-sm md:grid-cols-5">
                <div><p class="label">Budget</p><p class="tabular-nums">@(sum.Budget == 0 ? "—" : Money.Format(sum.Budget, "USD"))</p></div>
                <div><p class="label">Contingency</p><p class="tabular-nums">@(sum.Contingency == 0 ? "—" : Money.Format(sum.Contingency, "USD"))</p></div>
                <div><p class="label">Cost to date</p><p class="tabular-nums">@(sum.Cost == 0 ? "—" : Money.Format(sum.Cost, "USD"))</p></div>
                <div><p class="label">Variance</p><p class="@("tabular-nums " + (sum.OverBudget ? "font-semibold text-rose-600" : ""))">@(sum.Budget == 0 ? "—" : (sum.Variance < 0 ? "−" : "") + Money.Format(Math.Abs(sum.Variance), "USD"))</p></div>
                <div><p class="label">Jobs done</p><p class="tabular-nums">@sum.ItemsDone of @sum.ItemsTotal</p></div>
            </div>

            @if (members.Count > 0)
            {
                <div class="overflow-x-auto"><table class="mb-3 w-full text-sm">
                    <thead class="text-left text-xs uppercase tracking-wide text-muted"><tr><th class="p-2">Vessel</th><th class="p-2">Project</th><th class="p-2">Status</th><th class="p-2 text-right">Budget</th><th class="p-2 text-right">Cost to date</th><th class="p-2"></th></tr></thead>
                    <tbody class="divide-y divide-line/60">
                        @foreach (var r in members)
                        {
                            <tr>
                                <td class="p-2">@r.VesselName</td>
                                <td class="p-2"><a href="/projects/@r.Row.Project.Id" class="link font-mono text-xs font-semibold">@r.Row.Project.Code</a> @r.Row.Project.Title</td>
                                <td class="p-2"><StatusChip Value="@r.Row.Status" /></td>
                                <td class="p-2 text-right tabular-nums">@(r.Budget == 0 ? "—" : Money.Format(r.Budget, "USD"))</td>
                                <td class="p-2 text-right tabular-nums">@(r.Cost.ToDate == 0 ? "—" : Money.Format(r.Cost.ToDate, "USD"))</td>
                                <td class="p-2 text-right">@if (_mayManage) { <button @onclick="() => Remove(r.Row.Project.Id)" disabled="@_busy" class="text-xs text-rose-600 hover:underline">Take out</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            else
            {
                <p class="mb-3 text-sm text-muted">No projects in this group yet.</p>
            }

            @if (_mayManage && Candidates().Count > 0)
            {
                <div class="flex flex-wrap items-end gap-2 text-sm">
                    <label>Add a project
                        <select class="select mt-1" @bind="_pick[group.Id]">
                            <option value="@Guid.Empty">Choose…</option>
                            @foreach (var c in Candidates()) { <option value="@c.Row.Project.Id">@c.VesselName · @c.Row.Project.Code @c.Row.Project.Title</option> }
                        </select>
                    </label>
                    <button @onclick="() => Add(group.Id)" disabled="@_busy" class="btn btn-secondary btn-sm">Add</button>
                </div>
            }
        </section>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _companyId;
    private Actor _actor = Actor.System;
    private readonly DateTime _today = DateTime.UtcNow.Date;
    private bool _loaded, _busy, _mayManage;
    private string? _error;
    private string _name = "", _note = "";
    private List<(ProjectGroup Group, List<Guid> ProjectIds)> _groups = [];
    private List<ProjectListRow> _rows = [];
    private readonly Dictionary<Guid, Guid> _pick = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask!;
        _companyId = Guid.Parse(state.User.FindFirst("CompanyId")!.Value);
        _actor = Actor.From(state.User);
        _mayManage = await Svc.MayManageAsync(_companyId, _actor.UserId);
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _rows = await Svc.IsEnabledForCompanyAsync(_companyId) ? await Svc.ListWithMoneyAsync(_companyId) : [];
        _groups = await Planning.GroupsAsync(_companyId);
        foreach (var (group, _) in _groups) _pick.TryAdd(group.Id, Guid.Empty);
    }

    /// <summary>Projects not in any group yet, live ones first.</summary>
    private List<ProjectListRow> Candidates()
    {
        var grouped = _groups.SelectMany(g => g.ProjectIds).ToHashSet();
        return _rows.Where(r => !grouped.Contains(r.Row.Project.Id) && r.Row.Status != ProjectStatus.Closed).OrderBy(r => r.VesselName, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Row.Project.Code).ToList();
    }

    private async Task Run(Func<Task> action, string success)
    {
        _busy = true;
        _error = null;
        try { await action(); await LoadAsync(); await Toasts.Success(success); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task Create() => Run(async () => { await Planning.CreateGroupAsync(_companyId, _name, _note, _actor); (_name, _note) = ("", ""); }, "Group created");

    private Task Delete(Guid id) => Run(() => Planning.DeleteGroupAsync(_companyId, id, _actor), "Group deleted");

    private Task Add(Guid groupId) => Run(async () => { await Planning.AddToGroupAsync(_companyId, groupId, _pick[groupId], _actor); _pick[groupId] = Guid.Empty; }, "Project added");

    private Task Remove(Guid projectId) => Run(() => Planning.RemoveFromGroupAsync(_companyId, projectId, _actor), "Taken out of the group");
}
