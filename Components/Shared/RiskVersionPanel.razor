@inject RiskAssessmentService Svc
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

@if (Detail.Status == RaStatus.Signed && !Detail.Superseded)
{
    <div class="card mb-5 p-5 text-sm">
        <h2 class="mb-1 font-display text-lg font-extrabold text-ink">Make a new version</h2>
        <p class="mb-3 text-xs text-muted">A signed assessment is never changed. A new version starts as a copy that you can edit, and replaces this one once it is signed.</p>
        @if (_error is not null) { <div class="mb-3 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-rose-800">@_error</div> }
        <div class="flex flex-wrap gap-2">
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => NewVersionAsync(RaKind.Interim)">Repeat the job (interim)</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => NewVersionAsync(RaKind.Annual)">Annual review</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => NewVersionAsync(RaKind.Revision)">Revise it</button>
        </div>
    </div>

    @if (!NodeContext.Current.IsVessel)
    {
        <div class="card mb-5 p-5 text-sm">
            <h2 class="mb-1 font-display text-lg font-extrabold text-ink">Share with other vessels</h2>
            <p class="mb-3 text-xs text-muted">Each vessel gets its own signed copy with its own reference, and can give it new versions onboard. A vessel that already has a copy gets this as the next version of it.</p>
            @if (_shareError is not null) { <div class="mb-3 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-rose-800">@_shareError</div> }
            @if (_shareNote is not null) { <div class="mb-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-emerald-800">@_shareNote</div> }
            @if (_targets.Count == 0) { <p class="text-muted">No other vessel has risk assessment switched on.</p> }
            else
            {
                @if (_targets.Any(t => t.GroupName != ""))
                {
                    <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                        <span class="text-muted">Pick a group:</span>
                        @foreach (var group in _targets.Where(t => t.GroupName != "").Select(t => t.GroupName).Distinct().OrderBy(n => n))
                        {
                            var name = group;
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="() => PickGroup(name)">@name</button>
                        }
                        <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _picked.Clear()">Clear</button>
                    </div>
                }
                <ul class="grid gap-1 md:grid-cols-2">
                    @foreach (var t in _targets)
                    {
                        var target = t;
                        <li>
                            <label class="flex items-center gap-2 rounded-lg px-2 py-1 hover:bg-surface-2">
                                <input type="checkbox" disabled="@target.AlreadyHasCopy" checked="@_picked.Contains(target.VesselId)" @onchange="e => Toggle(target.VesselId, e.Value is true)" />
                                <span>@target.VesselName</span>
                                @if (target.GroupName != "") { <span class="text-xs text-muted">@target.GroupName</span> }
                                @if (target.AlreadyHasCopy) { <span class="chip" data-tone="success">has it</span> }
                            </label>
                        </li>
                    }
                </ul>
                <button class="btn btn-primary mt-3" disabled="@(_busy || _picked.Count == 0)" @onclick="ShareAsync">Share with @_picked.Count vessel(s)</button>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public AssessmentDetail Detail { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private Actor _actor = Actor.System;
    private string? _error, _shareError, _shareNote;
    private bool _busy;
    private List<ShareTarget> _targets = [];
    private readonly HashSet<Guid> _picked = [];

    protected override async Task OnParametersSetAsync()
    {
        _actor = Actor.From((await Auth.GetAuthenticationStateAsync()).User);
        if (Detail.Status == RaStatus.Signed && !Detail.Superseded && !NodeContext.Current.IsVessel) _targets = await Svc.ShareTargetsAsync(CompanyId, Detail.Assessment.Id);
    }

    private async Task NewVersionAsync(RaKind kind)
    {
        _error = null;
        _busy = true;
        try
        {
            var made = await Svc.NewVersionAsync(CompanyId, Detail.Assessment.Id, kind, _actor);
            Nav.NavigateTo($"/risk/{made.Id}");
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void Toggle(Guid vesselId, bool on) { if (on) _picked.Add(vesselId); else _picked.Remove(vesselId); }

    private void PickGroup(string group)
    {
        foreach (var t in _targets.Where(t => t.GroupName == group && !t.AlreadyHasCopy)) _picked.Add(t.VesselId);
    }

    private async Task ShareAsync()
    {
        _shareError = _shareNote = null;
        _busy = true;
        try
        {
            var made = await Svc.ShareAsync(CompanyId, Detail.Assessment.Id, _picked.ToList(), _actor);
            _shareNote = made.Count == 0 ? "Nothing to share: those vessels already have it." : $"Shared with {made.Count} vessel(s).";
            _picked.Clear();
            _targets = await Svc.ShareTargetsAsync(CompanyId, Detail.Assessment.Id);
        }
        catch (InvalidOperationException ex) { _shareError = ex.Message; }
        finally { _busy = false; }
    }
}
