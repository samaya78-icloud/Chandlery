@inject ProcurementService Procurement

@* Choose several suppliers from a long address book: a multi-select SelectBox with server-side search (name or email) and
   "Load more". Suppliers in Excluded are shown but cannot be chosen, with the reason beside them. *@

<SelectBox TValue="Guid" Multiple="true" Values="Selected" Provider="SearchAsync" Resolve="Procurement.SupplierSelectResolver()" OnChanged="OnChanged"
           Placeholder="Search and choose suppliers…" SearchPlaceholder="Search suppliers by name or email…" EmptyText="No suppliers yet. Add one on the Suppliers page first." />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public HashSet<Guid> Selected { get; set; } = new();

    /// <summary>Suppliers that cannot be chosen, with the reason shown next to them (for example "Already sent on RFQ-1007").</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> Excluded { get; set; } = new Dictionary<Guid, string>();

    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task<SelectResult<Guid>> SearchAsync(SelectQuery query)
    {
        var (rows, total) = await Procurement.SearchCompanySuppliersAsync(CompanyId, query.Term, query.Skip, query.Take);
        var options = rows.Select(s => Excluded.TryGetValue(s.Id, out var reason)
            ? new SelectOption<Guid>(s.Id, s.Name, s.ContactEmail, Disabled: true, DisabledReason: reason)
            : new SelectOption<Guid>(s.Id, s.Name, s.ContactEmail)).ToList();
        return new SelectResult<Guid>(options, total);
    }
}
