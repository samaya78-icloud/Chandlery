<div class="rounded-2xl border border-dashed border-line bg-surface/60 px-6 py-12 text-center">
    <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-2xl bg-accent-50 text-accent-600">
        @if (Icon is not null)
        {
            @Icon
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
        }
    </div>
    <p class="font-display text-lg font-bold text-ink">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="mx-auto mt-1 max-w-md text-sm text-muted">@Message</p>
    }
    @if (Action is not null)
    {
        <div class="mt-5 flex justify-center gap-2">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
}
