@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href" class="@Classes">@Body</a>
}
else
{
    <div class="@Classes">@Body</div>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }

    /// <summary>Makes the whole card a link to the filtered list behind the number.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>accent, success, warning, danger or info: colours the icon tile.</summary>
    [Parameter] public string Tone { get; set; } = "accent";
    [Parameter] public RenderFragment? Icon { get; set; }

    private string Classes => "card group relative block overflow-hidden p-5 transition " + (string.IsNullOrEmpty(Href) ? "" : "hover:-translate-y-0.5 hover:shadow-pop");

    private RenderFragment Body => __builder =>
    {
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-wider text-muted">@Label</p>
                <p class="mt-2 break-words font-display text-2xl font-extrabold text-ink sm:text-3xl">@Value</p>
                @if (!string.IsNullOrWhiteSpace(Hint))
                {
                    <p class="mt-1 text-xs text-muted">@Hint</p>
                }
            </div>
            <span class="chip chip-plain grid h-10 w-10 shrink-0 place-items-center rounded-xl p-0" data-tone="@Tone">
                @if (Icon is not null)
                {
                    <span class="h-5 w-5">@Icon</span>
                }
            </span>
        </div>
    };
}
