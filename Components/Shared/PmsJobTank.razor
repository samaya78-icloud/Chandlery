@inject PmsService Pms
@inject TankService Tanks

@if (Job.Type == PmsJobType.Inspection && (_tanks.Count > 0 || Job.TankId is not null))
{
    <div class="card p-5 text-sm">
        <h2 class="mb-3 font-display text-base font-extrabold text-ink">Tank</h2>
        @if (Job.TankId is { } tankId)
        {
            var tank = _tanks.FirstOrDefault(t => t.Id == tankId);
            <p>This job is done by inspecting <span class="font-semibold">@(tank is null ? "its tank" : $"{tank.Code} · {tank.Name}")</span>. Submitting the inspection completes the job.</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <a href="/tanks/inspections/new?tank=@tankId&job=@Job.Id" class="btn btn-primary btn-sm">Start the inspection</a>
                <button class="btn btn-ghost btn-sm" @onclick="() => SetAsync(null)">Unlink the tank</button>
            </div>
        }
        else
        {
            <p class="mb-2 text-xs text-muted">Name the tank this job inspects and the job is completed by submitting its tank inspection.</p>
            <select class="select" @bind="_picked">
                <option value="@Guid.Empty">Choose a tank…</option>
                @foreach (var t in _tanks) { <option value="@t.Id">@t.Code · @t.Name</option> }
            </select>
            <button class="btn btn-secondary btn-sm mt-3" disabled="@(_picked == Guid.Empty)" @onclick="() => SetAsync(_picked)">Link the tank</button>
        }
        @if (_error is not null) { <p class="mt-2 text-rose-700">@_error</p> }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public PlannedJob Job { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<Tank> _tanks = [];
    private Guid _picked;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _tanks = Job.Type == PmsJobType.Inspection ? await Tanks.ListTanksAsync(CompanyId, Job.VesselId) : [];
    }

    private async Task SetAsync(Guid? tankId)
    {
        _error = null;
        try { await Pms.SetJobTankAsync(CompanyId, Job.Id, tankId); _picked = Guid.Empty; await OnChanged.InvokeAsync(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }
}
