@inject RestFleetService Fleet
@inject AuthenticationStateProvider Auth

@if (_c is { Any: true })
{
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <StatCard Label="Hours of rest: breaches" Value="@_c.Unresolved.ToString("N0")" Hint="@($"Not dealt with by the Master · {_c.CompensatoryOutstanding} compensatory rest owed")" Href="/rest/fleet" Tone="@(_c.Unresolved > 0 ? "danger" : "success")" />
        <StatCard Label="Hours of rest: to sign" Value="@_c.ToSign.ToString("N0")" Hint="@($"Periods over and not fully signed · {_c.OutOfDate} out of date")" Href="/rest/fleet" Tone="@(_c.ToSign + _c.OutOfDate > 0 ? "warning" : "success")" />
        <StatCard Label="Hours of rest: not recorded" Value="@_c.Missing.ToString("N0")" Hint="@($"Days across {_c.Vessels} vessel(s), last two months")" Href="/rest/fleet" Tone="@(_c.Missing > 0 ? "warning" : "success")" />
    </div>
}

@code {
    private RestFleetCounts? _c;

    protected override async Task OnInitializedAsync()
    {
        if (NodeContext.Current.IsVessel) return;
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst("CompanyId")?.Value, out var companyId))
            _c = await Fleet.CountsAsync(companyId);
    }
}
