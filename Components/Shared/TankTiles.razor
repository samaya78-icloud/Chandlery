@inject TankTrendService Trends
@inject AuthenticationStateProvider Auth

@if (_counts is not null)
{
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @if (NodeContext.Current.IsVessel)
        {
            <StatCard Label="Tank inspections: to finish" Value="@_counts.WithVessel.ToString("N0")" Hint="Drafts and those sent back" Href="/tanks/inspections" Tone="@(_counts.WithVessel > 0 ? "warning" : "success")" />
        }
        else
        {
            <StatCard Label="Tank inspections: to review" Value="@_counts.WaitingReview.ToString("N0")" Hint="@($"{_counts.WaitingBad} with a Bad rating")" Href="/tanks/review" Tone="@(_counts.WaitingBad > 0 ? "danger" : _counts.WaitingReview > 0 ? "warning" : "success")" />
        }
        <StatCard Label="Tank exceptions now" Value="@_counts.CurrentExceptions.ToString("N0")" Hint="@($"{_counts.TanksWithBad} tank(s) with a Bad rating")" Href="/tanks/exceptions" Tone="@(_counts.TanksWithBad > 0 ? "danger" : _counts.CurrentExceptions > 0 ? "warning" : "success")" />
        <StatCard Label="Tanks never inspected" Value="@_counts.NeverInspected.ToString("N0")" Href="/tanks" Tone="@(_counts.NeverInspected > 0 ? "info" : "success")" />
    </div>
}

@code {
    private TankCounts? _counts;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst("CompanyId")?.Value, out var companyId))
            _counts = await Trends.CountsAsync(companyId);
    }
}
