@inject WorklistService Worklist
@inject AuthenticationStateProvider Auth

@if (_counts is not null)
{
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <StatCard Label="Worklist: overdue" Value="@_counts.Overdue.ToString("N0")" Hint="Open tasks past their target date" Href="/worklist" Tone="@(_counts.Overdue > 0 ? "danger" : "success")" />
        <StatCard Label="Worklist: due in 7 days" Value="@_counts.DueThisWeek.ToString("N0")" Href="/worklist" Tone="warning" />
        <StatCard Label="Worklist: to verify" Value="@_counts.AwaitingVerification.ToString("N0")" Hint="@(NodeContext.Current.IsVessel ? "Completed, waiting for the office" : "Completed by vessels, waiting for you")" Href="@(NodeContext.Current.IsVessel ? "/worklist" : "/worklist/fleet")" Tone="info" />
    </div>
}

@code {
    private WorklistCounts? _counts;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst("CompanyId")?.Value, out var companyId))
            _counts = await Worklist.CountsAsync(companyId);
    }
}
