@implements IAsyncDisposable
@inject SearchService Search
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Ctrl/Cmd+K finder: type a document number or name to jump to it, or run a command (go to a page, switch theme). *@
@if (_open)
{
    <div class="fixed inset-0 z-[70] flex items-start justify-center bg-slate-950/50 px-4 pt-[12vh] backdrop-blur-sm" @onclick="Close">
        <div class="card w-full max-w-xl overflow-hidden shadow-pop" @onclick:stopPropagation="true">
            <div class="flex items-center gap-3 border-b border-line px-4 py-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input @ref="_input" @bind="_term" @bind:event="oninput" @bind:after="OnTermChanged" @onkeydown="OnKey"
                       placeholder="Search RFQs, POs, suppliers, items… or type a command"
                       class="w-full bg-transparent text-base text-ink outline-none placeholder:text-muted" autocomplete="off" />
                <kbd class="rounded-md border border-line px-1.5 py-0.5 text-[11px] font-semibold text-muted">Esc</kbd>
            </div>

            <div class="max-h-[50vh] overflow-y-auto p-2">
                @if (_hits.Count == 0)
                {
                    <p class="px-3 py-8 text-center text-sm text-muted">@(_term.Trim().Length < 2 ? "Keep typing…" : _searching ? "Searching…" : "Nothing found. Try a number, a name or a code.")</p>
                }
                else
                {
                    string? group = null;
                    @for (var i = 0; i < _hits.Count; i++)
                    {
                        var hit = _hits[i];
                        var index = i;
                        @if (hit.Group != group)
                        {
                            group = hit.Group;
                            <p class="px-3 pb-1 pt-3 text-[11px] font-bold uppercase tracking-wider text-muted">@group</p>
                        }
                        <button type="button" @onclick="() => Go(hit)" @onmouseover="() => _active = index"
                                class="@("flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left transition " + (index == _active ? "bg-accent-50" : ""))">
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-semibold text-ink">@hit.Title</span>
                                @if (!string.IsNullOrEmpty(hit.Subtitle))
                                {
                                    <span class="block truncate text-xs text-muted">@hit.Subtitle</span>
                                }
                            </span>
                            @if (index == _active)
                            {
                                <span class="text-xs font-semibold text-accent-600">Enter &crarr;</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private DotNetObjectReference<CommandPalette>? _self;
    private ElementReference _input;
    private bool _open;
    private bool _searching;
    private bool _focusPending;
    private string _term = "";
    private int _active;
    private List<SearchHit> _hits = new();
    private int? _companyId;
    private int? _supplierId;
    private bool _isCompany;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask!).User;
        _isCompany = user.IsInRole("CompanyAdmin") || user.IsInRole("CompanyUser");
        if (int.TryParse(user.FindFirst("CompanyId")?.Value, out var c)) _companyId = c;
        if (int.TryParse(user.FindFirst("SupplierId")?.Value, out var s)) _supplierId = s;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chandlery.registerPalette", _self);
        }
        if (_focusPending)
        {
            _focusPending = false;
            await _input.FocusAsync();
        }
    }

    [JSInvokable]
    public void Toggle()
    {
        if (_open) { _open = false; }
        else
        {
            _open = true;
            _term = "";
            _active = 0;
            _hits = Commands("");
            _focusPending = true;
        }
        StateHasChanged();
    }

    private void Close() => _open = false;

    private async Task OnTermChanged()
    {
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        _active = 0;

        var term = _term.Trim();
        if (term.Length < 2)
        {
            _hits = Commands(term);
            return;
        }

        _searching = true;
        try { await Task.Delay(180, token); }
        catch (TaskCanceledException) { return; }

        var found = _isCompany && _companyId is { } companyId
            ? await Search.SearchCompanyAsync(companyId, term)
            : _supplierId is { } supplierId ? await Search.SearchSupplierAsync(supplierId, term) : new List<SearchHit>();
        if (token.IsCancellationRequested) return;

        _hits = Commands(term).Concat(found).ToList();
        _searching = false;
        _active = 0;
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") _active = _hits.Count == 0 ? 0 : (_active + 1) % _hits.Count;
        else if (e.Key == "ArrowUp") _active = _hits.Count == 0 ? 0 : (_active - 1 + _hits.Count) % _hits.Count;
        else if (e.Key == "Enter" && _hits.Count > 0) _ = Go(_hits[Math.Clamp(_active, 0, _hits.Count - 1)]);
        else if (e.Key == "Escape") _open = false;
    }

    private async Task Go(SearchHit hit)
    {
        _open = false;
        if (hit.Href.StartsWith("cmd:"))
        {
            var parts = hit.Href[4..].Split(':');
            await JS.InvokeVoidAsync(parts[0] == "mode" ? "chandlery.setMode" : "chandlery.setTheme", parts[1]);
            return;
        }
        Navigation.NavigateTo(hit.Href);
    }

    /// <summary>Pages and actions that match what has been typed (all of them when nothing is typed).</summary>
    private List<SearchHit> Commands(string term)
    {
        var all = new List<SearchHit>();
        if (_isCompany)
        {
            all.Add(new("Go to", "Dashboard", "Overview and work queues", "/"));
            all.Add(new("Go to", "My Approvals", "Purchase orders waiting for you", "/company/approvals"));
            all.Add(new("Go to", "Requisitions", "", "/company/requisitions"));
            all.Add(new("Go to", "RFQs", "", "/company/rfqs"));
            all.Add(new("Go to", "Purchase Orders", "", "/company/purchase-orders"));
            all.Add(new("Go to", "Invoices", "", "/company/invoices"));
            all.Add(new("Go to", "Suppliers", "", "/company/suppliers"));
            all.Add(new("Go to", "Items Catalog", "", "/company/items"));
            all.Add(new("Go to", "Vessels", "", "/company/vessels"));
            all.Add(new("Create", "New requisition", "Enter items once, quote many suppliers", "/company/requisitions/new"));
            all.Add(new("Create", "New RFQ", "", "/company/rfqs/new"));
            all.Add(new("Create", "New spot PO", "Order directly from a supplier", "/company/purchase-orders/new-spot"));
            all.Add(new("Create", "New spot invoice", "An invoice with no purchase order", "/company/invoices/new-spot"));
        }
        else
        {
            all.Add(new("Go to", "Dashboard", "", "/"));
            all.Add(new("Go to", "RFQs", "", "/supplier/rfqs"));
            all.Add(new("Go to", "Purchase Orders", "", "/supplier/purchase-orders"));
            all.Add(new("Go to", "Invoices", "", "/supplier/invoices"));
            all.Add(new("Go to", "Bank Accounts", "Where buyers pay you", "/supplier/profile"));
        }
        all.Add(new("Appearance", "Dark mode", "", "cmd:mode:dark"));
        all.Add(new("Appearance", "Light mode", "", "cmd:mode:light"));
        all.Add(new("Appearance", "Theme: Aurora", "", "cmd:theme:aurora"));
        all.Add(new("Appearance", "Theme: Sunset", "", "cmd:theme:sunset"));
        all.Add(new("Appearance", "Theme: Forest", "", "cmd:theme:forest"));
        all.Add(new("Appearance", "Theme: Orchid", "", "cmd:theme:orchid"));
        all.Add(new("Appearance", "Theme: Graphite", "", "cmd:theme:graphite"));

        return string.IsNullOrEmpty(term)
            ? all
            : all.Where(h => h.Title.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    public async ValueTask DisposeAsync()
    {
        _debounce?.Cancel();
        try { await JS.InvokeVoidAsync("chandlery.registerPalette", null); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _self?.Dispose();
    }
}
