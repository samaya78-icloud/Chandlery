@inject PermitService Permits

@if (_on)
{
    <div class="card p-5 text-sm">
        <h2 class="mb-3 font-display text-base font-extrabold text-ink">Permit to work</h2>
        @if (_needed is not null)
        {
            if (_covered) { <p class="mb-2 text-muted">This job needs a <strong>@_needed.Name</strong> permit, and one is open or was closed within the last week.</p> }
            else { <p class="mb-2 rounded-lg bg-amber-50 px-3 py-2 text-amber-800">This job needs a <strong>@_needed.Name</strong> permit, and none is open or was closed recently.</p> }
        }
        @if (_rows.Count == 0) { <p class="text-muted">No permit has been raised for this job.</p> }
        <ul class="space-y-1">
            @foreach (var r in _rows)
            {
                var (label, tone) = PermitLook.State(r.State);
                <li class="flex flex-wrap items-center gap-2"><a class="link font-mono font-semibold" href="/permits/@r.Permit.Id">@r.Permit.Code</a><span>@r.Permit.TypeName</span><StatusChip Label="@label" Tone="@tone" /></li>
            }
        </ul>
        @if (NodeContext.Current.IsVessel) { <a href="/permits/new?job=@Job.Id" class="btn btn-secondary btn-sm mt-3">Request a permit for this job</a> }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public PlannedJob Job { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _on, _covered;
    private PermitType? _needed;
    private List<PermitRow> _rows = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateTask!;
        try
        {
            _rows = await Permits.ForJobAsync(CompanyId, Job.VesselId, Job.Id, Actor.From(state.User));
            _on = (await Permits.EnabledVesselsAsync(CompanyId)).Any(v => v.Id == Job.VesselId);
            _needed = _on ? await Permits.RequiredForJobAsync(CompanyId, Job.TemplateId) : null;
            // A job comes round again, so an old permit does not cover it: one is open now, or one was closed within the last week. Cancelled and withdrawn ones never count.
            _covered = _needed is not null && _rows.Any(r => r.Permit.TypeName == _needed.Name
                && (r.State is PermitState.Requested or PermitState.Issued or PermitState.Active or PermitState.Suspended || (r.State == PermitState.Completed && r.Until > DateTime.UtcNow.AddDays(-7))));
        }
        catch (InvalidOperationException) { _on = false; _rows = []; _needed = null; }
    }
}
