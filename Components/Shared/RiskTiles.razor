@inject RiskAssessmentService Svc
@inject AuthenticationStateProvider Auth

@if (_counts is not null)
{
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard Label="Risk assessments: to sign" Value="@_counts.Waiting.ToString("N0")" Hint="Submitted, waiting for a reviewer" Href="/risk/review" Tone="@(_counts.Waiting > 0 ? "warning" : "success")" />
        <StatCard Label="Risk assessments: due for review" Value="@_counts.DueForReview.ToString("N0")" Hint="@($"{_counts.Overdue} overdue")" Href="/risk" Tone="@(_counts.Overdue > 0 ? "danger" : _counts.DueForReview > 0 ? "warning" : "success")" />
        <StatCard Label="Serious risk still signed" Value="@_counts.HighResidual.ToString("N0")" Hint="High or worse left after controls" Href="/risk" Tone="@(_counts.HighResidual > 0 ? "warning" : "success")" />
        <StatCard Label="Risk drafts gone quiet" Value="@_counts.OldDrafts.ToString("N0")" Hint="@($"Not submitted after {RiskAssessmentService.OldDraftDays} days")" Href="/risk" Tone="@(_counts.OldDrafts > 0 ? "info" : "success")" />
    </div>
}

@code {
    private RiskCounts? _counts;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst("CompanyId")?.Value, out var companyId))
            _counts = await Svc.CountsAsync(companyId);
    }
}
