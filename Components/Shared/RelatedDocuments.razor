@inject HubService Hub

@* The document chain around this record: Requisition -> RFQs -> Purchase orders. Every item is a link, the current one is highlighted. *@
@if (_graph is { IsEmpty: false } && (_stages > 1 || _graph.Rfqs.Count + _graph.Pos.Count > 1))
{
    <div class="card mb-6 px-5 py-4 print:hidden">
        <p class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">Related documents</p>
        <div class="flex flex-wrap items-stretch gap-x-3 gap-y-3">
            @if (_graph.Requisition is { } requisition)
            {
                <div class="@StageClass(Kind == DocKind.Requisition)">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-muted">Requisition</p>
                    <div class="mt-1 flex items-center gap-2">
                        <DocLink Kind="DocKind.Requisition" Id="requisition.Id" Text="@requisition.Number" />
                        <StatusChip Value="requisition.Status" />
                    </div>
                    <p class="mt-0.5 text-xs text-muted">@requisition.Vessel · @requisition.Lines lines</p>
                </div>
            }
            @if (_graph.Rfqs.Count > 0)
            {
                @if (_graph.Requisition is not null) { <span class="hidden self-center text-lg text-muted sm:inline">&rsaquo;</span> }
                <div class="rounded-xl border border-line px-3 py-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-muted">RFQ@(_graph.Rfqs.Count > 1 ? "s" : "")</p>
                    <div class="mt-1 flex flex-col gap-1">
                        @foreach (var rfq in _graph.Rfqs)
                        {
                            <div class="@("flex items-center gap-2 rounded-lg px-1.5 " + (Kind == DocKind.Rfq && Id == rfq.Id ? "bg-accent-50" : ""))">
                                <DocLink Kind="DocKind.Rfq" Id="rfq.Id" Text="@rfq.Number" />
                                <StatusChip Value="rfq.Status" />
                                <span class="text-xs text-muted">@rfq.SupplierCount suppliers</span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (_graph.Pos.Count > 0)
            {
                @if (_graph.Rfqs.Count > 0 || _graph.Requisition is not null) { <span class="hidden self-center text-lg text-muted sm:inline">&rsaquo;</span> }
                <div class="rounded-xl border border-line px-3 py-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-muted">Purchase order@(_graph.Pos.Count > 1 ? "s" : "")</p>
                    <div class="mt-1 flex flex-col gap-1">
                        @foreach (var po in _graph.Pos)
                        {
                            <div class="@("flex items-center gap-2 rounded-lg px-1.5 " + (Kind == DocKind.PurchaseOrder && Id == po.Id ? "bg-accent-50" : ""))">
                                <DocLink Kind="DocKind.PurchaseOrder" Id="po.Id" Text="@po.Number" />
                                <StatusChip Value="po.Status" />
                                <span class="text-xs text-muted">@po.Supplier · @Money.Format(po.Total, po.Currency)</span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (_graph.Dos.Count > 0)
            {
                <span class="hidden self-center text-lg text-muted sm:inline">&rsaquo;</span>
                <div class="rounded-xl border border-line px-3 py-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-muted">Deliver@(_graph.Dos.Count > 1 ? "ies" : "y")</p>
                    <div class="mt-1 flex flex-col gap-1">
                        @foreach (var d in _graph.Dos.Take(6))
                        {
                            <div class="flex items-center gap-2 px-1.5">
                                <DocLink Kind="DocKind.DeliveryOrder" Id="d.PoId" Text="@d.Number" />
                                <span class="text-xs text-muted">@d.PoNumber · @d.Received.ToString("dd MMM") · @d.Lines lines@(d.Locked ? " · invoiced" : "")</span>
                            </div>
                        }
                        @if (_graph.Dos.Count > 6)
                        {
                            <span class="px-1.5 text-xs text-muted">and @(_graph.Dos.Count - 6) more</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int CompanyId { get; set; }
    [Parameter, EditorRequired] public DocKind Kind { get; set; }
    [Parameter, EditorRequired] public int Id { get; set; }

    /// <summary>Change to force a reload after the parent changed something.</summary>
    [Parameter] public int Version { get; set; }

    private RelatedGraph? _graph;
    private int _stages;

    private static string StageClass(bool current) =>
        "rounded-xl border px-3 py-2 " + (current ? "border-accent-300 bg-accent-50" : "border-line");

    protected override async Task OnParametersSetAsync()
    {
        _graph = await Hub.GetRelatedAsync(CompanyId, Kind, Id);
        _stages = (_graph.Requisition is null ? 0 : 1) + (_graph.Rfqs.Count > 0 ? 1 : 0) + (_graph.Pos.Count > 0 ? 1 : 0) + (_graph.Dos.Count > 0 ? 1 : 0);
    }
}
