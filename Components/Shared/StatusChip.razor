<span class="chip" data-tone="@_tone">@_label</span>

@code {
    /// <summary>Any status enum used in the app (RfqStatus, PoStatus, RequisitionStatus, DeliveryStatus, ApprovalDecision, Urgency, RfqType...).</summary>
    [Parameter] public object? Value { get; set; }

    /// <summary>Override the text or tone when the default mapping is not what you want.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Tone { get; set; }

    private string _label = "";
    private string _tone = "neutral";

    protected override void OnParametersSet()
    {
        var (label, tone) = Describe(Value);
        _label = Label ?? label;
        _tone = Tone ?? tone;
    }

    /// <summary>The single place that decides how every status looks.</summary>
    public static (string Label, string Tone) Describe(object? value) => value switch
    {
        RfqStatus.Draft => ("Draft", "neutral"),
        RfqStatus.Sent => ("Sent", "warning"),
        RfqStatus.QuotesReceived => ("Quotes received", "info"),
        RfqStatus.Awarded => ("Awarded", "success"),

        RequisitionStatus.Open => ("Open", "neutral"),
        RequisitionStatus.RfqPosted => ("RFQ posted", "warning"),
        RequisitionStatus.Ordered => ("Ordered", "success"),
        RequisitionStatus.Cancelled => ("Cancelled", "danger"),

        PoStatus.PendingApproval => ("Pending approval", "warning"),
        PoStatus.Approved => ("Approved", "success"),
        PoStatus.Rejected => ("Rejected", "danger"),

        DeliveryStatus.Pending => ("Not delivered", "neutral"),
        DeliveryStatus.Partial => ("Partly delivered", "warning"),
        DeliveryStatus.Delivered => ("Delivered", "success"),

        ApprovalDecision.Pending => ("Waiting", "neutral"),
        ApprovalDecision.Approved => ("Approved", "success"),
        ApprovalDecision.Rejected => ("Rejected", "danger"),

        InvoiceStatus.Submitted => ("Submitted", "info"),
        InvoiceStatus.PendingApproval => ("Pending approval", "warning"),
        InvoiceStatus.Approved => ("Approved", "success"),
        InvoiceStatus.Finalized => ("Finalized", "accent"),
        InvoiceStatus.Rejected => ("Rejected", "danger"),

        InvoiceKind.PoInvoice => ("PO invoice", "neutral"),
        InvoiceKind.SpotInvoice => ("Spot invoice", "accent"),

        Urgency.Normal => ("Normal", "neutral"),
        Urgency.Urgent => ("Urgent", "danger"),

        RfqType.Stores => ("Stores", "accent"),
        RfqType.Spares => ("Spares", "info"),

        PmsStatus.Overdue => ("Overdue", "danger"),
        PmsStatus.Due => ("Due", "warning"),
        PmsStatus.NotDue => ("On schedule", "success"),
        PmsStatus.NoSchedule => ("No schedule", "neutral"),
        PmsJobType.Overhaul => ("Overhaul", "accent"),
        PmsJobType.Inspection => ("Inspection", "info"),

        WorklistStatus.Open => ("Open", "neutral"),
        WorklistStatus.InProgress => ("In progress", "info"),
        WorklistStatus.Waiting => ("Waiting", "warning"),
        WorklistStatus.Completed => ("Completed", "success"),
        WorklistStatus.Cancelled => ("Cancelled", "danger"),
        WorklistPriority.Urgent => ("Urgent", "danger"),
        WorklistPriority.Normal => ("Normal", "neutral"),

        InspectionStatus.Draft => ("Draft", "neutral"),
        InspectionStatus.Submitted => ("Submitted", "info"),
        InspectionStatus.InReview => ("In review", "warning"),
        InspectionStatus.Returned => ("Returned", "danger"),
        InspectionStatus.Reviewed => ("Reviewed", "success"),
        RaStatus.Draft => ("Draft", "neutral"),
        RaStatus.Submitted => ("Submitted", "info"),
        RaStatus.InReview => ("In review", "warning"),
        RaStatus.Returned => ("Returned", "danger"),
        RaStatus.Signed => ("Signed", "success"),
        RaReviewState.Overdue => ("Review overdue", "danger"),
        RaReviewState.DueSoon => ("Review due soon", "warning"),
        RaReviewState.Ok => ("Review on schedule", "success"),
        TankHealth.NotInspected => ("Not inspected", "neutral"),
        TankHealth.Clean => ("No exceptions", "success"),
        TankHealth.Exceptions => ("Exceptions", "warning"),
        TankHealth.Bad => ("Bad rating", "danger"),

        null => ("", "neutral"),
        _ => (Humanize(value.ToString() ?? ""), "neutral")
    };

    private static string Humanize(string text) =>
        System.Text.RegularExpressions.Regex.Replace(text, "(?<=[a-z])(?=[A-Z])", " ");
}
