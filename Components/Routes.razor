<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <LayoutView Layout="typeof(MainLayout)">
                        <div class="flex flex-col items-center justify-center py-24 text-center">
                            <p class="text-2xl font-bold text-slate-800">Access denied</p>
                            <p class="mt-2 text-slate-500">You don't have permission to view this page.</p>
                        </div>
                    </LayoutView>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="flex flex-col items-center justify-center py-24 text-center">
                <p class="text-6xl font-extrabold text-slate-200">404</p>
                <p class="mt-2 text-slate-500">Sorry, there's nothing at this address.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
