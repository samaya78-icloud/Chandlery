@inject ApprovalService ApprovalSvc
@inject InvoiceService InvoiceSvc
@inject WorklistService WorklistSvc
@inject PmsService PmsSvc
@inject TankService TankSvc

<nav class="flex flex-col pt-1">
    <AuthorizeView Roles="CompanyAdmin,CompanyUser">
        <Authorized>
            @if (NodeContext.Current.IsVessel)
            {
                @Group("Onboard", _vesselItems)
                @if (_maintenanceItems.Count > 0) { @Group("Maintenance", _maintenanceItems) }
                @if (_tankItems.Count > 0) { @Group("Tank inspection", _tankItems) }
            }
            else
            {
                @Group("Work", _workItems)
                @if (_maintenanceItems.Count > 0) { @Group("Maintenance", _maintenanceItems) }
                @if (_tankItems.Count > 0) { @Group("Tank inspection", _tankItems) }
                @Group("Procurement", _procurementItems)
                @Group("Master data", _masterItems)
            }
        </Authorized>
    </AuthorizeView>

    @if (!NodeContext.Current.IsVessel)
    {
        <AuthorizeView Roles="CompanyAdmin">
            <Authorized>
                @Group("Admin", _adminItems)
            </Authorized>
        </AuthorizeView>
    }

    <AuthorizeView Policy="CrewAdmin">
        <Authorized>
            @Group("Vessel", _crewAdminItems)
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="SupplierAdmin,SupplierUser">
        <Authorized>
            @Group("Workspace", _supplierItems)
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private record NavItem(string Href, string Label, MarkupString Icon, int Badge = 0);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _pendingApprovals;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask!).User;
        if ((user.IsInRole("CompanyAdmin") || user.IsInRole("CompanyUser"))
            && Guid.TryParse(user.FindFirst("CompanyId")?.Value, out var companyId)
            && Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId))
        {
            if (await WorklistSvc.IsEnabledForCompanyAsync(companyId))
            {
                var item = new NavItem("/worklist", "Worklist", WorklistIcon);
                _workItems.Insert(1, item);
                _vesselItems.Insert(1, item);
                _workItems.Insert(2, new NavItem("/worklist/fleet", "Fleet worklist", WorklistIcon));
                _adminItems.Add(new NavItem("/company/worklist-lists", "Worklist lists", WorklistIcon));
            }
            if (await PmsSvc.IsEnabledForCompanyAsync(companyId))
            {
                var waiting = (await PmsSvc.PendingDeferralsAsync(companyId)).Count;
                if (NodeContext.Current.IsVessel)
                {
                    _maintenanceItems.AddRange([new NavItem("/pms", "Plan", PmsIcon), new NavItem("/pms/hours", "Running hours", PmsIcon), new NavItem("/pms/machinery", "Machinery", PmsIcon),
                        new NavItem("/pms/import", "Import a plan", PmsIcon), new NavItem("/pms/approvals", "Approvals", PmsIcon, waiting)]);
                }
                else
                {
                    waiting += (await PmsSvc.PlanChangesAsync(companyId, pendingOnly: true)).Count;
                    _maintenanceItems.AddRange([new NavItem("/pms", "Plan", PmsIcon), new NavItem("/pms/fleet", "Fleet overview", PmsIcon), new NavItem("/pms/hours", "Running hours", PmsIcon),
                        new NavItem("/pms/machinery", "Machinery", PmsIcon), new NavItem("/pms/import", "Import a plan", PmsIcon), new NavItem("/pms/approvals", "Approvals", PmsIcon, waiting), new NavItem("/pms/template-updates", "Template updates", PmsIcon),
                        new NavItem("/pms/sister-vessels", "Sister vessels", PmsIcon), new NavItem("/pms/reports", "Reports", PmsIcon)]);
                    _adminItems.Add(new NavItem("/company/pms-library", "Maintenance library", PmsIcon));
                }
            }
            if (await TankSvc.IsEnabledForCompanyAsync(companyId))
            {
                _tankItems.Add(new NavItem("/tanks", "Tanks", TankIcon));
                _tankItems.Add(new NavItem("/tanks/inspections", "Inspections", TankIcon));
                if (!NodeContext.Current.IsVessel && (await TankSvc.EnabledVesselsAsync(companyId)).Count > 1) _tankItems.Add(new NavItem("/tanks/copy", "Copy to sister vessels", TankIcon));
            }
            _pendingApprovals = await ApprovalSvc.GetPendingCountForUserAsync(companyId, userId)
                                + (await InvoiceSvc.GetPendingForUserAsync(companyId, userId)).Count;
        }
    }

    /// <summary>A menu group. Clicking its heading shows or hides its entries (the choice is remembered in the browser, see app.js).</summary>
    private RenderFragment Group(string title, IEnumerable<NavItem> items) => __builder =>
    {
        var slug = title.ToLowerInvariant().Replace(' ', '-');
        <div class="nav-group" data-nav-group="@slug">
            <button type="button" class="nav-group-title" data-toggle-group aria-expanded="true" title="Show or hide @title">
                <span>@title</span>
                <svg class="nav-group-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="nav-group-items">
                @foreach (var item in items)
                {
                    var badge = item.Href == "/company/approvals" ? _pendingApprovals : item.Badge;
                    <NavLink href="@item.Href" Match="@(item.Href is "/" or "/worklist" or "/pms" or "/tanks" ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="nav-link" ActiveClass="active" title="@item.Label">
                        <span class="nav-icon">@item.Icon</span>
                        <span class="nav-label">@item.Label</span>
                        @if (badge > 0)
                        {
                            <span class="nav-badge">@badge</span>
                        }
                    </NavLink>
                }
            </div>
        </div>
    };

    private static MarkupString Icon(string path) =>
        (MarkupString)$"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'>{path}</svg>";

