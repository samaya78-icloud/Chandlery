    private static readonly MarkupString ProjectIcon = Icon("<path d='M5 21V4'/><path d='M5 5h13l-2.5 4L18 13H5'/>");
    private static readonly MarkupString RiskIcon = Icon("<path d='M12 3 2 20h20L12 3Z'/><path d='M12 10v5'/><path d='M12 18v.01'/>");
    private static readonly MarkupString HomeIcon = Icon("<path d='m3 11 9-8 9 8M5 10v10h5v-6h4v6h5V10'/>");

    private static readonly Dictionary<string, MarkupString> Icons = new()
    {
        ["home"] = HomeIcon, ["approval"] = ApprovalIcon, ["reqn"] = ReqnIcon, ["rfq"] = RfqIcon, ["po"] = PoIcon, ["invoice"] = InvoiceIcon,
        ["supplier"] = SupplierIcon, ["item"] = ItemIcon, ["vessel"] = VesselIcon, ["team"] = TeamIcon, ["department"] = DepartmentIcon, ["port"] = PortIcon,
        ["unit"] = UnitIcon, ["matrix"] = MatrixIcon, ["tax"] = TaxIcon, ["currency"] = CurrencyIcon, ["rates"] = RatesIcon, ["profile"] = ProfileIcon,
        ["bank"] = BankIcon, ["worklist"] = WorklistIcon, ["pms"] = PmsIcon, ["rest"] = RestIcon, ["incident"] = IncidentIcon, ["drill"] = DrillIcon, ["permit"] = PermitIcon, ["tank"] = TankIcon, ["risk"] = RiskIcon, ["project"] = ProjectIcon,
    };

    private static MarkupString IconFor(string name) => Icons.TryGetValue(name, out var icon) ? icon : default;
}
