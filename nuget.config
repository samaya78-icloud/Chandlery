<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Marine.Sync is its own repository; its packages are built into ..\Sync\packages (dotnet pack Marine.Sync.slnx -c Release -o packages). -->
    <add key="marine-sync-local" value="..\Sync\packages" />
  </packageSources>
</configuration>
